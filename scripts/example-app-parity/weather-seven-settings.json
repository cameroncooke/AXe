{
  "name": "Verify all seven Weather settings and the London main screen",
  "provenance": "Original XcodeBuildMCP Weather benchmark values. Start after the public search helper with London selected, the Locations sheet open, four requested units already selected, both first switches off and Reduce transparency off. All setup and changes use normal public UI controls. This checks functional state, not model efficiency.",
  "steps": [
    {
      "op": "value",
      "role": "text-field",
      "label": "weather.locationsSheet",
      "equals": "London"
    },
    {
      "op": "tap",
      "role": "button",
      "label": "Close"
    },
    {
      "op": "text_is",
      "text": "London"
    },
    {
      "op": "text_is",
      "text": "11"
    },
    {
      "op": "tap",
      "role": "button",
      "label": "Settings"
    },
    {
      "op": "value",
      "role": "button",
      "label": "°C",
      "equals": "selected"
    },
    {
      "op": "value",
      "role": "button",
      "label": "m/s",
      "equals": "selected"
    },
    {
      "op": "value",
      "role": "button",
      "label": "inHg",
      "equals": "selected"
    },
    {
      "op": "value",
      "role": "button",
      "label": "km",
      "equals": "selected"
    },
    {
      "op": "value",
      "role": "switch",
      "label": "Atmospheric animations",
      "equals": "0"
    },
    {
      "op": "value",
      "role": "switch",
      "label": "Severe weather alerts",
      "equals": "0"
    },
    {
      "op": "scroll_until",
      "target": {
        "role": "switch",
        "label": "Reduce transparency"
      },
      "scroll": {
        "role": "scroll-view",
        "label": "weather.settingsSheet"
      },
      "max_swipes": 3,
      "direction": "up",
      "distance": 0.5,
      "duration": 0.5
    },
    {
      "op": "value",
      "role": "switch",
      "label": "Reduce transparency",
      "equals": "0"
    },
    {
      "op": "tap",
      "role": "switch",
      "label": "Reduce transparency"
    },
    {
      "op": "value",
      "role": "switch",
      "label": "Reduce transparency",
      "equals": "1"
    },
    {
      "op": "tap",
      "role": "button",
      "label": "Close"
    },
    {
      "op": "text_is",
      "text": "London"
    },
    {
      "op": "text_is",
      "text": "11"
    }
  ]
}
