{
  "name": "Weather precipitation detail from visible main-screen controls",
  "provenance": "Recovered WeatherUITests.testPrecipitationDetailOpens. Start on the normal San Francisco Weather main screen. Resolve the public PRECIP. button label, not the later PRECIPITATION title.",
  "steps": [
    {
      "op": "expect",
      "role": "text",
      "contains": [
        "San Francisco"
      ],
      "timeout": 5
    },
    {
      "op": "scroll_until",
      "target": {
        "role": "button",
        "label_prefix": "PRECIP."
      },
      "scroll": {
        "label": "weather.mainScrollView",
        "role": "scroll-view"
      },
      "max_swipes": 5,
      "direction": "up",
      "distance": 0.65,
      "duration": 0.5
    },
    {
      "op": "tap",
      "role": "button",
      "label_prefix": "PRECIP.",
      "physical": true,
      "refresh": true
    },
    {
      "op": "expect",
      "role": "text",
      "contains": [
        "PRECIPITATION",
        "LIGHTNING"
      ],
      "timeout": 5
    }
  ]
}
