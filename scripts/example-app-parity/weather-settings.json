{
  "name": "Weather settings sheet",
  "provenance": "WeatherUITests.testSettingsSheetOpens. Start from the default San Francisco screen.",
  "steps": [
    {
      "op": "expect",
      "role": "text",
      "contains": [
        "San Francisco"
      ],
      "timeout": 5
    },
    {
      "op": "tap",
      "label": "Settings",
      "role": "button",
      "physical": true
    },
    {
      "op": "expect",
      "role": "text",
      "contains": [
        "Settings"
      ],
      "timeout": 2
    }
  ]
}
