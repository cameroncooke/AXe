{
  "name": "Weather location picker",
  "provenance": "WeatherUITests.testLocationPickerOpens. Start from the default San Francisco screen.",
  "steps": [
    {
      "op": "expect",
      "role": "text",
      "contains": [
        "San Francisco"
      ],
      "timeout": 5
    },
    {
      "op": "tap",
      "label": "San Francisco",
      "role": "button",
      "physical": true
    },
    {
      "op": "expect",
      "role": "text",
      "contains": [
        "Locations"
      ],
      "timeout": 2
    }
  ]
}
