+    self.operationID = operationID
+    phases = []
+    diagnosticOperationID = operationID
+    phase("backend-ownership-start")
+    do {
+      try FBSimulatorSliderEndpointController.check(deadline)
+      try await FBSimulatorAXWorker.shared.claimSliderLease(for: simulator, token: operationID)
+      try FBSimulatorSliderEndpointController.check(deadline)
+      phase("backend-feed-start")
+      let feed = try await FBSimulatorHIDNativeFreshnessProvider.start(for: simulator, authoritativeProvider: provider)
+      live = feed
+      phase("backend-feed-returned")
+      guard feed.initialObservation == observation else { throw FBSimulatorSliderError.staleContext }
+      try feed.validateCurrentRevision(expected: observation)
+      try FBSimulatorSliderEndpointController.check(deadline)
+      phase(preparation == .automationSession ? "backend-bootstrap-start" : "backend-existing-bridge-no-automation-preparation")
+      try await FBSimulatorAXWorker.shared.prepareSliderLease(for: simulator, token: operationID,
+        deadline: deadline, preparation: preparation)
+      if preparation == .automationSession { phase("backend-bootstrap-returned") }
+      try feed.validateCurrentRevision(expected: observation)
+      try FBSimulatorSliderEndpointController.check(deadline)
+    } catch {
+      await finish(operationID: operationID)
+      throw error
+    }
+  }
+
+  public func finish(operationID: UUID) async {
+    guard self.operationID == operationID else { return }
+    phase("backend-feed-close-start")
+    await live?.closeAndWait()
+    phase("backend-feed-close-returned")
+    live = nil
+    await FBSimulatorAXWorker.shared.closeSliderLease(for: simulator, token: operationID)
+    self.operationID = nil
+  }
+
+  private func boundFeed(deadline: Double) throws -> (UUID, FBSimulatorHIDNativeFreshnessProvider) {
+    try FBSimulatorSliderEndpointController.check(deadline)
+    guard let operationID, let live else { throw FBSimulatorSliderError.invalidSelection }
+    try live.validateCurrentRevision(expected: observation)
+    return (operationID, live)
+  }
+
+  public func read(deadline: Double) async throws -> FBSimulatorSliderCapabilities {
+    let (token, feed) = try boundFeed(deadline: deadline)
+    phase("backend-target-read-start")
+    let result = try await FBSimulatorAXWorker.shared.sliderOperation(for: simulator, observation: observation,
+      feed: feed, token: token, selection: selection, expectedPID: pid, elementType: elementType, deadline: deadline, action: nil, expected: nil)
+    phase("backend-target-read-returned")
+    return result
+  }
+
+  public func readFinal(deadline: Double) async throws -> FBSimulatorSliderCapabilities {
+    let (_, feed) = try boundFeed(deadline: deadline)
+    phase("backend-final-context-start")
+    guard try await feed.observation() == observation else { throw FBSimulatorSliderError.staleContext }
+    phase("backend-final-context-returned")
+    return try await read(deadline: deadline)
+  }
+
+  public func step(_ action: FBSimulatorSliderAction, expected: FBSimulatorSliderCapabilities, deadline: Double) async throws -> FBSimulatorSliderActionReceipt {
+    let started = ProcessInfo.processInfo.systemUptime
+    do {
+      let (token, feed) = try boundFeed(deadline: deadline)
+      // Full active-panel, boot, catalog, guest rotation and pose admission before every action.
+      phase("backend-action-context-start")
+      guard try await feed.observation() == observation else { throw FBSimulatorSliderError.staleContext }
+      phase("backend-action-context-returned")
+      try FBSimulatorSliderEndpointController.check(deadline)
+      phase("backend-action-target-and-dispatch-start")
+      let verified = try await FBSimulatorAXWorker.shared.sliderOperation(for: simulator, observation: observation,
+        feed: feed, token: token, selection: selection, expectedPID: pid, elementType: elementType, deadline: deadline, action: action, expected: expected)
+      phase("backend-action-target-and-dispatch-returned")
+      return FBSimulatorSliderActionReceipt(action: action, verifiedBeforeAction: verified, callStartedUptime: started,
+        callReturnedUptime: ProcessInfo.processInfo.systemUptime, guestAcknowledged: false)
+    } catch let error as FBSimulatorSliderError { throw error }
+    catch { throw FBSimulatorSliderError.beforeDispatchFailure(String(describing: error)) }
+  }
+}
+
+/// One reservation table, owned by the AX worker. No cross-process exclusion is implied.
+struct FBSimulatorSliderLeaseTable<Value> {
+  private struct Entry {
+    let token: UUID
+    var value: Value
+  }
+  private var entries: [String: Entry] = [:]
+  mutating func claim(device: String, token: UUID, value: Value) throws {
+    guard entries[device] == nil else { throw FBSimulatorSliderError.busy }
+    entries[device] = Entry(token: token, value: value)
+  }
+  func value(device: String, token: UUID) throws -> Value {
+    guard let entry = entries[device], entry.token == token else {
+      throw FBSimulatorSliderError.invalidSelection
+    }
+    return entry.value
+  }
+  mutating func update(device: String, token: UUID, value: Value) throws {
+    _ = try self.value(device: device, token: token)
+    entries[device] = Entry(token: token, value: value)
+  }
+  mutating func release(device: String, token: UUID) -> Value? {
+    guard let entry = entries[device], entry.token == token else { return nil }
+    entries.removeValue(forKey: device)
+    return entry.value
+  }
+}
+
+struct FBSimulatorSliderAcquisitionLease {
+  let commands: FBSimulatorAccessibilityCommands
+  var prepared: Bool
+  var automation: FBSimulatorAccessibilityLease?
+}
+
+extension FBSimulatorAXWorker {
+  func claimSliderLease(for simulator: FBSimulator, token: UUID) throws {
+    try sliderLeases.claim(device: simulator.udid, token: token,
+      value: FBSimulatorSliderAcquisitionLease(commands: FBSimulatorAccessibilityCommands(simulator: simulator),
+        prepared: false, automation: nil))
+  }
+  func prepareSliderLease(for simulator: FBSimulator, token: UUID, deadline: Double,
+    preparation: FBSimulatorAXPreparation) throws {
+    try FBSimulatorSliderEndpointController.check(deadline)
+    var lease = try sliderLeases.value(device: simulator.udid, token: token)
+    lease.automation = try preparation.beginLease {
+      try lease.commands.prepareSliderAcquisition(deadline: deadline, worker: self)
+    }
+    try FBSimulatorSliderEndpointController.check(deadline)
+    lease.prepared = true
+    try sliderLeases.update(device: simulator.udid, token: token, value: lease)
+  }
+  func closeSliderLease(for simulator: FBSimulator, token: UUID) {
+    sliderLeases.release(device: simulator.udid, token: token)?.automation?.close()
+  }
+  func sliderLease(for simulator: FBSimulator, token: UUID) throws -> FBSimulatorSliderAcquisitionLease {
+    let lease = try sliderLeases.value(device: simulator.udid, token: token)
+    guard lease.prepared else { throw FBSimulatorSliderError.invalidSelection }
+    return lease
+  }
+
+  func sliderOperation(for simulator: FBSimulator, observation: FBSimulatorHIDSessionObservation,
+    feed: FBSimulatorHIDNativeFreshnessProvider, token: UUID, selection: FBSimulatorSliderSelection, expectedPID: Int32,
+    elementType: String?, deadline: Double, action: FBSimulatorSliderAction?, expected: FBSimulatorSliderCapabilities?) async throws -> FBSimulatorSliderCapabilities {
+    try FBSimulatorSliderEndpointController.check(deadline)
+    guard !selection.text.isEmpty, expectedPID > 0 else { throw FBSimulatorSliderError.invalidSelection }
+    try feed.validateCurrentRevision(expected: observation)
+    try FBSimulatorSliderEndpointController.check(deadline)
+    let request = FBAXTranslationRequest(kind: .frontmostApplication, pointDisplayID: observation.axDisplayID,
+      displayContext: observation.displayContext)
+    let lease = try sliderLease(for: simulator, token: token)
+    let root = try await lease.commands.accessibilityElementForSliderLease(request: request, worker: self)
+    defer { root.close() }
+    _ = try sliderLease(for: simulator, token: token)
+    let snapshot = try serialize(root, observation: observation, remoteContentOptions: nil)
+    guard !snapshot.roots.isEmpty, snapshot.roots.allSatisfy({ $0.pid == expectedPID }) else {
+      throw FBSimulatorSliderError.invalidSelection
+    }
+    let node = try FBSimulatorSliderTargetSelection.resolve(roots: snapshot.roots,
+      selection: selection, expectedPID: expectedPID, elementType: elementType)
+    let selected = try root.findSliderElement(matching: selection, depth: 64, deadline: deadline)
+    defer { selected.close() }
+    switch selection {
+    case .identifier(let identifier):
+      guard try selected.stringValue(forSearchableKey: .uniqueID) == identifier else { throw FBSimulatorSliderError.invalidSelection }
+    case .label(let label):
+      guard try FBSimulatorAXSelector.matchesLabel(selected.stringValue(forSearchableKey: .label), query: label) else {
+        throw FBSimulatorSliderError.invalidSelection
+      }
+    }
+    let context = FBSimulatorContextObservation(simulatorUDID: observation.simulatorUDID,
+      bootIdentity: observation.bootIdentity, screenID: observation.screenID, screenUniqueID: observation.screenUniqueID,
+      axDisplayID: observation.axDisplayID, nativePixelWidth: observation.displayContext.nativePixelSize.width,
+      nativePixelHeight: observation.displayContext.nativePixelSize.height, scale: observation.displayContext.scale,
+      rotation: observation.displayContext.rotation.rawValue, poseRevision: observation.poseRevision)
+    func capabilities(_ node: FBSimulatorAXNode) throws -> FBSimulatorSliderCapabilities {
+      let raw = try JSONDecoder().decode(FBSimulatorSliderAttributes.self, from: selected.sliderCapabilityData())
+      return FBSimulatorSliderCapabilities(snapshotID: snapshot.snapshotID, observation: context,
+        node: node, raw: raw, geometryStatus: "unknown")
+    }
+    let treeValue = try capabilities(node)
+    // Both selectors bind every sample to the actual owned root, never a descendant.
+    let currentSnapshot = try serialize(selected, observation: observation, remoteContentOptions: nil)
+    let currentNode = try FBSimulatorSliderTargetSelection.ownedRoot(roots: currentSnapshot.roots,
+      selection: selection, expectedPID: expectedPID, elementType: elementType)
+    let value = try capabilities(currentNode)
+    try value.requireSameTarget(as: treeValue, includeValue: true)
+    try feed.validateCurrentRevision(expected: observation)
+    try FBSimulatorSliderEndpointController.check(deadline)
+    guard let action else { return value }
+    guard let expected else { throw FBSimulatorSliderError.invalidSelection }
+    try value.requireSameTarget(as: expected, includeValue: true)
+    // Re-read the owned selected handle immediately before dispatch.
+    let finalSnapshot = try serialize(selected, observation: observation, remoteContentOptions: nil)
+    let finalNode = try FBSimulatorSliderTargetSelection.ownedRoot(roots: finalSnapshot.roots,
+      selection: selection, expectedPID: expectedPID, elementType: elementType)
+    let final = try capabilities(finalNode)
+    try final.requireSameTarget(as: expected, includeValue: true)
+    guard final.raw.declaredActions.contains(action.declaredName) else { throw FBSimulatorSliderError.unsupportedAction }
+    try FBSimulatorSliderEndpointController.check(deadline)
+    try feed.validateCurrentRevision(expected: observation)
+    // Native action returns void: a return is not an app acknowledgment.
+    try selected.sliderAdjust(action, deadline: deadline)
+    do {
+      try FBSimulatorSliderEndpointController.check(deadline)
+      try feed.validateCurrentRevision(expected: observation)
+      try FBSimulatorSliderEndpointController.check(deadline)
+    } catch { throw FBSimulatorSliderError.deliveryUncertain(String(describing: error)) }
+    return final
+  }
+}
diff --git a/FBSimulatorControl/Commands/FBSimulatorSliderEndpoint.swift b/FBSimulatorControl/Commands/FBSimulatorSliderEndpoint.swift
new file mode 100644
index 0000000000000000000000000000000000000000..ae410af67fa7cdcf42ec2a8d6f35848a93f56fe8
--- /dev/null
+++ b/FBSimulatorControl/Commands/FBSimulatorSliderEndpoint.swift
@@ -0,0 +1,158 @@
+import Foundation
+
+public struct FBSimulatorSliderSample: Codable, Sendable {
+  public let phase: String
+  public let elapsedSeconds: Double
+  public let capabilities: FBSimulatorSliderCapabilities
+}
+public struct FBSimulatorSliderPhaseEvent: Codable, Sendable {
+  public let phase: String
+  public let uptime: Double
+}
+public struct FBSimulatorSliderEndpointReceipt: Codable, Sendable {
+  public let outcome: String
+  public let reason: String?
+  public let delivery: String
+  public let endpoint: FBSimulatorSliderEndpoint
+  public let actionAttempts: Int
+  public let actionsReturned: Int
+  public let startedUptime: Double
+  public let deadlineUptime: Double
+  public let elapsedSeconds: Double
+  public let samples: [FBSimulatorSliderSample]
+  public let actionReceipts: [FBSimulatorSliderActionReceipt]
+  public let phaseEvents: [FBSimulatorSliderPhaseEvent]
+  public let physicalGeometry: String
+}
+/// Semantic AX endpoint control only. No HID, setter, replay or thumb inference.
+public actor FBSimulatorSliderEndpointController {
+  private var running = false
+  public init() {}
+  static func check(_ deadline: Double) throws {
+    if Task.isCancelled { throw FBSimulatorSliderError.cancelled }
+    guard deadline.isFinite, ProcessInfo.processInfo.systemUptime < deadline else {
+      throw FBSimulatorSliderError.deadline
+    }
+  }
+  public func run(endpoint: FBSimulatorSliderEndpoint,
+    backend: any FBSimulatorSliderEndpointBackend, budgetSeconds: Double = 15, maximumActions: Int = 20,
+    observer: (@Sendable (FBSimulatorSliderSample) async throws -> Void)? = nil
+  ) async -> FBSimulatorSliderEndpointReceipt {
+    let start = ProcessInfo.processInfo.systemUptime
+    let deadline = start + budgetSeconds
+    let operationID = UUID()
+    var outcome = "failed"
+    var reason: String?
+    var delivery = "notDispatched"
+    var attempts = 0
+    var returned = 0
+    var awaitingReadback = false
+    var samples: [FBSimulatorSliderSample] = []
+    var actions: [FBSimulatorSliderActionReceipt] = []
+    var phases = [FBSimulatorSliderPhaseEvent(phase: "budget-start", uptime: start)]
+    func phase(_ value: String) { phases.append(FBSimulatorSliderPhaseEvent(phase: value, uptime: ProcessInfo.processInfo.systemUptime)) }
+    func receipt(_ outcome: String, _ reason: String? = nil, delivery: String) -> FBSimulatorSliderEndpointReceipt {
+      FBSimulatorSliderEndpointReceipt(outcome: outcome, reason: reason, delivery: delivery, endpoint: endpoint,
+        actionAttempts: attempts, actionsReturned: returned, startedUptime: start, deadlineUptime: deadline,
+        elapsedSeconds: ProcessInfo.processInfo.systemUptime - start, samples: samples, actionReceipts: actions, phaseEvents: phases, physicalGeometry: "unknown")
+    }
+    guard !running else { return receipt("failed", "busy", delivery: "notDispatched") }
+    running = true
+    defer { running = false }
+    do {
+      guard budgetSeconds.isFinite, budgetSeconds > 0, budgetSeconds <= 15,
+            maximumActions > 0, maximumActions <= 20 else { throw FBSimulatorSliderError.invalidDomain }
+      try Self.check(deadline)
+      phase("setup-start")
+      try await backend.prepare(operationID: operationID, deadline: deadline)
+      try Self.check(deadline)
+      phase("setup-returned")
+      phase("initial-read-start")
+      var current = try await backend.read(deadline: deadline)
+      phase("initial-read-returned")
+      let initial = current
+      let domain = try current.requireDomain()
+      let target = endpoint == .minimum ? domain.minimum : domain.maximum
+      let direction: FBSimulatorSliderAction = endpoint == .minimum ? .decrement : .increment
+      var value = try current.requireValue()
+      let already = abs(value - target) <= domain.tolerance
+      func record(_ name: String, _ capability: FBSimulatorSliderCapabilities) async throws {
+        let sample = FBSimulatorSliderSample(phase: name, elapsedSeconds: ProcessInfo.processInfo.systemUptime - start,
+          capabilities: capability)
+        samples.append(sample)
+        phase(name + "-observer-start")
+        try await observer?(sample)
+        phase(name + "-observer-returned")
+        try Self.check(deadline)
+      }
+      try await record("initial", current)
+      while abs(value - target) > domain.tolerance {
+        guard attempts < maximumActions else { throw FBSimulatorSliderError.actionLimit }
+        guard current.raw.declaredActions.contains(direction.declaredName) else { throw FBSimulatorSliderError.unsupportedAction }
+        try Self.check(deadline)
+        attempts += 1
+        awaitingReadback = true
+        phase("action-\(attempts)-start")
+        do { actions.append(try await backend.step(direction, expected: current, deadline: deadline)) }
+        catch let error as FBSimulatorSliderError {
+          if case .deliveryUncertain = error { throw error }
+          // Backend contract: other typed errors are before native dispatch.
+          awaitingReadback = false
+          throw error
+        }
+        returned += 1
+        phase("action-\(attempts)-returned")
+        try Self.check(deadline)
+        phase("action-\(attempts)-read-start")
+        let next = try await backend.read(deadline: deadline)
+        phase("action-\(attempts)-read-returned")
+        try next.requireSameTarget(as: initial, includeValue: false)
+        let nextValue = try next.requireValue()
+        awaitingReadback = false
+        try await record("after-action-\(returned)", next)
+        guard nextValue != value else { throw FBSimulatorSliderError.noProgress }
+        let progress = direction == .increment ? nextValue - value : value - nextValue
+        guard progress > 0 else { throw FBSimulatorSliderError.wrongDirection }
+        current = next; value = nextValue
+      }
+      // Both final observations share the original operation budget.
+      let reachedAt = ProcessInfo.processInfo.systemUptime
+      for delay in [0.6, 5.0] {
+        try Self.check(deadline)
+        let wait = max(0, reachedAt + delay - ProcessInfo.processInfo.systemUptime)
+        guard reachedAt + delay < deadline else { throw FBSimulatorSliderError.deadline }
+        phase("settled-\(delay)-wait-start")
+        try await Task.sleep(nanoseconds: UInt64(wait * 1_000_000_000))
+        phase("settled-\(delay)-read-start")
+        awaitingReadback = returned > 0
+        let settled = try await backend.readFinal(deadline: deadline)
+        phase("settled-\(delay)-read-returned")
+        try settled.requireSameTarget(as: initial, includeValue: false)
+        guard abs(try settled.requireValue() - target) <= domain.tolerance else { throw FBSimulatorSliderError.noProgress }
+        awaitingReadback = false
+        try await record("settled-\(delay)", settled)
+      }
+      try Self.check(deadline)
+      phase("complete")
+      outcome = already ? "alreadyAtEndpoint" : "endpointObserved"
+      delivery = returned == 0 ? "notDispatched" : "valueObserved"
+    } catch {
+      phase("failed: " + String(describing: error))
+      let uncertain: Bool
+      if case FBSimulatorSliderError.deliveryUncertain = error { uncertain = true }
+      else { uncertain = awaitingReadback }
+      reason = String(describing: error)
+      delivery = uncertain ? "uncertain" : returned == 0 ? "notDispatched" : "valueObserved"
+    }
+    phase("cleanup-start")
+    await backend.finish(operationID: operationID)
+    phase("cleanup-returned")
+    phases.append(contentsOf: await backend.diagnosticPhases(operationID: operationID))
+    phases.sort { $0.uptime < $1.uptime }
+    if outcome != "failed" {
+      do { try Self.check(deadline) }
+      catch { outcome = "failed"; reason = String(describing: error) }
+    }
+    return receipt(outcome, reason, delivery: delivery)
+  }
+}
