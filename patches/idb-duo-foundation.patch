+ */
+
+@_implementationOnly @preconcurrency import CoreSimDeviceIO
+@preconcurrency import CoreSimulator
+import Foundation
+
+/// One host screen-properties snapshot. This does not identify the active panel.
+public struct FBSimulatorDisplayInfo: Sendable {
+  public let screenID: UInt32
+  public let uniqueID: String?
+  public let name: String?
+  public let deviceName: String?
+  public let nativePixelSize: CGSize
+  public let scale: Double
+  public let propertiesSeed: UInt32
+  public let rawScreenType: UInt64
+  /// Host UI orientation. It is not a guest CADisplay rotation value.
+  public let rawUIOrientation: UInt32
+  public let rawPowerState: Int32
+  public let rawBacklightState: Int32?
+  public let backlightBrightnessFactor: Double?
+}
+
+/// Reads fresh runtime data. It does not infer a panel from its ID, size or hinge angle.
+public enum FBSimulatorDisplayDiscovery {
+  public static func displays(for simulator: FBSimulator) async throws -> [FBSimulatorDisplayInfo] {
+    try await displays(for: simulator, timeout: 3)
+  }
+
+  public static func displays(for simulator: FBSimulator, timeout: TimeInterval) async throws -> [FBSimulatorDisplayInfo] {
+    guard timeout.isFinite, timeout > 0, timeout <= 30 else {
+      throw FBSimulatorError.describe("Display discovery timeout must be in (0, 30] seconds").build()
+    }
+    let deadline = ProcessInfo.processInfo.systemUptime + timeout
+    try Task.checkCancellation()
+    guard let io = simulator.device.io, let ports = io.ioPorts() else {
+      throw FBSimulatorError.describe("Simulator IO ports are unavailable").build()
+    }
+    var result: [FBSimulatorDisplayInfo] = []
+    var foundAdapter = false
+    for port in ports {
+      guard let adapter = port.descriptor as? any SimScreenAdapter else { continue }
+      guard adapter.responds(to: #selector(SimScreenAdapter.enumerateScreens(withCompletionQueue:completionHandler:))) else {
+        throw FBSimulatorError.describe("Screen adapter does not support enumeration").build()
+      }
+      foundAdapter = true
+      let remaining = deadline - ProcessInfo.processInfo.systemUptime
+      guard remaining > 0 else { throw FBSimulatorError.describe("Display discovery timed out").build() }
+      let snapshots = try await snapshots(from: adapter, timeout: remaining)
+      result.append(contentsOf: snapshots)
+    }
+    guard foundAdapter else {
+      throw FBSimulatorError.describe("No runtime screen adapter is available").build()
+    }
+    var identifiers = Set<UInt32>()
+    for display in result {
+      guard identifiers.insert(display.screenID).inserted else {
+        throw FBSimulatorError.describe("Screen ID \(display.screenID) is ambiguous across runtime adapters").build()
+      }
+    }
+    return result.sorted { $0.screenID < $1.screenID }
+  }
+
+  public static func display(for simulator: FBSimulator, screenID: UInt32) async throws -> FBSimulatorDisplayInfo {
+    let available = try await displays(for: simulator)
+    guard let selected = available.first(where: { $0.screenID == screenID }) else {
+      throw FBSimulatorError.describe("Screen ID \(screenID) was not found in the current runtime").build()
+    }
+    return selected
+  }
+
+  private static func snapshots(from adapter: any SimScreenAdapter, timeout: TimeInterval) async throws -> [FBSimulatorDisplayInfo] {
+    let result = FBSimulatorBoundedResult<[FBSimulatorDisplayInfo]>()
+    return try await result.value(timeout: timeout, operation: "Display enumeration") { finish in
+      adapter.enumerateScreens(withCompletionQueue: DispatchQueue.global(qos: .userInitiated)) { screens, error in
+        if let error { finish(.failure(error)); return }
+        guard let screens else {
+          finish(.failure(FBSimulatorError.describe("Screen enumeration returned no result").build()))
+          return
+        }
+        do { finish(.success(try screens.map { try snapshot(of: $0) })) }
+        catch { finish(.failure(error)) }
+      }
+    }
+  }
+
+  static func snapshot(of screen: any SimScreen) throws -> FBSimulatorDisplayInfo {
+    guard screen.responds(to: #selector(getter: SimScreen.screenProperties)),
+      let properties = screen.screenProperties
+    else {
+      throw FBSimulatorError.describe("Runtime screen properties or mode are unavailable").build()
+    }
+    return try snapshot(properties: properties)
+  }
+
+  static func snapshot(properties: any SimScreenProperties) throws -> FBSimulatorDisplayInfo {
+    guard let mode = properties.currentMode else {
+      throw FBSimulatorError.describe("Runtime screen mode is unavailable").build()
+    }
+    let pixelSize = properties.pixelSize
+    let scale = mode.preferredUIScale
+    guard pixelSize.width.isFinite, pixelSize.height.isFinite,
+      pixelSize.width > 0, pixelSize.height > 0, scale.isFinite, scale > 0
+    else {
+      throw FBSimulatorError.describe("Runtime screen has invalid pixel dimensions or scale").build()
+    }
+    let backlight = properties.backlight
+    return FBSimulatorDisplayInfo(
+      screenID: properties.screenID,
+      uniqueID: properties.uniqueId,
+      name: properties.name,
+      deviceName: properties.deviceName,
+      nativePixelSize: pixelSize,
+      scale: scale,
+      propertiesSeed: properties.seed,
+      rawScreenType: properties.screenType,
+      rawUIOrientation: properties.uiOrientation,
+      rawPowerState: properties.powerState,
+      rawBacklightState: backlight?.state,
+      backlightBrightnessFactor: backlight?.brightnessFactor)
+  }
+}
+
+/// Owns the one continuation shared by callback, timeout, and caller cancellation.
+/// A late Apple callback is ignored. Enumeration has no verified cancellation API.
+final class FBSimulatorBoundedResult<Value: Sendable>: @unchecked Sendable {
+  private let lock = NSLock()
+  private var result: Result<Value, Error>?
+  private var continuation: CheckedContinuation<Value, Error>?
+
+  func finish(_ result: Result<Value, Error>) {
+    lock.lock()
+    guard self.result == nil else { lock.unlock(); return }
+    self.result = result
+    let pending = continuation
+    continuation = nil
+    lock.unlock()
+    pending?.resume(with: result)
+  }
+
+  private func install(_ pending: CheckedContinuation<Value, Error>) -> Bool {
+    lock.lock()
+    if let result { lock.unlock(); pending.resume(with: result); return false }
+    continuation = pending
+    lock.unlock()
+    return true
+  }
+
+  func value(timeout: TimeInterval, operation: String,
+             start: (@escaping @Sendable (Result<Value, Error>) -> Void) -> Void) async throws -> Value {
+    try await withTaskCancellationHandler(operation: {
+      try Task.checkCancellation()
+      return try await withCheckedThrowingContinuation { pending in
+        guard install(pending) else { return }
+        DispatchQueue.global().asyncAfter(deadline: .now() + timeout) {
+          self.finish(.failure(FBSimulatorError.describe("\(operation) timed out").build()))
+        }
+        start { self.finish($0) }
+      }
+    }, onCancel: { self.finish(.failure(CancellationError())) })
+  }
+}
diff --git a/FBSimulatorControl/HID/ActivePanelDecoder.swift b/FBSimulatorControl/HID/ActivePanelDecoder.swift
new file mode 100644
index 0000000..6a3c035
--- /dev/null
+++ b/FBSimulatorControl/HID/ActivePanelDecoder.swift
@@ -0,0 +1,218 @@
+import Foundation
+
+public enum ActivePanelDecoder {
+    public static let maximumJSONBytes = 1_048_576
+
+    public static func validateExpected(_ panels: [ActivePanelIdentity], selected: ActivePanelExpectation) throws {
+        guard !panels.isEmpty, panels.count <= 32,
+              Set(panels.map(\.displayID)).count == panels.count,
+              Set(panels.map(\.uniqueID)).count == panels.count else {
+            throw ActivePanelValidationError.invalidExpectedCatalog
+        }
+        guard panels.contains(selected.identity),
+              [selected.nativePixelWidth, selected.nativePixelHeight].allSatisfy({ $0.isFinite && $0 > 0 && $0 <= 65536 }),
+              selected.scale.isFinite, selected.scale > 0, selected.scale <= 16 else {
+            throw ActivePanelValidationError.invalidSelectedExpectation
+        }
+    }
+
+    public static func decode(_ data: Data, simulatorUDID: UUID,
+                              expectedPanels: [ActivePanelIdentity], selected: ActivePanelExpectation,
+                              exactArguments: [String], schemaPolicy: ActivePanelSchemaPolicy = .explicitActiveFlag) throws -> ActivePanelSnapshot {
+        try validateExpected(expectedPanels, selected: selected)
+        let snapshot = try decodeCatalog(data, simulatorUDID: simulatorUDID,
+            expectedPanels: expectedPanels, exactArguments: exactArguments, schemaPolicy: schemaPolicy)
+        let panel = snapshot.activePanel
+        guard panel.identity == selected.identity else {
+            throw ActivePanelValidationError.inactiveSelection(requested: selected.identity, observed: panel.identity)
+        }
+        guard panel.nativePixelWidth == selected.nativePixelWidth,
+              panel.nativePixelHeight == selected.nativePixelHeight,
+              panel.boundsOriginX == 0, panel.boundsOriginY == 0,
+              panel.boundsWidth == selected.nativePixelWidth, panel.boundsHeight == selected.nativePixelHeight,
+              Double(panel.pointScale) == selected.scale else {
+            throw ActivePanelValidationError.selectedGeometryMismatch
+        }
+        guard panel.currentOrientation == selected.rotation else {
+            throw ActivePanelValidationError.selectedRotationMismatch
+        }
+        return snapshot
+    }
+
+    /// Discovers the active row only after every integrated host identity and geometry matches.
+    public static func decodeDiscovery(_ data: Data, simulatorUDID: UUID,
+                                       expectedCatalog: [ActivePanelCatalogEntry], exactArguments: [String],
+                                       schemaPolicy: ActivePanelSchemaPolicy = .explicitActiveFlag) throws -> ActivePanelSnapshot {
+        try validateCatalog(expectedCatalog)
+        let snapshot = try decodeCatalog(data, simulatorUDID: simulatorUDID,
+            expectedPanels: expectedCatalog.map(\.identity), exactArguments: exactArguments, schemaPolicy: schemaPolicy)
+        for panel in snapshot.panels {
+            guard let expected = expectedCatalog.first(where: { $0.identity == panel.identity }),
+                  panel.nativePixelWidth == expected.nativePixelWidth,
+                  panel.nativePixelHeight == expected.nativePixelHeight,
+                  panel.boundsOriginX == 0, panel.boundsOriginY == 0,
+                  panel.boundsWidth == expected.nativePixelWidth,
+                  panel.boundsHeight == expected.nativePixelHeight,
+                  Double(panel.pointScale) == expected.scale else {
+                throw ActivePanelValidationError.catalogGeometryMismatch(panel.identity.displayID)
+            }
+        }
+        return snapshot
+    }
+
+    public static func validateCatalog(_ catalog: [ActivePanelCatalogEntry]) throws {
+        guard !catalog.isEmpty, catalog.count <= 32,
+              Set(catalog.map { $0.identity.displayID }).count == catalog.count,
+              Set(catalog.map { $0.identity.uniqueID }).count == catalog.count,
+              catalog.allSatisfy({ entry in
+                  [entry.nativePixelWidth, entry.nativePixelHeight].allSatisfy { $0.isFinite && $0 > 0 && $0 <= 65536 }
+                      && entry.scale.isFinite && entry.scale > 0 && entry.scale <= 16
+              }) else {
+            throw ActivePanelValidationError.invalidExpectedCatalog
+        }
+    }
+
+    private static func decodeCatalog(_ data: Data, simulatorUDID: UUID,
+                                      expectedPanels: [ActivePanelIdentity], exactArguments: [String],
+                                      schemaPolicy: ActivePanelSchemaPolicy) throws -> ActivePanelSnapshot {
+        guard data.count <= maximumJSONBytes else { throw ActivePanelValidationError.oversizedJSON }
+        let envelope: DisplayEnvelope
+        do { envelope = try JSONDecoder().decode(DisplayEnvelope.self, from: data) }
+        catch { throw ActivePanelValidationError.malformedJSON(String(describing: error)) }
+        let info = envelope.info
+        guard info.jsonVersion == 5, info.commandType == "devicectl.device.info.displays",
+              !info.version.isEmpty else { throw ActivePanelValidationError.wrongCommandOrSchema }
+        guard info.outcome == "success" else { throw ActivePanelValidationError.unsuccessfulOutcome(info.outcome) }
+        let args = info.arguments
+        guard args == exactArguments, args.count == 10,
+              Array(args.prefix(5)) == ["devicectl", "device", "info", "displays", "--device"],
+              UUID(uuidString: args[5]) == simulatorUDID,
+              args[6] == "--timeout", args[7] == "5", args[8] == "--json-output", !args[9].isEmpty else {
+            throw ActivePanelValidationError.wrongArguments
+        }
+        guard let rows = envelope.result?.displays, !rows.isEmpty, rows.count <= 32 else {
+            throw ActivePanelValidationError.invalidDisplayCount
+        }
+        let identities = rows.map { ActivePanelIdentity(displayID: $0.displayId, uniqueID: $0.uniqueId) }
+        guard Set(identities.map(\.displayID)).count == rows.count,
+              Set(identities.map(\.uniqueID)).count == rows.count else {
+            throw ActivePanelValidationError.duplicateIdentity
+        }
+        guard Set(identities) == Set(expectedPanels), identities.count == expectedPanels.count else {
+            throw ActivePanelValidationError.catalogMismatch
+        }
+        let panels = try rows.map { row -> ActivePanel in
+            guard row.nativeSize.count == 2, row.bounds.count == 2,
+                  row.bounds.allSatisfy({ $0.count == 2 }), row.pointScale > 0, row.pointScale <= 16,
+                  row.nativeSize.allSatisfy({ $0.isFinite && $0 > 0 && $0 <= 65536 }),
+                  row.bounds.flatMap({ $0 }).allSatisfy({ $0.isFinite }),
+                  row.bounds[1].allSatisfy({ $0 > 0 && $0 <= 65536 }) else {
+                throw ActivePanelValidationError.invalidGeometry(row.displayId)
+            }
+            return ActivePanel(identity: ActivePanelIdentity(displayID: row.displayId, uniqueID: row.uniqueId),
+                active: row.active, primary: row.primary, currentOrientation: row.currentOrientation,
+                nativeOrientation: row.nativeOrientation, nativePixelWidth: row.nativeSize[0],
+                nativePixelHeight: row.nativeSize[1], boundsOriginX: row.bounds[0][0],
+                boundsOriginY: row.bounds[0][1], boundsWidth: row.bounds[1][0], boundsHeight: row.bounds[1][1],
+                pointScale: row.pointScale, backlightState: row.backlightState)
+        }
+        if schemaPolicy == .verifiedIPadMiniA17ProProfile405 {
+            guard info.version == "651.28", panels.count == 1, expectedPanels.count == 1,
+                  panels.first?.identity.displayID == 1 else {
+                throw ActivePanelValidationError.unsupportedRigidSchema
+            }
+        }
+        let panel: ActivePanel
+        let selectionBasis: ActivePanelSelectionBasis
+        if panels.contains(where: { $0.active == nil }) {
+            guard schemaPolicy == .verifiedIPhone18ProProfile405
+                    || schemaPolicy == .verifiedIPadMiniA17ProProfile405 else {
+                throw ActivePanelValidationError.missingActiveFlag
+            }
+            // This is a separate measured schema, not an inferred active flag. A single
+            // integrated panel must match the independent full catalog and selected pair.
+            guard info.version == "651.28", panels.count == 1, expectedPanels.count == 1,
+                  let only = panels.first, only.active == nil else {
+                throw ActivePanelValidationError.unsupportedRigidSchema
+            }
+            panel = only
+            selectionBasis = .verifiedSingleIntegratedPanel
+        } else {
+            let active = panels.filter { $0.active == true }
+            guard active.count == 1, let only = active.first else {
+                throw ActivePanelValidationError.activeStateUnavailable(active.count)
+            }
+            panel = only
+            selectionBasis = .explicitActiveFlag
+        }
+        return ActivePanelSnapshot(requestedSimulatorUDID: simulatorUDID,
+            sourceCommandType: info.commandType, sourceJSONVersion: info.jsonVersion,
+            sourceVersion: info.version, activePanel: panel, selectionBasis: selectionBasis, panels: panels)
+    }
+}
+
+private struct DisplayKind: Decodable {
+    private struct Key: CodingKey {
+        let stringValue: String
+        var intValue: Int? { nil }
+        init?(stringValue: String) { self.stringValue = stringValue }
+        init?(intValue: Int) { return nil }
+    }
+    init(from decoder: Decoder) throws {
+        let object = try decoder.container(keyedBy: Key.self)
+        guard object.allKeys.count == 1, let key = object.allKeys.first, key.stringValue == "integrated" else {
+            throw DecodingError.dataCorrupted(.init(codingPath: decoder.codingPath, debugDescription: "Unsupported display kind"))
+        }
+        let payload = try object.nestedContainer(keyedBy: Key.self, forKey: key)
+        guard payload.allKeys.isEmpty else {
+            throw DecodingError.dataCorrupted(.init(codingPath: decoder.codingPath, debugDescription: "Unexpected integrated payload"))
+        }
+    }
+}
+
+private struct DisplayRow: Decodable {
+    let displayId: UInt32
+    let uniqueId: UUID
+    let active: Bool?
+    let primary: Bool
+    let currentOrientation: ActivePanelRotation
+    let nativeOrientation: ActivePanelRotation
+    let nativeSize: [Double]
+    let bounds: [[Double]]
+    let pointScale: Int
+    let type: DisplayKind
+    let backlightState: String?
+
+    private enum CodingKeys: String, CodingKey {
+        case displayId, uniqueId, active, primary, currentOrientation, nativeOrientation
+        case nativeSize, bounds, pointScale, type, backlightState
+    }
+    init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        displayId = try values.decode(UInt32.self, forKey: .displayId)
+        uniqueId = try values.decode(UUID.self, forKey: .uniqueId)
+        // Only an omitted key is the measured rigid schema. Null or another type fails.
+        active = values.contains(.active) ? try values.decode(Bool.self, forKey: .active) : nil
+        primary = try values.decode(Bool.self, forKey: .primary)
+        currentOrientation = try values.decode(ActivePanelRotation.self, forKey: .currentOrientation)
+        nativeOrientation = try values.decode(ActivePanelRotation.self, forKey: .nativeOrientation)
+        nativeSize = try values.decode([Double].self, forKey: .nativeSize)
+        bounds = try values.decode([[Double]].self, forKey: .bounds)
+        pointScale = try values.decode(Int.self, forKey: .pointScale)
+        type = try values.decode(DisplayKind.self, forKey: .type)
+        backlightState = try values.decodeIfPresent(String.self, forKey: .backlightState)
+    }
+}
+
+private struct DisplayEnvelope: Decodable {
+    struct Info: Decodable {
+        let arguments: [String]
+        let commandType: String
+        let jsonVersion: Int
+        let outcome: String
+        let version: String
+    }
+    struct Rows: Decodable { let displays: [DisplayRow] }
+    let info: Info
+    let result: Rows?
+}
diff --git a/FBSimulatorControl/HID/ActivePanelModels.swift b/FBSimulatorControl/HID/ActivePanelModels.swift
new file mode 100644
index 0000000..ff1bbd0
