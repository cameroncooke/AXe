+import Foundation
+import FBSimulatorControl
+import Testing
+
+@Suite("Measured DeviceKit schema 6 active panel")
+struct ActivePanelSchema6Tests {
+    private let simulator = UUID(uuidString: "419D3218-79E5-46DE-80C0-E58126A88252")!
+    private let panelID = UUID(uuidString: "AA9A9ACC-A21D-4534-BCF4-B4ED099F7E6E")!
+    private let alternateID = UUID(uuidString: "2DFB251F-846D-444D-972B-B39B02F5228D")!
+    private let litRow = #"        "backlightState" : "activeOn""#
+
+    private var arguments: [String] {
+        ["devicectl", "device", "info", "displays", "--device", simulator.uuidString,
+         "--timeout", "5", "--json-output", "/private/tmp/axe-timing-display-diagnostic.json"]
+    }
+
+    private var expected: [ActivePanelCatalogEntry] {
+        [.init(identity: .init(displayID: 1, uniqueID: panelID), nativePixelWidth: 1206,
+               nativePixelHeight: 2622, scale: 3)]
+    }
+
+    @Test func measuredReportRetainsIdentityAndGeometry() throws {
+        let snapshot = try discover(Self.report)
+        #expect(snapshot.sourceJSONVersion == 6 && snapshot.sourceVersion == "689.2")
+        #expect(snapshot.selectionBasis == .verifiedSingleIntegratedPanel)
+        #expect(snapshot.panels.count == 1 && snapshot.activePanel.identity == expected[0].identity)
+        #expect(snapshot.activePanel.primary && snapshot.activePanel.active == nil)
+        #expect(snapshot.activePanel.nativePixelWidth == 1206 && snapshot.activePanel.nativePixelHeight == 2622)
+        #expect(snapshot.activePanel.pointScale == 3 && snapshot.activePanel.currentOrientation == .rot0)
+    }
+
+    @Test func unmeasuredSchemaVersionPairsReject() throws {
+        for (field, replacement) in [(#""jsonVersion" : 6"#, #""jsonVersion" : 7"#),
+                                     (#""version" : "689.2""#, #""version" : "689.3""#)] {
+            let report = try replacing(Self.report, field, replacement)
+            #expect(throws: ActivePanelValidationError.wrongCommandOrSchema) { _ = try discover(report) }
+        }
+    }
+
+    @Test func omittedActiveRequiresOnePrimaryLitPanel() throws {
+        let nonprimary = try replacing(Self.report, #""primary" : true"#, #""primary" : false"#)
+        let off = try replacing(Self.report, litRow, #"        "backlightState" : "off""#)
+        let unknown = try replacing(Self.report, litRow + ",\n", "")
+        for report in [nonprimary, off, unknown] {
+            #expect(throws: ActivePanelValidationError.missingActiveFlag) { _ = try discover(report) }
+        }
+    }
+
+    @Test func nullAndExplicitInactiveDoNotBecomeInferredActive() throws {
+        let null = try withActive("null", in: Self.report)
+        do {
+            _ = try discover(null)
+            Issue.record("A null active value was accepted.")
+        } catch ActivePanelValidationError.malformedJSON(_) {}
+        let inactive = try withActive("false", in: Self.report)
+        #expect(throws: ActivePanelValidationError.activeStateUnavailable(0)) { _ = try discover(inactive) }
+    }
+
+    @Test func multiplePanelsRequireUniqueExplicitActiveState() throws {
+        let host = expected + [.init(identity: .init(displayID: 2, uniqueID: alternateID),
+            nativePixelWidth: 1206, nativePixelHeight: 2622, scale: 3)]
+        let complete = try twoPanels(firstActive: "false", secondActive: "true")
+        let snapshot = try discover(complete, host: host)
+        #expect(snapshot.selectionBasis == .explicitActiveFlag)
+        #expect(snapshot.activePanel.identity == host[1].identity)
+        let missing = try twoPanels(firstActive: nil, secondActive: "true")
+        #expect(throws: ActivePanelValidationError.missingActiveFlag) { _ = try discover(missing, host: host) }
+        let ambiguous = try twoPanels(firstActive: "true", secondActive: "true")
+        #expect(throws: ActivePanelValidationError.activeStateUnavailable(2)) { _ = try discover(ambiguous, host: host) }
+    }
+
+    @Test func hostIdentityGeometryAndSelectedRotationRemainRequired() throws {
+        let wrongID = try replacing(Self.report, panelID.uuidString, alternateID.uuidString)
+        #expect(throws: ActivePanelValidationError.catalogMismatch) { _ = try discover(wrongID) }
+        let wrongScale = try replacing(Self.report, #""pointScale" : 3"#, #""pointScale" : 2"#)
+        #expect(throws: ActivePanelValidationError.catalogGeometryMismatch(1)) { _ = try discover(wrongScale) }
+        let rotated = ActivePanelExpectation(identity: expected[0].identity,
+            nativePixelWidth: 1206, nativePixelHeight: 2622, scale: 3, rotation: .rot90)
+        #expect(throws: ActivePanelValidationError.selectedRotationMismatch) {
+            _ = try ActivePanelDecoder.decode(Data(Self.report.utf8), simulatorUDID: simulator,
+                expectedPanels: expected.map(\.identity), selected: rotated, exactArguments: arguments)
+        }
+    }
+
+    @Test func schemaFiveStillRequiresItsMeasuredProfileWhenActiveIsOmitted() throws {
+        let v5 = try replacing(Self.report, #""jsonVersion" : 6"#, #""jsonVersion" : 5"#)
+        let legacy = try replacing(v5, #""version" : "689.2""#, #""version" : "651.28""#)
+        #expect(throws: ActivePanelValidationError.missingActiveFlag) { _ = try discover(legacy) }
+        let verified = try ActivePanelDecoder.decodeDiscovery(Data(legacy.utf8), simulatorUDID: simulator,
+            expectedCatalog: expected, exactArguments: arguments, schemaPolicy: .verifiedIPhone18ProProfile405)
+        #expect(verified.selectionBasis == .verifiedSingleIntegratedPanel)
+        #expect(verified.activePanel.active == nil)
+    }
+
+    private func discover(_ report: String, host: [ActivePanelCatalogEntry]? = nil) throws -> ActivePanelSnapshot {
+        try ActivePanelDecoder.decodeDiscovery(Data(report.utf8), simulatorUDID: simulator,
+            expectedCatalog: host ?? expected, exactArguments: arguments)
+    }
+
+    private func replacing(_ text: String, _ from: String, _ to: String) throws -> String {
+        try #require(text.components(separatedBy: from).count == 2)
+        return text.replacingOccurrences(of: from, with: to)
+    }
+
+    private func withActive(_ value: String, in report: String) throws -> String {
+        try replacing(report, litRow, "        \"active\" : \(value),\n" + litRow)
+    }
+
+    private func twoPanels(firstActive: String?, secondActive: String) throws -> String {
+        let start = try #require(Self.report.range(of: "    \"displays\" : [\n"))
+        let end = try #require(Self.report.range(of: "\n    ],\n    \"orientation\""))
+        let row = String(Self.report[start.upperBound..<end.lowerBound])
+        let first = try firstActive.map { try withActive($0, in: row) } ?? row
+        var second = try replacing(row, panelID.uuidString, alternateID.uuidString)
+        second = try replacing(second, #""displayId" : 1"#, #""displayId" : 2"#)
+        second = try replacing(second, #""primary" : true"#, #""primary" : false"#)
+        second = try withActive(secondActive, in: second)
+        return try replacing(Self.report, row, first + ",\n" + second)
+    }
+
