+++ b/FBSimulatorControl/HID/ActivePanelModels.swift
@@ -0,0 +1,158 @@
+import Foundation
+
+public struct ActivePanelIdentity: Codable, Hashable, Sendable {
+    public let displayID: UInt32
+    public let uniqueID: UUID
+    public init(displayID: UInt32, uniqueID: UUID) {
+        self.displayID = displayID
+        self.uniqueID = uniqueID
+    }
+}
+
+/// Independent host geometry for active-panel discovery; no active state or rotation is assumed.
+public struct ActivePanelCatalogEntry: Codable, Equatable, Sendable {
+    public let identity: ActivePanelIdentity
+    public let nativePixelWidth: Double
+    public let nativePixelHeight: Double
+    public let scale: Double
+
+    public init(identity: ActivePanelIdentity, nativePixelWidth: Double,
+                nativePixelHeight: Double, scale: Double) {
+        self.identity = identity
+        self.nativePixelWidth = nativePixelWidth
+        self.nativePixelHeight = nativePixelHeight
+        self.scale = scale
+    }
+}
+
+public enum ActivePanelRotation: String, Codable, Sendable {
+    case rot0, rot90, rot180, rot270
+}
+
+/// Values must come from the independently joined host and guest catalog.
+public struct ActivePanelExpectation: Codable, Equatable, Sendable {
+    public let identity: ActivePanelIdentity
+    public let nativePixelWidth: Double
+    public let nativePixelHeight: Double
+    public let scale: Double
+    public let rotation: ActivePanelRotation
+    public init(identity: ActivePanelIdentity, nativePixelWidth: Double,
+                nativePixelHeight: Double, scale: Double, rotation: ActivePanelRotation) {
+        self.identity = identity
+        self.nativePixelWidth = nativePixelWidth
+        self.nativePixelHeight = nativePixelHeight
+        self.scale = scale
+        self.rotation = rotation
+    }
+}
+
+/// Explicit flags remain mandatory unless the verified rigid profile supplies the sole panel.
+public enum ActivePanelSchemaPolicy: String, Codable, Sendable {
+    case explicitActiveFlag
+    case verifiedIPhone18ProProfile405
+    case verifiedIPadMiniA17ProProfile405
+}
+
+public enum ActivePanelSelectionBasis: String, Codable, Sendable {
+    case explicitActiveFlag
+    case verifiedSingleIntegratedPanel
+}
+
+public struct ActivePanel: Codable, Equatable, Sendable {
+    public let identity: ActivePanelIdentity
+    public let active: Bool?
+    public let primary: Bool
+    public let currentOrientation: ActivePanelRotation
+    public let nativeOrientation: ActivePanelRotation
+    public let nativePixelWidth: Double
+    public let nativePixelHeight: Double
+    public let boundsOriginX: Double
+    public let boundsOriginY: Double
+    public let boundsWidth: Double
+    public let boundsHeight: Double
+    public let pointScale: Int
+    public let backlightState: String?
+}
+
+public struct ActivePanelSnapshot: Codable, Sendable {
+    public let requestedSimulatorUDID: UUID
+    public let sourceCommandType: String
+    public let sourceJSONVersion: Int
+    public let sourceVersion: String
+    public let activePanel: ActivePanel
+    public let selectionBasis: ActivePanelSelectionBasis
+    public let panels: [ActivePanel]
+}
+
+public enum ActivePanelValidationError: Error, Equatable, Sendable {
+    case invalidExpectedCatalog
+    case invalidSelectedExpectation
+    case oversizedJSON
+    case malformedJSON(String)
+    case wrongCommandOrSchema
+    case unsuccessfulOutcome(String)
+    case wrongArguments
+    case invalidDisplayCount
+    case duplicateIdentity
+    case catalogMismatch
+    case catalogGeometryMismatch(UInt32)
+    case invalidGeometry(UInt32)
+    case activeStateUnavailable(Int)
+    case missingActiveFlag
+    case unsupportedRigidSchema
+    case inactiveSelection(requested: ActivePanelIdentity, observed: ActivePanelIdentity)
+    case selectedGeometryMismatch
+    case selectedRotationMismatch
+}
+
+public enum ActivePanelChildFailure: String, Codable, Sendable {
+    case cancelled, deadline, outputLimit, launchFailed, nonzeroExit
+    case cleanupUnconfirmed, ioFailure, missingJSON
+}
+
+/// Diagnostic fields do not belong in semantic context equality.
+public struct ActivePanelChildReceipt: Codable, Sendable {
+    public let executable: String
+    public let arguments: [String]
+    public let startedUptime: Double
+    public let finishedUptime: Double
+    public let processIdentifier: Int32?
+    public let launchAttempted: Bool
+    public let launchReturned: Bool
+    public let exitConfirmed: Bool
+    public let terminationStatus: Int32?
+    public let terminationReason: String?
+    public let stopReason: ActivePanelChildFailure?
+    public let detail: String?
+    public let sentTerminate: Bool
+    public let sentKill: Bool
+    public let json: Data
+    public let stderr: Data
+}
+
+public struct ActivePanelReadError: Error, Sendable {
+    public let childFailure: ActivePanelChildFailure?
+    public let validationFailure: ActivePanelValidationError?
+    public let receipt: ActivePanelChildReceipt?
+    public init(childFailure: ActivePanelChildFailure? = nil,
+                validationFailure: ActivePanelValidationError? = nil,
+                receipt: ActivePanelChildReceipt? = nil) {
+        self.childFailure = childFailure
+        self.validationFailure = validationFailure
+        self.receipt = receipt
+    }
+}
+
+public struct ActivePanelReadback: Sendable {
+    public let snapshot: ActivePanelSnapshot
+    public let receipt: ActivePanelChildReceipt
+}
+
+/// Metadata for a completed full discovery read, separate from physical panel snapshots.
+/// Uptime values use the host monotonic clock. They are not frame times or an admission lease.
+public struct ActivePanelDiscoveryResult: Sendable {
+    public let readback: ActivePanelReadback
+    public let bootIdentity: String
+    public let startedUptime: Double
+    public let finishedUptime: Double
+}
diff --git a/FBSimulatorControl/HID/ActivePanelReader.swift b/FBSimulatorControl/HID/ActivePanelReader.swift
new file mode 100644
--- /dev/null
+++ b/FBSimulatorControl/HID/ActivePanelReader.swift
@@ -0,0 +1,90 @@
+import Foundation
+import FBControlCore
+
+public enum ActivePanelReader {
+    public static func read(simulatorUDID: UUID, expectedPanels: [ActivePanelIdentity],
+                            selected: ActivePanelExpectation, developerDirectory: URL,
+                            schemaPolicy: ActivePanelSchemaPolicy = .explicitActiveFlag) async throws -> ActivePanelReadback {
+        do { try ActivePanelDecoder.validateExpected(expectedPanels, selected: selected) }
+        catch let error as ActivePanelValidationError { throw ActivePanelReadError(validationFailure: error) }
+        return try await readSnapshot(simulatorUDID: simulatorUDID, developerDirectory: developerDirectory) { data, arguments in
+            try ActivePanelDecoder.decode(data, simulatorUDID: simulatorUDID,
+                expectedPanels: expectedPanels, selected: selected, exactArguments: arguments, schemaPolicy: schemaPolicy)
+        }
+    }
+
+    /// Read-only discovery. The result is a measured catalogue, not an input admission token.
+    public static func discover(for simulator: FBSimulator) async throws -> ActivePanelReadback {
+        let discovery = try await discoverWithMetadata(for: simulator)
+        return discovery.readback
+    }
+
+    /// Includes the matched boot identity and host monotonic interval for the full discovery read.
+    /// The metadata is observational; callers must still perform fresh capture or input admission.
+    public static func discoverWithMetadata(for simulator: FBSimulator) async throws -> ActivePanelDiscoveryResult {
+        let started = ProcessInfo.processInfo.systemUptime
+        try Task.checkCancellation()
+        guard simulator.state == .booted, let simulatorID = UUID(uuidString: simulator.udid),
+              !FBXcodeConfiguration.developerDirectory.isEmpty else {
+            throw FBSimulatorContextError.unavailable("Display discovery requires a booted simulator and a developer directory")
+        }
+        let bootBefore = try FBSimulatorNativeContextReader.bootIdentity(simulator.udid)
+        let capability = try FBSimulatorNativeContextReader.capability(for: simulator)
+        let before = try FBSimulatorNativeContextReader.hostCatalog(
+            await FBSimulatorDisplayDiscovery.displays(for: simulator), profileIDs: capability.integratedDigitizerIDs)
+        let catalog = try before.map { display -> ActivePanelCatalogEntry in
+            guard let uniqueID = display.uniqueID.flatMap(UUID.init(uuidString:)) else {
+                throw ActivePanelValidationError.invalidExpectedCatalog
+            }
+            return ActivePanelCatalogEntry(identity: ActivePanelIdentity(displayID: display.screenID, uniqueID: uniqueID),
+                nativePixelWidth: display.nativePixelSize.width, nativePixelHeight: display.nativePixelSize.height, scale: display.scale)
+        }
+        let readback = try await discover(simulatorUDID: simulatorID, expectedCatalog: catalog,
+            developerDirectory: URL(fileURLWithPath: FBXcodeConfiguration.developerDirectory, isDirectory: true),
+            schemaPolicy: capability.activePanelSchemaPolicy)
+        let after = try FBSimulatorNativeContextReader.hostCatalog(
+            await FBSimulatorDisplayDiscovery.displays(for: simulator), profileIDs: capability.integratedDigitizerIDs)
+        let bootAfter = try FBSimulatorNativeContextReader.bootIdentity(simulator.udid)
+        guard simulator.state == .booted, bootBefore == bootAfter,
+              FBSimulatorNativeContextReader.sameCatalog(before, after) else {
+            throw FBSimulatorContextError.changedDuringRead
+        }
+        try Task.checkCancellation()
+        return ActivePanelDiscoveryResult(readback: readback, bootIdentity: bootBefore,
+            startedUptime: started, finishedUptime: ProcessInfo.processInfo.systemUptime)
+    }
+
+    public static func discover(simulatorUDID: UUID, expectedCatalog: [ActivePanelCatalogEntry],
+                                developerDirectory: URL,
+                                schemaPolicy: ActivePanelSchemaPolicy = .explicitActiveFlag) async throws -> ActivePanelReadback {
+        do { try ActivePanelDecoder.validateCatalog(expectedCatalog) }
+        catch let error as ActivePanelValidationError { throw ActivePanelReadError(validationFailure: error) }
+        return try await readSnapshot(simulatorUDID: simulatorUDID, developerDirectory: developerDirectory) { data, arguments in
+            try ActivePanelDecoder.decodeDiscovery(data, simulatorUDID: simulatorUDID,
+                expectedCatalog: expectedCatalog, exactArguments: arguments, schemaPolicy: schemaPolicy)
+        }
+    }
+
+    private static func readSnapshot(simulatorUDID: UUID, developerDirectory: URL,
+                                     decode: (Data, [String]) throws -> ActivePanelSnapshot) async throws -> ActivePanelReadback {
+        guard !Task.isCancelled else { throw ActivePanelReadError(childFailure: .cancelled) }
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("axe-active-panel-" + UUID().uuidString)
+        let response = directory.appendingPathComponent("response.json")
+        let arguments = ["device", "info", "displays", "--device", simulatorUDID.uuidString,
+                         "--timeout", "5", "--json-output", response.path]
+        var environment = ProcessInfo.processInfo.environment
+        environment["DEVELOPER_DIR"] = developerDirectory.path
+        let command = ActivePanelChildCommand(executable: developerDirectory.appendingPathComponent("usr/bin/devicectl"),
+            arguments: arguments, environment: environment, directory: directory, responseURL: response,
+            timeout: 6, maximumBytes: ActivePanelDecoder.maximumJSONBytes)
+        let receipt = try await OwnedActivePanelChild(command: command).run()
+        guard !Task.isCancelled else { throw ActivePanelReadError(childFailure: .cancelled, receipt: receipt) }
+        do {
+            let snapshot = try decode(receipt.json, ["devicectl"] + arguments)
+            guard !Task.isCancelled else { throw ActivePanelReadError(childFailure: .cancelled, receipt: receipt) }
+            return ActivePanelReadback(snapshot: snapshot, receipt: receipt)
+        } catch let error as ActivePanelValidationError {
+            throw ActivePanelReadError(validationFailure: error, receipt: receipt)
+        }
+    }
+}
