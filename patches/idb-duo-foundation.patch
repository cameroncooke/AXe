+import Foundation
+import Testing
+@testable import FBSimulatorControl
+
+@Suite("Exact iPad mini A17 Pro rigid profile")
+struct FBSimulatorIPadMiniProfileTests {
+  private let simulatorID = UUID(uuidString: "B3A07F27-3F72-4023-925C-4E7512AFDEC9")!
+  private let panelID = UUID(uuidString: "C7FF5832-A145-4221-BD6F-C19A7048EE7F")!
+  private let otherID = UUID(uuidString: "E8FBBE20-FA9D-4E62-86CF-6B63D64776B0")!
+
+  private struct Empty: Encodable {}
+  private struct Kind: Encodable { var integrated = Empty() }
+  private struct Row: Encodable {
+    var displayId: UInt32 = 1
+    var uniqueId = "C7FF5832-A145-4221-BD6F-C19A7048EE7F"
+    var active: Bool? = nil
+    var primary = true
+    var currentOrientation = "rot0"
+    var nativeOrientation = "rot0"
+    var nativeSize = [1488.0, 2266.0]
+    var bounds = [[0.0, 0.0], [1488.0, 2266.0]]
+    var pointScale = 2
+    var type = Kind()
+  }
+  private struct Info: Encodable {
+    var arguments: [String]
+    var commandType = "devicectl.device.info.displays"
+    var jsonVersion = 5
+    var outcome = "success"
+    var version = "651.28"
+  }
+  private struct Rows: Encodable { var displays: [Row] }
+  private struct Envelope: Encodable { var info: Info; var result: Rows }
+  private var arguments: [String] {
+    ["devicectl", "device", "info", "displays", "--device", simulatorID.uuidString,
+     "--timeout", "5", "--json-output", "/tmp/ipad-displays.json"]
+  }
+  private var identity: ActivePanelIdentity { ActivePanelIdentity(displayID: 1, uniqueID: panelID) }
+  private func catalog(_ identity: ActivePanelIdentity? = nil, width: Double = 1488,
+                       height: Double = 2266, scale: Double = 2) -> ActivePanelCatalogEntry {
+    ActivePanelCatalogEntry(identity: identity ?? self.identity,
+      nativePixelWidth: width, nativePixelHeight: height, scale: scale)
+  }
+  private func data(rows: [Row] = [Row()], info: Info? = nil) throws -> Data {
+    try JSONEncoder().encode(Envelope(info: info ?? Info(arguments: arguments), result: Rows(displays: rows)))
+  }
+  private func discover(_ bytes: Data, catalog: [ActivePanelCatalogEntry]? = nil,
+                         policy: ActivePanelSchemaPolicy? = nil) throws -> ActivePanelSnapshot {
+    let selectedPolicy = try policy ?? ipadPolicy()
+    return try ActivePanelDecoder.decodeDiscovery(bytes, simulatorUDID: simulatorID,
+      expectedCatalog: catalog ?? [self.catalog()], exactArguments: arguments, schemaPolicy: selectedPolicy)
+  }
+  private func ipadPolicy() throws -> ActivePanelSchemaPolicy {
+    try #require(ActivePanelSchemaPolicy(rawValue: "verifiedIPadMiniA17ProProfile405"))
+  }
+  private func capability(identifier: String = "com.apple.CoreSimulator.SimDeviceType.iPad-mini-A17-Pro",
+                          model: String = "iPad16,2", version: String = "405",
+                          ids: [UInt32] = [1]) -> FBSimulatorContextCapability {
+    FBSimulatorNativeContextReader.classifyCapability(identifier: identifier, model: model,
+      version: version, integratedDigitizerIDs: ids)
+  }
+
+  @Test func exactProfileHasNoHingeAndItsOwnSchemaPolicy() {
+    let actual = capability()
+    #expect(actual.hinge == .unsupported)
+    #expect(actual.activePanelSchemaPolicy.rawValue == "verifiedIPadMiniA17ProProfile405")
+    #expect(actual.integratedDigitizerIDs == [1])
+  }
+
+  @Test(arguments: ["identifier", "model", "version", "empty", "wrongID", "duplicate", "multiple"])
+  func unmeasuredProfilesRemainUnverified(change: String) {
+    var identifier = "com.apple.CoreSimulator.SimDeviceType.iPad-mini-A17-Pro"
+    var model = "iPad16,2"
+    var version = "405"
+    var ids: [UInt32] = [1]
+    switch change {
+    case "identifier": identifier += "-other"
+    case "model": model = "iPad16,1"
+    case "version": version = "406"
+    case "empty": ids = []
+    case "wrongID": ids = [2]
+    case "duplicate": ids = [1, 1]
+    default: ids = [1, 2]
+    }
+    let actual = capability(identifier: identifier, model: model, version: version, ids: ids)
+    #expect(actual.hinge == .unverified)
+    #expect(actual.activePanelSchemaPolicy == .explicitActiveFlag)
+  }
+
+  @Test func phoneAndDuoProfileRulesAreUnchanged() {
+    let phone = capability(identifier: "com.apple.CoreSimulator.SimDeviceType.iPhone-18-Pro",
+      model: "iPhone19,2", ids: [1])
+    #expect(phone.hinge == .unsupported)
+    #expect(phone.activePanelSchemaPolicy == .verifiedIPhone18ProProfile405)
+    let duo = capability(identifier: "com.apple.CoreSimulator.SimDeviceType.iPhone-Duo",
+      model: "iPhone19,4", ids: [1, 3])
+    #expect(duo.hinge == .supported)
+    #expect(duo.activePanelSchemaPolicy == .explicitActiveFlag)
+  }
+
+  @Test func measuredOmittedActiveSchemaKeepsNilAndJoinsGeometry() throws {
+    // Shape and scalar values come from the saved 651.28 / JSON 5 native iPad read.
+    let bytes = try data()
+    let snapshot = try discover(bytes)
+    #expect(snapshot.selectionBasis == .verifiedSingleIntegratedPanel)
+    #expect(snapshot.activePanel.active == nil)
+    #expect(snapshot.activePanel.identity == identity)
+    #expect(snapshot.activePanel.currentOrientation == .rot0)
+    #expect(snapshot.activePanel.nativePixelWidth == 1488 && snapshot.activePanel.nativePixelHeight == 2266)
+    #expect(snapshot.activePanel.pointScale == 2)
+    let selected = try ActivePanelDecoder.decode(bytes, simulatorUDID: simulatorID,
+      expectedPanels: [identity], selected: ActivePanelExpectation(identity: identity,
+        nativePixelWidth: 1488, nativePixelHeight: 2266, scale: 2, rotation: .rot0),
+      exactArguments: arguments, schemaPolicy: ipadPolicy())
+    #expect(selected.activePanel == snapshot.activePanel)
+  }
+
+  @Test(arguments: ["version", "schema", "outcome", "command", "arguments", "nullActive", "stringActive"])
+  func unmeasuredOrMalformedEnvelopesReject(change: String) throws {
+    var info = Info(arguments: arguments)
+    switch change {
+    case "version": info.version = "651.29"
+    case "schema": info.jsonVersion = 6
+    case "outcome": info.outcome = "failure"
+    case "command": info.commandType = "devicectl.device.info.details"
+    case "arguments": info.arguments[5] = otherID.uuidString
+    default: break
+    }
+    var bytes = try data(info: info)
+    if change == "nullActive" || change == "stringActive" {
+      let text = String(decoding: bytes, as: UTF8.self)
+      let value = change == "nullActive" ? "null" : "\"true\""
+      bytes = Data(text.replacingOccurrences(of: "\"primary\":true",
+        with: "\"active\":\(value),\"primary\":true").utf8)
+    }
+    #expect(throws: ActivePanelValidationError.self) { _ = try discover(bytes) }
+  }
+
+  @Test(arguments: ["id", "uuid", "width", "height", "scale", "origin"])
+  func independentCatalogMismatchesReject(change: String) throws {
+    var row = Row()
+    switch change {
+    case "id": row.displayId = 2
+    case "uuid": row.uniqueId = otherID.uuidString
+    case "width": row.nativeSize[0] += 1; row.bounds[1][0] += 1
+    case "height": row.nativeSize[1] += 1; row.bounds[1][1] += 1
+    case "scale": row.pointScale = 3
+    default: row.bounds[0][0] = 1
+    }
+    #expect(throws: ActivePanelValidationError.self) { _ = try discover(data(rows: [row])) }
+  }
+
+  @Test(arguments: ["duplicateID", "duplicateUUID", "multiple", "wrongSoleID"])
+  func duplicateOrUnsupportedPanelSetsReject(change: String) throws {
+    var second = Row(displayId: 2, uniqueId: otherID.uuidString)
+    if change == "duplicateID" { second.displayId = 1 }
+    if change == "duplicateUUID" { second.uniqueId = panelID.uuidString }
+    let rows = change == "wrongSoleID" ? [second] : [Row(), second]
+    let expected = change == "duplicateID" || change == "duplicateUUID" ? [catalog()]
+      : rows.map { catalog(ActivePanelIdentity(displayID: $0.displayId,
+          uniqueID: UUID(uuidString: $0.uniqueId)!)) }
+    #expect(throws: ActivePanelValidationError.self) { _ = try discover(data(rows: rows), catalog: expected) }
+  }
+
+  @Test(arguments: ["pair", "rotation", "geometry"])
+  func selectedReadRetainsExactPairPoseAndGeometry(change: String) throws {
+    let bytes = try data()
+    let expected = ActivePanelExpectation(
+      identity: change == "pair" ? ActivePanelIdentity(displayID: 1, uniqueID: otherID) : identity,
+      nativePixelWidth: change == "geometry" ? 1489 : 1488,
+      nativePixelHeight: 2266, scale: 2, rotation: change == "rotation" ? .rot90 : .rot0)
+    #expect(throws: ActivePanelValidationError.self) {
+      _ = try ActivePanelDecoder.decode(bytes, simulatorUDID: simulatorID,
+        expectedPanels: [identity], selected: expected, exactArguments: arguments,
+        schemaPolicy: ipadPolicy())
+    }
+  }
+
+  @Test func primaryNeverSubstitutesForActivityAndDefaultPolicyStaysStrict() throws {
+    #expect(throws: ActivePanelValidationError.missingActiveFlag) {
+      _ = try discover(data(), policy: .explicitActiveFlag)
+    }
+    #expect(throws: ActivePanelValidationError.activeStateUnavailable(0)) {
+      _ = try discover(data(rows: [Row(active: false)]))
+    }
+    let explicit = try discover(data(rows: [Row(active: true)]))
+    #expect(explicit.selectionBasis == .explicitActiveFlag)
+    var unknownVersion = Info(arguments: arguments)
+    unknownVersion.version = "651.29"
+    #expect(throws: ActivePanelValidationError.unsupportedRigidSchema) {
+      _ = try discover(data(rows: [Row(active: true)], info: unknownVersion))
+    }
+    let phone = try discover(data(), policy: .verifiedIPhone18ProProfile405)
+    #expect(phone.selectionBasis == .verifiedSingleIntegratedPanel && phone.activePanel.active == nil)
+  }
+}
