diff --git a/FBSimulatorControl/HID/FBSimulatorHIDDisplayFeed.swift b/FBSimulatorControl/HID/FBSimulatorHIDDisplayFeed.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a127a4b315ab4abe73936d82e3ae5e3e618c58e9
--- /dev/null
+++ b/FBSimulatorControl/HID/FBSimulatorHIDDisplayFeed.swift
@@ -0,0 +1,73 @@
+@_implementationOnly @preconcurrency import CoreSimDeviceIO
+@preconcurrency import CoreSimulator
+import Foundation
+
+/// Immutable Objective-C handles cross the enumeration callback boundary. Their mutable screen
+/// state is read through Apple's API; feed state itself is serialized by FBSimulatorHIDFeedState.
+private final class FBSimulatorHIDScreenHandles: @unchecked Sendable {
+  private let screens: [any SimScreen]
+  init(screens: [any SimScreen]) { self.screens = screens }
+  func values() -> [any SimScreen] { screens }
+}
+
+final class FBSimulatorHIDDisplayFeed: @unchecked Sendable {
+  private let screens: [any SimScreen]
+  private let registration = UUID()
+  private let lock = NSLock()
+  private var closed = false
+
+  private init(screens: [any SimScreen], state: FBSimulatorHIDFeedState) throws {
+    self.screens = screens
+    let queue = DispatchQueue(label: "com.facebook.FBSimulatorControl.hid-display-feed")
+    for screen in screens {
+      guard screen.responds(to: #selector(SimScreen.registerScreenCallbacks(with:callbackQueue:frameCallback:surfacesChangedCallback:propertiesChangedCallback:))),
+            screen.responds(to: #selector(SimScreen.unregisterScreenCallbacks(with:))) else {
+        throw FBSimulatorError.describe("Runtime screen callbacks are unavailable").build()
+      }
+    }
+    for screen in screens {
+      screen.registerScreenCallbacks(with: registration, callbackQueue: queue, frameCallback: {},
+        surfacesChangedCallback: { _, _ in }, propertiesChangedCallback: { properties in
+          do { state.observeDisplayCallback(try FBSimulatorDisplayDiscovery.snapshot(properties: properties)) }
+          catch { state.fail("Display callback: \(error)") }
+        })
+    }
+  }
+
+  static func start(for simulator: FBSimulator, state: FBSimulatorHIDFeedState) async throws -> FBSimulatorHIDDisplayFeed {
+    guard let io = simulator.device.io, let ports = io.ioPorts() else {
+      throw FBSimulatorError.describe("Simulator IO ports are unavailable").build()
+    }
+    let deadline = ProcessInfo.processInfo.systemUptime + 3
+    var all: [any SimScreen] = []
+    for port in ports {
+      guard let adapter = port.descriptor as? any SimScreenAdapter else { continue }
+      let remaining = deadline - ProcessInfo.processInfo.systemUptime
+      guard remaining > 0 else { throw FBSimulatorError.describe("Display callback setup timed out").build() }
+      let result = FBSimulatorBoundedResult<FBSimulatorHIDScreenHandles>()
+      let handles = try await result.value(timeout: remaining, operation: "Display callback setup") { finish in
+        adapter.enumerateScreens(withCompletionQueue: DispatchQueue.global(qos: .userInitiated)) { screens, error in
+          if let error { finish(.failure(error)); return }
+          guard let screens else {
+            finish(.failure(FBSimulatorError.describe("Screen enumeration returned no result").build())); return
+          }
+          finish(.success(FBSimulatorHIDScreenHandles(screens: screens)))
+        }
+      }
+      all.append(contentsOf: handles.values())
+    }
+    guard !all.isEmpty else { throw FBSimulatorError.describe("No screens to observe").build() }
+    try Task.checkCancellation()
+    // Registration precedes the first authoritative properties and guest-state snapshots.
+    return try FBSimulatorHIDDisplayFeed(screens: all, state: state)
+  }
+
+  func close() {
+    lock.lock()
+    guard !closed else { lock.unlock(); return }
+    closed = true
+    lock.unlock()
+    for screen in screens { screen.unregisterScreenCallbacks(with: registration) }
+  }
+  deinit { close() }
+}
diff --git a/FBSimulatorControl/HID/FBSimulatorHIDGesture.swift b/FBSimulatorControl/HID/FBSimulatorHIDGesture.swift
new file mode 100644
index 0000000000000000000000000000000000000000..7210611198ba652803ddd9c9937c2b21f0ed9c5d
--- /dev/null
+++ b/FBSimulatorControl/HID/FBSimulatorHIDGesture.swift
@@ -0,0 +1,140 @@
+import CoreGraphics
+import Foundation
+
+/// Validated gesture construction in the selected display's upright point space.
+/// No transport is opened until the complete event has passed preflight.
+public struct FBSimulatorHIDGesture {
+    public enum ConstructionError: Error, Equatable {
+        case invalidDuration
+        case invalidSpacing
+        case invalidGeometry
+        case excessiveSegments
+    }
+
+    public static let maximumSegments = 4096
+    public let observation: FBSimulatorHIDSessionObservation
+
+    public init(observation: FBSimulatorHIDSessionObservation) {
+        self.observation = observation
+    }
+
+    public func tap(at point: CGPoint, hold: TimeInterval = 0.1) throws -> FBSimulatorHIDEvent {
+        try duration(hold)
+        return try checked(.tapAt(x: point.x, y: point.y, duration: hold))
+    }
+
+    public func doubleTap(at point: CGPoint, hold: TimeInterval = 0.06,
+                          interval: TimeInterval = 0.1) throws -> FBSimulatorHIDEvent {
+        try duration(interval)
+        let single = try tap(at: point, hold: hold)
+        return try checked(.composite([single, .delay(interval), single]))
+    }
+
+    public func twoFingerTap(first: CGPoint, second: CGPoint,
+                             hold: TimeInterval = 0.1) throws -> FBSimulatorHIDEvent {
+        try duration(hold)
+        return try checked(.composite([
+            .twoFingerTouch(direction: .down, finger1: first, finger2: second),
+            .delay(hold),
+            .twoFingerTouch(direction: .up, finger1: first, finger2: second),
+        ]))
+    }
+
+    /// Includes exact start and end points. Short and zero-distance paths are valid.
+    /// The final stationary sample retains the existing arm-simulator scroll policy.
+    public func swipe(from start: CGPoint, to end: CGPoint, duration seconds: TimeInterval = 0.5,
+                      spacing: Double = 10) throws -> FBSimulatorHIDEvent {
+        try duration(seconds)
+        guard start.x.isFinite, start.y.isFinite, end.x.isFinite, end.y.isFinite else {
+            throw ConstructionError.invalidGeometry
+        }
+        let count = try segments(distance: hypot(end.x - start.x, end.y - start.y), spacing: spacing)
+        let points = (0...count).map { index in
+            let fraction = Double(index) / Double(count)
+            return CGPoint(x: start.x + (end.x - start.x) * fraction,
+                           y: start.y + (end.y - start.y) * fraction)
+        }
+        let delay = seconds / Double(points.count + 1)
+        var events: [FBSimulatorHIDEvent] = []
+        for point in points {
+            events.append(.touch(direction: .down, x: point.x, y: point.y))
+            events.append(.delay(delay))
+        }
+        events.append(.touch(direction: .down, x: end.x, y: end.y))
+        events.append(.delay(delay))
+        events.append(.touch(direction: .up, x: end.x, y: end.y))
+        return try checked(.composite(events))
+    }
+
+    public func drag(from start: CGPoint, to end: CGPoint, hold: TimeInterval = 0.5,
+                     duration seconds: TimeInterval = 0.5, spacing: Double = 10) throws -> FBSimulatorHIDEvent {
+        try duration(hold)
+        let motion = try swipe(from: start, to: end, duration: seconds, spacing: spacing)
+        return try checked(.composite([
+            .touch(direction: .down, x: start.x, y: start.y), .delay(hold), motion,
+        ]))
+    }
+
+    public func pinch(at center: CGPoint, scale: Double, radius: Double = 30,
+                      duration seconds: TimeInterval = 0.6, spacing: Double = 5) throws -> FBSimulatorHIDEvent {
+        guard scale.isFinite, scale > 0, radius.isFinite, radius > 0,
+              (radius * scale).isFinite else { throw ConstructionError.invalidGeometry }
+        let endRadius = radius * scale
+        let count = try segments(distance: abs(endRadius - radius), spacing: spacing)
+        return try pairMotion(center: center, duration: seconds, segments: count) { fraction in
+            (radius + (endRadius - radius) * fraction, 0)
+        }
+    }
+
+    /// Positive angles rotate clockwise in UIKit's top-left-origin coordinate space.
+    public func rotate(at center: CGPoint, degrees: Double, radius: Double = 30,
+                       duration seconds: TimeInterval = 0.6, spacing: Double = 5) throws -> FBSimulatorHIDEvent {
+        guard degrees.isFinite, radius.isFinite, radius > 0 else { throw ConstructionError.invalidGeometry }
+        let radians = degrees * .pi / 180
+        let count = try segments(distance: abs(radians) * radius, spacing: spacing)
+        return try pairMotion(center: center, duration: seconds, segments: count) { fraction in
+            (radius, radians * fraction)
+        }
+    }
+
+    private func pairMotion(center: CGPoint, duration seconds: TimeInterval, segments count: Int,
+                            geometry: (Double) -> (radius: Double, angle: Double)) throws -> FBSimulatorHIDEvent {
+        try duration(seconds)
+        guard center.x.isFinite, center.y.isFinite else { throw ConstructionError.invalidGeometry }
+        let delay = seconds / Double(count + 2)
+        var events: [FBSimulatorHIDEvent] = []
+        var finalFirst = CGPoint.zero
+        var finalSecond = CGPoint.zero
+        for index in 0...count {
+            let position = geometry(Double(index) / Double(count))
+            let dx = position.radius * cos(position.angle)
+            let dy = position.radius * sin(position.angle)
+            finalFirst = CGPoint(x: center.x - dx, y: center.y - dy)
+            finalSecond = CGPoint(x: center.x + dx, y: center.y + dy)
+            events.append(.twoFingerTouch(direction: .down, finger1: finalFirst, finger2: finalSecond))
+            events.append(.delay(delay))
+        }
+        events.append(.twoFingerTouch(direction: .down, finger1: finalFirst, finger2: finalSecond))
+        events.append(.delay(delay))
+        events.append(.twoFingerTouch(direction: .up, finger1: finalFirst, finger2: finalSecond))
+        return try checked(.composite(events))
+    }
+
+    private func segments(distance: Double, spacing: Double) throws -> Int {
+        guard spacing.isFinite, spacing > 0 else { throw ConstructionError.invalidSpacing }
+        guard distance.isFinite, distance >= 0 else { throw ConstructionError.invalidGeometry }
+        let count = ceil(distance / spacing)
+        guard count.isFinite, count <= Double(Self.maximumSegments) else { throw ConstructionError.excessiveSegments }
+        return max(1, Int(count))
+    }
+
+    private func duration(_ seconds: TimeInterval) throws {
+        guard seconds.isFinite, seconds >= 0,
+              seconds < Double(UInt64.max) / 1_000_000_000 else { throw ConstructionError.invalidDuration }
+    }
+
+    private func checked(_ event: FBSimulatorHIDEvent) throws -> FBSimulatorHIDEvent {
+        _ = try FBSimulatorHIDSession.preflight(event, observation: observation)
+        return event
+    }
+}
diff --git a/FBSimulatorControl/HID/FBSimulatorHIDLiveFreshness.swift b/FBSimulatorControl/HID/FBSimulatorHIDLiveFreshness.swift
new file mode 100644
index 0000000000000000000000000000000000000000..dd2c4a8cdfbc8ebfcf02d8c5cf1dd2d4011c03ae
--- /dev/null
+++ b/FBSimulatorControl/HID/FBSimulatorHIDLiveFreshness.swift
@@ -0,0 +1,278 @@
+@preconcurrency import CoreSimulator
+import Foundation
+
+/// A session owns this provider until close. The cheap check must use a verified live feed;
+/// returning an unchanged cached observation is not an implementation of this contract.
+public protocol FBSimulatorHIDLiveFreshnessProvider: FBSimulatorHIDFreshnessProvider {
+  func validateCurrentRevision(expected: FBSimulatorHIDSessionObservation) throws
+  func close()
+}
+
+public struct FBSimulatorHIDFeedStatus: Sendable {
+  public let generation: UInt64
+  public let motionSampleCount: UInt64
+  public let displayCallbackCount: UInt64
+  public let displayRefreshCount: UInt64
+  public let motionAgeSeconds: Double?
+  public let displayAgeSeconds: Double?
+  public let failure: String?
+}
+
+/// Owns real native subscriptions and background fresh reads. No external process runs on the
+/// per-primitive check. Full guest/boot observations remain mandatory at start and after drain.
+public final class FBSimulatorHIDNativeFreshnessProvider: FBSimulatorHIDLiveFreshnessProvider, FBSimulatorHIDCleanupIdentityProvider, Sendable {
+  public let initialObservation: FBSimulatorHIDSessionObservation
+  private let authoritative: any FBSimulatorHIDFreshnessProvider
+  private let state: FBSimulatorHIDFeedState
+  private let generation: UInt64
+  private let displayFeed: FBSimulatorHIDDisplayFeed
+  private let renewal: Task<Void, Never>
+
+  private init(observation: FBSimulatorHIDSessionObservation,
+               authoritative: any FBSimulatorHIDFreshnessProvider,
+               state: FBSimulatorHIDFeedState, generation: UInt64,
+               displayFeed: FBSimulatorHIDDisplayFeed, renewal: Task<Void, Never>) {
+    self.initialObservation = observation
+    self.authoritative = authoritative
+    self.state = state
+    self.generation = generation
+    self.displayFeed = displayFeed
+    self.renewal = renewal
+  }
+
+  /// Preferred entry point: native full context reads plus the native change feed.
+  public static func start(for simulator: FBSimulator, helperURL: URL, screenID: UInt32,
+                           screenUniqueID: UUID, maximumFeedAge: TimeInterval = 0.5) async throws -> FBSimulatorHIDNativeFreshnessProvider {
+    let reader = FBSimulatorNativeContextReader(simulator: simulator, helperURL: helperURL,
+      screenID: screenID, screenUniqueID: screenUniqueID)
+    return try await start(for: simulator, authoritativeProvider: reader, maximumFeedAge: maximumFeedAge)
+  }
+
+  public static func start(for simulator: FBSimulator,
+                           authoritativeProvider: any FBSimulatorHIDFreshnessProvider,
+                           maximumFeedAge: TimeInterval = 0.5) async throws -> FBSimulatorHIDNativeFreshnessProvider {
+    guard maximumFeedAge.isFinite, maximumFeedAge >= 0.1, maximumFeedAge <= 3 else {
+      throw FBSimulatorHIDSessionError.invalidObservation("Feed maximum age must be in [0.1, 3] seconds")
+    }
+    let capability = try FBSimulatorNativeContextReader.capability(for: simulator)
+    let requiresMotion = try capability.hinge.requiresMotionFeed()
+    let state = FBSimulatorHIDFeedState(maximumAge: maximumFeedAge, requiresMotion: requiresMotion)
+    let displays = try await FBSimulatorHIDDisplayFeed.start(for: simulator, state: state)
+    var firstMotion: FBSimulatorHIDMotionSubscription?
+    var renewal: Task<Void, Never>?
+    do {
+      if requiresMotion {
+        let motion = try FBSimulatorHIDMotionSubscription(simulator: simulator, state: state)
+        firstMotion = motion
+        try await motion.waitForFreshSample()
+      }
+      state.observeDisplays(try await FBSimulatorDisplayDiscovery.displays(for: simulator))
+      let motion = firstMotion
+      let task = Task { await renew(simulator: simulator, first: motion, state: state,
+                                   interval: min(0.1, maximumFeedAge / 4)) }
+      renewal = task
+      let checkpoint = try state.checkpoint()
+      let observation = try await authoritativeProvider.observation()
+      try Task.checkCancellation()
+      try state.validate(generation: checkpoint)
+      guard observation.simulatorUDID == simulator.udid,
+            capability.integratedDigitizerIDs.contains(observation.screenID) else {
+        throw FBSimulatorHIDSessionError.invalidObservation("Authoritative simulator or selected screen identity does not match the verified profile")
+      }
+      return FBSimulatorHIDNativeFreshnessProvider(observation: observation, authoritative: authoritativeProvider,
+        state: state, generation: checkpoint, displayFeed: displays, renewal: task)
+    } catch {
+      renewal?.cancel(); firstMotion?.close(); displays.close(); state.close()
+      await renewal?.value
+      throw error
+    }
+  }
+
+  public func validateCurrentRevision(expected: FBSimulatorHIDSessionObservation) throws {
+    guard expected == initialObservation else {
+      throw FBSimulatorHIDSessionError.interrupted(reason: .staleContext, cleanup: .notNeeded)
+    }
+    try state.validate(generation: generation)
+  }
+
+  public func observation() async throws -> FBSimulatorHIDSessionObservation {
+    try state.validate(generation: generation)
+    let current = try await authoritative.observation()
+    try state.validate(generation: generation)
+    return current
+  }
+
+  public func cleanupIdentity() async throws -> FBSimulatorHIDCleanupIdentity {
+    guard let reader = authoritative as? any FBSimulatorHIDCleanupIdentityProvider else {
+      throw FBSimulatorHIDSessionError.invalidObservation("Authoritative provider has no cleanup identity reader")
+    }
+    // A changed generation invalidates normal input. It must not replace the original target or
+    // prevent this separate read-only identity check for release on the original connection.
+    return try await reader.cleanupIdentity()
+  }
+
+  public func status() -> FBSimulatorHIDFeedStatus { state.status() }
+
+  public func close() {
+    state.close()
+    renewal.cancel()
+    displayFeed.close()
+  }
+  /// Await the owned renewal task after cancelling subscriptions. Existing close remains nonblocking.
+  public func closeAndWait() async {
+    close()
+    await renewal.value
+  }
+  deinit { close() }
+
+  private static func renew(simulator: FBSimulator, first: FBSimulatorHIDMotionSubscription?,
+                            state: FBSimulatorHIDFeedState, interval: TimeInterval) async {
+    var current = first
+    defer { current?.close() }
+    do {
+      while true {
+        try await Task.sleep(nanoseconds: UInt64(interval * 1_000_000_000))
+        // The old channel still observes changes while the new channel starts.
+        let next = try current.map { _ in try FBSimulatorHIDMotionSubscription(simulator: simulator, state: state) }
+        do {
+          try await next?.waitForFreshSample()
+          try Task.checkCancellation()
+          let displays = try await FBSimulatorDisplayDiscovery.displays(for: simulator)
+          try Task.checkCancellation()
+          state.observeDisplays(displays)
+        } catch { next?.close(); throw error }
+        current?.close()
+        current = next
+      }
+    } catch is CancellationError {
+      state.close()
+    } catch {
+      state.fail("Feed renewal: \(error)")
+    }
+  }
+}
+
+// Runtime seed advances during stable enumeration without a context change.
+// Keep it in discovery/observer diagnostics, not in this semantic comparison.
+private struct FBSimulatorHIDFeedDisplay: Equatable {
+  let identity: String?
+  let size: CGSize
+  let scale: Double
+  let kind: UInt64
+  let orientation: UInt32
+  let power: Int32
+  let backlight: Int32?
+  init(_ value: FBSimulatorDisplayInfo) {
+    identity = value.uniqueID; size = value.nativePixelSize; scale = value.scale
+    kind = value.rawScreenType; orientation = value.rawUIOrientation
+    power = value.rawPowerState; backlight = value.rawBacklightState
+  }
+}
+
+/// Callback bridge with one lock for every mutable field. Change generations are local
+/// observations, not an Apple atomic state/send revision or a guarantee of callback ordering.
+final class FBSimulatorHIDFeedState: @unchecked Sendable {
+  private let lock = NSLock()
+  private let maximumAge: TimeInterval
+  private let requiresMotion: Bool
+  private var generation: UInt64 = 0
+  private var lastMotion: FBSimulatorHingeObservation?
+  private var displays: [UInt32: FBSimulatorHIDFeedDisplay] = [:]
+  private var hasDisplaySnapshot = false
+  private var displayReceived: TimeInterval?
+  private var motionSamples: UInt64 = 0
+  private var displayCallbacks: UInt64 = 0
+  private var displayRefreshes: UInt64 = 0
+  private var failure: String?
+
+  init(maximumAge: TimeInterval, requiresMotion: Bool = true) {
+    self.maximumAge = maximumAge
+    self.requiresMotion = requiresMotion
+  }
+
+  func observeMotion(_ value: FBSimulatorHingeObservation) {
+    lock.lock(); defer { lock.unlock() }
+    guard failure == nil else { return }
+    motionSamples += 1
+    if let last = lastMotion,
+       last.mechanicalDegrees != value.mechanicalDegrees || last.minimumDegrees != value.minimumDegrees || last.maximumDegrees != value.maximumDegrees {
+      generation += 1
+    }
+    // An older callback can still prove a transient change. It cannot refresh the clock.
+    if lastMotion == nil || value.timestampUptime > lastMotion!.timestampUptime { lastMotion = value }
+  }
+
+  func observeDisplayCallback(_ value: FBSimulatorDisplayInfo) {
+    lock.lock(); defer { lock.unlock() }
+    guard failure == nil else { return }
+    displayCallbacks += 1
+    let fingerprint = FBSimulatorHIDFeedDisplay(value)
+    if let previous = displays[value.screenID], previous != fingerprint { generation += 1 }
+    else if hasDisplaySnapshot && displays[value.screenID] == nil { generation += 1 }
+    displays[value.screenID] = fingerprint
+  }
+
+  func observeDisplays(_ values: [FBSimulatorDisplayInfo]) {
+    lock.lock(); defer { lock.unlock() }
+    guard failure == nil else { return }
+    let next = Dictionary(uniqueKeysWithValues: values.map { ($0.screenID, FBSimulatorHIDFeedDisplay($0)) })
+    if hasDisplaySnapshot && displays != next { generation += 1 }
+    displays = next
+    hasDisplaySnapshot = true
+    displayReceived = ProcessInfo.processInfo.systemUptime
+    displayRefreshes += 1
+  }
+
+  func fail(_ message: String) {
+    lock.lock(); defer { lock.unlock() }
+    if failure == nil { failure = message }
+  }
+  func close() { fail("Feed closed") }
+
+  func checkpoint() throws -> UInt64 {
+    lock.lock(); defer { lock.unlock() }
+    try requireFresh()
+    return generation
+  }
+
+  func validate(generation expected: UInt64) throws {
+    lock.lock(); defer { lock.unlock() }
+    try requireFresh()
+    guard generation == expected else {
+      throw FBSimulatorHIDSessionError.interrupted(reason: .staleContext, cleanup: .notNeeded)
+    }
+  }
+
+  private func requireFresh() throws {
+    if let failure {
+      throw FBSimulatorHIDSessionError.interrupted(reason: .observationUnavailable(failure), cleanup: .notNeeded)
+    }
+    let now = ProcessInfo.processInfo.systemUptime
+    let motionIsFresh = !requiresMotion || lastMotion.map { now - $0.timestampUptime <= maximumAge } == true
+    guard motionIsFresh, let displayReceived, now - displayReceived <= maximumAge else {
+      throw FBSimulatorHIDSessionError.interrupted(reason: .observationUnavailable("Native observation feed is stale or not initialized"), cleanup: .notNeeded)
+    }
+  }
+
+  func status() -> FBSimulatorHIDFeedStatus {
+    lock.lock(); defer { lock.unlock() }
+    let now = ProcessInfo.processInfo.systemUptime
+    return FBSimulatorHIDFeedStatus(generation: generation, motionSampleCount: motionSamples,
+      displayCallbackCount: displayCallbacks, displayRefreshCount: displayRefreshes,
+      motionAgeSeconds: lastMotion.map { now - $0.timestampUptime },
+      displayAgeSeconds: displayReceived.map { now - $0 }, failure: failure)
+  }
+}
+
+// Only the verified device profile can select a display-only feed. Failed motion reads never
+// change this policy. Unknown profiles must obtain a verified contract before any input.
+extension FBSimulatorHingeCapability {
+  func requiresMotionFeed() throws -> Bool {
+    switch self {
+    case .supported: return true
+    case .unsupported: return false
+    case .unverified:
+      throw FBSimulatorHIDSessionError.invalidObservation("Device profile has no verified hinge capability")
+    }
+  }
+}
diff --git a/FBSimulatorControl/HID/FBSimulatorHIDMotionFeed.swift b/FBSimulatorControl/HID/FBSimulatorHIDMotionFeed.swift
new file mode 100644
index 0000000000000000000000000000000000000000..23d50d48a67976ce4442207b6430109c492d25ed
--- /dev/null
+++ b/FBSimulatorControl/HID/FBSimulatorHIDMotionFeed.swift
@@ -0,0 +1,216 @@
+@preconcurrency import CoreSimulator
+import Darwin
+import Foundation
+@preconcurrency import XPC
+
+public struct FBSimulatorHingeObservation: Sendable, Codable {
+  public let channelID: String
+  public let timestampUptime: Double
+  public let receivedUptime: Double
+  public let mechanicalDegrees: Double
+  public let sensedDegrees: Double
+  public let velocityDegreesPerSecond: Double
+  public let minimumDegrees: Double
+  public let maximumDegrees: Double
+}
+
+/// Each renewal opens a new channel before the old one closes. The service sends no stable
+/// heartbeat, so a quiet old channel alone is never used as proof of current state.
+final class FBSimulatorHIDMotionSubscription: @unchecked Sendable {
+  private let connection: xpc_connection_t
+  private let closed = FBSimulatorHIDFeedClosure()
+  private let first = FBSimulatorBoundedResult<FBSimulatorHingeObservation>()
+
+  init(simulator: FBSimulator, state: FBSimulatorHIDFeedState) throws {
+    let channel = UUID()
+    let request = try FBSimulatorHIDHingeWire.request(deviceID: simulator.udid, channel: channel)
+    connection = try FBSimulatorHIDHingeWire.connect(simulator)
+    let connection = self.connection
+    let closed = self.closed
+    let first = self.first
+    let started = ProcessInfo.processInfo.systemUptime
+    let queue = DispatchQueue(label: "com.facebook.FBSimulatorControl.hid-motion-feed")
+    xpc_connection_set_target_queue(connection, queue)
+    xpc_connection_set_event_handler(connection) { event in
+      guard !closed.isClosed else { return }
+      do {
+        let samples = try FBSimulatorHIDHingeWire.samples(event, channel: channel, notBefore: started)
+        for sample in samples {
+          state.observeMotion(sample)
+          first.finish(.success(sample))
+        }
+        if xpc_get_type(event) == XPC_TYPE_DICTIONARY, let reply = xpc_dictionary_create_reply(event) {
+          xpc_dictionary_set_bool(reply, "CoreDevice.XPCMessageKey.cancellationRequested", closed.isClosed)
+          xpc_connection_send_message(connection, reply)
+        }
+      } catch {
+        if !closed.isClosed { state.fail("Motion subscription: \(error)"); first.finish(.failure(error)) }
+      }
+    }
+    xpc_connection_resume(connection)
+    xpc_connection_send_message_with_reply(connection, request, queue) { reply in
+      guard !closed.isClosed else { return }
+      if xpc_get_type(reply) != XPC_TYPE_DICTIONARY || xpc_dictionary_get_value(reply, "CoreDevice.error") != nil {
+        let error = FBSimulatorHIDHingeWire.failure("Motion service rejected or closed the request")
+        state.fail("Motion subscription rejected"); first.finish(.failure(error))
+      }
+    }
+  }
+
+  func waitForFreshSample() async throws {
+    _ = try await first.value(timeout: 3, operation: "Fresh motion subscription") { _ in }
+  }
+
+  func close() {
+    guard closed.close() else { return }
+    xpc_connection_cancel(connection)
+    first.finish(.failure(CancellationError()))
+  }
+  deinit { close() }
+}
+
+/// The lock is only the bridge between XPC callbacks and explicit resource close.
+private final class FBSimulatorHIDFeedClosure: @unchecked Sendable {
+  private let lock = NSLock()
+  private var value = false
+  var isClosed: Bool { lock.lock(); defer { lock.unlock() }; return value }
+  func close() -> Bool {
+    lock.lock(); defer { lock.unlock() }
+    guard !value else { return false }; value = true; return true
+  }
+}
+
+enum FBSimulatorHIDHingeWire {
+  static func failure(_ message: String) -> NSError { FBSimulatorError.describe(message).build() }
+
+  static func connect(_ simulator: FBSimulator) throws -> xpc_connection_t {
+    typealias Endpoint = @convention(c) (mach_port_t, UInt64, UInt64) -> xpc_object_t?
+    typealias Connect = @convention(c) (xpc_object_t) -> xpc_connection_t?
+    typealias Enable = @convention(c) (xpc_connection_t) -> Void
+    guard let handle = dlopen(nil, RTLD_NOW),
+          let endpointSymbol = dlsym(handle, "xpc_endpoint_create_mach_port_4sim"),
+          let connectSymbol = dlsym(handle, "xpc_connection_create_from_endpoint"),
+          let enableSymbol = dlsym(handle, "xpc_connection_enable_sim2host_4sim") else {
+      throw failure("Simulator XPC functions unavailable")
+    }
+    var error: NSError?
+    let port = simulator.device.lookup("com.apple.coredevice.feature.monitormotion", error: &error)
+    guard port != 0,
+          let endpoint = unsafeBitCast(endpointSymbol, to: Endpoint.self)(port, 0, 0),
+          let connection = unsafeBitCast(connectSymbol, to: Connect.self)(endpoint) else {
+      throw error ?? failure("Motion service unavailable")
+    }
+    unsafeBitCast(enableSymbol, to: Enable.self)(connection)
+    return connection
+  }
+
+  static func request(deviceID: String, channel: UUID) throws -> xpc_object_t {
+    guard let version = Bundle(path: "/Library/Developer/PrivateFrameworks/CoreDevice.framework")?
+      .object(forInfoDictionaryKey: "CFBundleVersion") as? String else {
+      throw failure("CoreDevice version metadata unavailable")
+    }
+    var bytes = channel.uuid
+    let sideChannel = withUnsafePointer(to: &bytes) { pointer in
+      pointer.withMemoryRebound(to: UInt8.self, capacity: 16) { xpc_uuid_create($0) }
+    }
+    let unit = dictionary(["symbol": string("°"),
+      "converter": dictionary(["coefficient": xpc_double_create(1), "constant": xpc_double_create(0)])])
+    let interval = xpc_array_create(nil, 0)
+    xpc_array_append_value(interval, xpc_int64_create(0))
+    xpc_array_append_value(interval, xpc_uint64_create(100_000_000_000_000_000))
+    let input = dictionary([
+      "actualInput": dictionary([
+        "changeThreshold": dictionary(["value": xpc_double_create(0.1), "unit": unit]),
+        "updateInterval": interval]),
+      "streamProxy": dictionary(["sideChannel": sideChannel])])
+    let components = xpc_array_create(nil, 0)
+    let parts = version.split(separator: ".", omittingEmptySubsequences: false)
+    guard !parts.isEmpty else { throw failure("CoreDevice version is empty") }
+    for part in parts {
+      guard let value = UInt64(part) else { throw failure("CoreDevice version is not numeric") }
+      xpc_array_append_value(components, xpc_uint64_create(value))
+    }
+    return dictionary([
+      "CoreDevice.actionIdentifier": string("com.apple.coredevice.action.streamhingeangle"),
+      "CoreDevice.deviceIdentifier": string(deviceID),
+      "CoreDevice.invocationIdentifier": string(UUID().uuidString),
+      "CoreDevice.CoreDeviceDDIProtocolVersion": xpc_int64_create(1),
+      "CoreDevice.coreDeviceVersion": dictionary(["components": components,
+        "originalComponentsCount": xpc_int64_create(Int64(parts.count)), "stringValue": string(version)]),
+      "CoreDevice.input": input])
+  }
+
+  static func samples(_ event: xpc_object_t, channel: UUID, notBefore: Double) throws -> [FBSimulatorHingeObservation] {
+    guard xpc_get_type(event) == XPC_TYPE_DICTIONARY,
+          let channelText = xpc_dictionary_get_string(event, "XPCSideChannel.uniqueIdentifier"),
+          String(cString: channelText) == channel.uuidString else {
+      throw failure("Motion event has a missing or unexpected channel")
+    }
+    let status = try child(event, "CoreDevice.XPCMessageKey.sideChannelStatus", XPC_TYPE_DICTIONARY)
+    let pushing = try child(status, "pushing", XPC_TYPE_DICTIONARY)
+    let elements = try child(pushing, "elements", XPC_TYPE_ARRAY)
+    let count = xpc_array_get_count(elements)
+    guard count <= 64 else { throw failure("Motion sample batch is too large") }
+    var accepted: [FBSimulatorHingeObservation] = []
+    for index in 0..<count {
+      let item = xpc_array_get_value(elements, index)
+      guard xpc_get_type(item) == XPC_TYPE_DICTIONARY else {
+        throw failure("Motion sample is not a dictionary")
+      }
+      let valid = try child(item, "isAngleValid", XPC_TYPE_BOOL)
+      let velocityValid = try child(item, "isVelocityValid", XPC_TYPE_BOOL)
+      guard xpc_bool_get_value(valid), xpc_bool_get_value(velocityValid) else {
+        throw failure("Motion sample reports invalid angle or velocity")
+      }
+      let timestamp = try number(item, "timestamp")
+      let received = ProcessInfo.processInfo.systemUptime
+      guard timestamp <= received else { throw failure("Motion sample timestamp is in the future") }
+      guard timestamp >= notBefore else { continue }
+      let minimum = try quantity(item, "minAngle", unit: "°")
+      let maximum = try quantity(item, "maxAngle", unit: "°")
+      let mechanical = try quantity(item, "mechanicalAngle", unit: "°")
+      let sensed = try quantity(item, "angle", unit: "°")
+      let velocity = try quantity(item, "velocity", unit: "°/s")
+      guard minimum <= maximum, (minimum...maximum).contains(mechanical), (minimum...maximum).contains(sensed) else {
+        throw failure("Hinge sample is outside its reported range")
+      }
+      let observation = FBSimulatorHingeObservation(channelID: channel.uuidString,
+        timestampUptime: timestamp, receivedUptime: received, mechanicalDegrees: mechanical,
+        sensedDegrees: sensed, velocityDegreesPerSecond: velocity,
+        minimumDegrees: minimum, maximumDegrees: maximum)
+      accepted.append(observation)
+    }
+    return accepted
+  }
+
+  static func quantity(_ object: xpc_object_t, _ key: String, unit expected: String) throws -> Double {
+    let quantity = try child(object, key, XPC_TYPE_DICTIONARY)
+    let unit = try child(quantity, "unit", XPC_TYPE_DICTIONARY)
+    let converter = try child(unit, "converter", XPC_TYPE_DICTIONARY)
+    guard let symbol = xpc_dictionary_get_string(unit, "symbol"), String(cString: symbol) == expected,
+          try number(converter, "coefficient") == 1, try number(converter, "constant") == 0 else {
+      throw failure("Hinge quantity has unsupported units")
+    }
+    return try number(quantity, "value")
+  }
+
+  static func number(_ object: xpc_object_t, _ key: String) throws -> Double {
+    let value = xpc_double_get_value(try child(object, key, XPC_TYPE_DOUBLE))
+    guard value.isFinite else { throw failure("Hinge number is not finite") }
+    return value
+  }
+
+  static func child(_ object: xpc_object_t, _ key: String, _ type: xpc_type_t) throws -> xpc_object_t {
+    guard let value = xpc_dictionary_get_value(object, key), xpc_get_type(value) == type else {
+      throw failure("Missing or invalid motion field: \(key)")
+    }
+    return value
+  }
+
+  static func dictionary(_ fields: [String: xpc_object_t]) -> xpc_object_t {
+    let result = xpc_dictionary_create(nil, nil, 0)
+    for (key, value) in fields { xpc_dictionary_set_value(result, key, value) }
+    return result
+  }
+  static func string(_ value: String) -> xpc_object_t { xpc_string_create(value) }
+}
diff --git a/FBSimulatorControl/HID/FBSimulatorHIDSession.swift b/FBSimulatorControl/HID/FBSimulatorHIDSession.swift
new file mode 100644
index 0000000000000000000000000000000000000000..eea21382226aa6672291725cafb052fb3ae4c931
--- /dev/null
+++ b/FBSimulatorControl/HID/FBSimulatorHIDSession.swift
@@ -0,0 +1,717 @@
+import CoreGraphics
+import Foundation
+
+/// Owns one fixed display context and one DTUHID connection. A new session and lookup are required
+/// after invalidation. No raw connection or active contact can migrate to another revision.
+public actor FBSimulatorHIDSession {
+  private enum Contacts: Sendable {
+    case single(CGPoint)
+    case pair(CGPoint, CGPoint)
+  }
+
+  private let transport: any FBSimulatorHIDTransport
+  private let observation: FBSimulatorHIDSessionObservation
+  private let freshnessProvider: any FBSimulatorHIDFreshnessProvider
+  private let liveProvider: (any FBSimulatorHIDLiveFreshnessProvider)?
+  private let sessionID = UUID()
+  private var state: FBSimulatorHIDSessionState = .ready
+  private var inFlight = false
+  private var contacts: Contacts?
+  private var token: FBSimulatorHIDContactToken?
+  private var retainedMonitor: Task<Void, Never>?
+  private var retainedMonitorID: UUID?
+  private var idleCleanupInProgress = false
+  private var idleCleanupWaiters: [CheckedContinuation<Void, Never>] = []
+  private var heldKeys = Set<UInt32>()
+  private var heldButtons = Set<FBSimulatorHIDButton>()
+  private var sentCount = 0
+  private var lastCleanup: FBSimulatorHIDCleanupOutcome = .notNeeded
+  private var lastCleanupEvidence: FBSimulatorHIDCleanupEvidence?
+  private var lastExecutionEvidence: FBSimulatorHIDExecutionEvidence?
+
+  public func cleanupEvidence() -> FBSimulatorHIDCleanupEvidence? { lastCleanupEvidence }
+  public func executionEvidence() -> FBSimulatorHIDExecutionEvidence? { lastExecutionEvidence }
+
+  public static func open(for simulator: FBSimulator,
+                          observation: FBSimulatorHIDSessionObservation,
+                          freshnessProvider: any FBSimulatorHIDFreshnessProvider) async throws -> FBSimulatorHIDSession {
+    try await openSession(for: simulator, observation: observation, freshnessProvider: freshnessProvider, liveProvider: nil)
+  }
+
+  /// Takes ownership of the live provider, including when opening fails.
+  public static func open(for simulator: FBSimulator,
+                          observation: FBSimulatorHIDSessionObservation,
+                          liveFreshnessProvider: any FBSimulatorHIDLiveFreshnessProvider) async throws -> FBSimulatorHIDSession {
+    do {
+      return try await openSession(for: simulator, observation: observation,
+        freshnessProvider: liveFreshnessProvider, liveProvider: liveFreshnessProvider)
+    } catch { liveFreshnessProvider.close(); throw error }
+  }
+
+  /// Explicit opt-in hint for one fixed selected display. The hint is geometric;
+  /// successful input delivery does not prove a system navigation effect.
+  /// Takes ownership of the live provider, including when opening fails.
+  public static func open(for simulator: FBSimulator,
+                          observation: FBSimulatorHIDSessionObservation,
+                          logicalEdge: FBSimulatorHIDLogicalEdge,
+                          liveFreshnessProvider: any FBSimulatorHIDLiveFreshnessProvider) async throws -> FBSimulatorHIDSession {
+    do {
+      return try await openSession(for: simulator, observation: observation,
+        freshnessProvider: liveFreshnessProvider, liveProvider: liveFreshnessProvider,
+        nativeEdge: logicalEdge.nativeEdge(for: observation.displayContext.rotation))
+    } catch { liveFreshnessProvider.close(); throw error }
+  }
+
+  private static func openSession(for simulator: FBSimulator,
+                                  observation: FBSimulatorHIDSessionObservation,
+                                  freshnessProvider: any FBSimulatorHIDFreshnessProvider,
+                                  liveProvider: (any FBSimulatorHIDLiveFreshnessProvider)?,
+                                  nativeEdge: FBSimulatorHIDNativeEdge = .none) async throws -> FBSimulatorHIDSession {
+    guard simulator.udid == observation.simulatorUDID else {
+      throw FBSimulatorHIDSessionError.invalidObservation("Simulator identity does not match")
+    }
+    let display: FBSimulatorDisplayInfo
+    do { display = try await FBSimulatorDisplayDiscovery.display(for: simulator, screenID: observation.screenID) }
+    catch is CancellationError { throw CancellationError() }
+    catch { throw FBSimulatorHIDSessionError.invalidObservation("Runtime display lookup failed: \(error)") }
+    guard display.uniqueID == observation.screenUniqueID,
+          display.nativePixelSize == observation.displayContext.nativePixelSize,
+          display.scale == observation.displayContext.scale,
+          UInt64(display.screenID) == observation.displayContext.hidTarget else {
+      throw FBSimulatorHIDSessionError.invalidObservation("Selected runtime display does not match the measured context")
+    }
+    guard try await freshnessProvider.observation() == observation else {
+      throw FBSimulatorHIDSessionError.invalidObservation("Context changed before opening the connection")
+    }
+    try Task.checkCancellation()
+    let transport = try FBSimulatorDTUHIDTransport.dtuhid(for: simulator, displayContext: observation.displayContext, nativeEdge: nativeEdge)
+    do {
+      try await transport.prepareSelectedConnection()
+      try Task.checkCancellation()
+      return FBSimulatorHIDSession(transport: transport, observation: observation, freshnessProvider: freshnessProvider, liveProvider: liveProvider)
+    } catch {
+      transport.disconnect()
+      throw error
+    }
+  }
+
+  // Internal dependency boundary also permits local transport checks without simulator input.
+  init(transport: any FBSimulatorHIDTransport, observation: FBSimulatorHIDSessionObservation,
+       freshnessProvider: any FBSimulatorHIDFreshnessProvider,
+       liveProvider: (any FBSimulatorHIDLiveFreshnessProvider)? = nil) {
+    self.transport = transport
+    self.observation = observation
+    self.freshnessProvider = freshnessProvider
+    self.liveProvider = liveProvider
+  }
+
+  deinit { retainedMonitor?.cancel() }
+
+  public func status() -> FBSimulatorHIDSessionStatus {
+    FBSimulatorHIDSessionStatus(state: state, hasRetainedContact: contacts != nil,
+      enqueuedEventCount: sentCount, lastCleanup: lastCleanup)
+  }
+
+  /// Pure full-composite validation. Execution repeats this check before sending.
+  public static func preflight(_ event: FBSimulatorHIDEvent,
+                               observation: FBSimulatorHIDSessionObservation) throws -> FBSimulatorHIDPreflight {
+    let events = try prepare(event, context: observation.displayContext)
+    return FBSimulatorHIDPreflight(primitiveCount: events.filter { if case .delay = $0 { return false }; return true }.count,
+      requestedDelaySeconds: events.reduce(0) { total, item in
+        if case let .delay(seconds) = item { return total + seconds }; return total
+      })
+  }
+
+  public func execute(_ event: FBSimulatorHIDEvent) async throws -> FBSimulatorHIDSessionReceipt {
+    try await executePrepared(event, admissionGuard: nil)
+  }
+
+  /// Guarded input requires a live feed so the final revision check does not await a full read.
+  public func execute(_ event: FBSimulatorHIDEvent,
+                      admissionGuard: any FBSimulatorHIDInputAdmissionGuard) async throws -> FBSimulatorHIDSessionReceipt {
+    try await executePrepared(event, admissionGuard: admissionGuard)
+  }
+
+  /// Complete keyboard input with a fresh admission check before each key down.
+  /// Existing first-event touch admission and unguarded execute overloads are unchanged.
+  public func execute(_ event: FBSimulatorHIDEvent,
+                      keyboardAdmissionGuard: any FBSimulatorHIDKeyboardAdmissionGuard) async throws -> FBSimulatorHIDSessionReceipt {
+    try await executePrepared(event, admissionGuard: nil, keyboardAdmissionGuard: keyboardAdmissionGuard)
+  }
+
+  private func executePrepared(_ event: FBSimulatorHIDEvent,
+                               admissionGuard: (any FBSimulatorHIDInputAdmissionGuard)?,
+                               keyboardAdmissionGuard: (any FBSimulatorHIDKeyboardAdmissionGuard)? = nil) async throws -> FBSimulatorHIDSessionReceipt {
+    try enter()
+    defer { inFlight = false }
+    lastExecutionEvidence = nil
+    guard contacts == nil else { throw FBSimulatorHIDSessionError.retainedContactExists }
+    let events = try Self.prepare(event, context: observation.displayContext)
+    if admissionGuard != nil || keyboardAdmissionGuard != nil, liveProvider == nil {
+      throw FBSimulatorHIDSessionError.invalidEvent("Guarded input requires a live freshness provider")
+    }
+    if admissionGuard != nil, !events.contains(where: { if case .delay = $0 { return false }; return true }) {
+      throw FBSimulatorHIDSessionError.invalidEvent("Guarded input requires an input primitive")
+    }
+    if keyboardAdmissionGuard != nil {
+      guard events.allSatisfy({ item in
+        switch item { case .keyboard, .delay: return true; default: return false }
+      }), events.contains(where: { if case .keyboard(.down, _) = $0 { return true }; return false }) else {
+        throw FBSimulatorHIDSessionError.invalidEvent("Keyboard admission requires only keyboard events and delays, with at least one key down")
+      }
+    }
+    var pendingGuard = admissionGuard
+    let started = ProcessInfo.processInfo.systemUptime
+    let before = sentCount
+    let operationID = UUID()
+    let planned = events.filter { if case .delay = $0 { return false }; return true }.count
+    var phase = FBSimulatorHIDExecutionPhase.beforeInput
+    var drainCompleted = false
+    state = .executing
+    do {
+      try await checkFreshness(authoritative: true)
+      for item in events {
+        try Task.checkCancellation()
+        if case let .delay(seconds) = item {
+          phase = .delay
+          try await waitWithFreshness(seconds)
+        } else {
+          if let guardToRun = pendingGuard {
+            phase = .admission
+            do { try await guardToRun.validate(observation: observation, firstEvent: item) }
+            catch is CancellationError { throw CancellationError() }
+            catch where Task.isCancelled { throw CancellationError() }
+            catch {
+              throw FBSimulatorHIDSessionError.interrupted(
+                reason: .inputAdmissionRejected(String(reflecting: error)), cleanup: .notNeeded)
+            }
+            pendingGuard = nil
+            try Task.checkCancellation()
+          }
+          if case let .keyboard(.down, code) = item, let keyboardAdmissionGuard {
+            phase = .admission
+            do { try await keyboardAdmissionGuard.validateKeyDown(observation: observation, keyCode: code) }
+            catch is CancellationError { throw CancellationError() }
+            catch where Task.isCancelled { throw CancellationError() }
+            catch {
+              throw FBSimulatorHIDSessionError.interrupted(
+                reason: .inputAdmissionRejected(String(reflecting: error)), cleanup: .notNeeded)
+            }
+            try Task.checkCancellation()
+          }
+          phase = .primitive
+          try await checkFreshness()
+          try await dispatch(item)
+        }
+      }
+      phase = .drain
+      try await completeDrain()
+      drainCompleted = true
+      phase = .finalContextCheck
+      try await checkFreshness(authoritative: true)
+      state = .ready
+      lastExecutionEvidence = .init(operationID: operationID, boundObservation: observation,
+        phase: .completed, plannedPrimitiveCount: planned, sentPrimitiveCount: sentCount - before,
+        allInputsReleasedBeforeCleanup: contacts == nil && heldKeys.isEmpty && heldButtons.isEmpty,
+        drainCompleted: drainCompleted, interruption: nil, cleanup: .notNeeded,
+        startedUptime: started, finishedUptime: ProcessInfo.processInfo.systemUptime)
+      return receipt(.enqueuedAndDrained, started: started, before: before)
+    } catch {
+      let released = contacts == nil && heldKeys.isEmpty && heldButtons.isEmpty
+      let sent = sentCount - before
+      let failure = await interrupt(error)
+      let reason: FBSimulatorHIDInterruption?
+      if case let .interrupted(value, _) = failure { reason = value } else { reason = nil }
+      lastExecutionEvidence = .init(operationID: operationID, boundObservation: observation,
+        phase: phase, plannedPrimitiveCount: planned, sentPrimitiveCount: sent,
+        allInputsReleasedBeforeCleanup: released, drainCompleted: drainCompleted,
+        interruption: reason, cleanup: lastCleanup,
+        startedUptime: started, finishedUptime: ProcessInfo.processInfo.systemUptime)
+      throw failure
+    }
+  }
+
+  public func begin(at point: CGPoint) async throws -> FBSimulatorHIDSessionReceipt {
+    try await beginContacts(.single(point))
+  }
+
+  public func beginTwoFinger(first: CGPoint, second: CGPoint) async throws -> FBSimulatorHIDSessionReceipt {
+    try await beginContacts(.pair(first, second))
+  }
+
+  public func move(_ token: FBSimulatorHIDContactToken, to point: CGPoint) async throws -> FBSimulatorHIDSessionReceipt {
+    try await moveContacts(token, to: .single(point))
+  }
+
+  public func moveTwoFinger(_ token: FBSimulatorHIDContactToken, first: CGPoint, second: CGPoint) async throws -> FBSimulatorHIDSessionReceipt {
+    try await moveContacts(token, to: .pair(first, second))
+  }
+
+  public func end(_ token: FBSimulatorHIDContactToken) async throws -> FBSimulatorHIDSessionReceipt {
+    try enter()
+    defer { inFlight = false }
+    try requireToken(token)
+    let started = ProcessInfo.processInfo.systemUptime
+    let before = sentCount
+    state = .executing
+    do {
+      try await checkFreshness()
+      if let contacts { try await dispatch(Self.event(contacts, direction: .up)) }
+      self.token = nil
+      stopRetainedMonitor()
+      try await completeDrain()
+      try await checkFreshness(authoritative: true)
+      state = .ready
+      return receipt(.endedAndDrained, started: started, before: before)
+    } catch { throw await interrupt(error) }
+  }
+
+  /// Close joins only owned idle cleanup. Concurrent caller execution still rejects as busy.
+  /// Cancel the owning action task and await it before closing an active caller operation.
+  public func close() async throws -> FBSimulatorHIDSessionReceipt {
+    if idleCleanupInProgress {
+      await withCheckedContinuation { idleCleanupWaiters.append($0) }
+    }
+    guard !inFlight else { throw FBSimulatorHIDSessionError.busy }
+    stopRetainedMonitor()
+    let started = ProcessInfo.processInfo.systemUptime
+    let before = sentCount
+    if state == .closed || state == .invalidated {
+      // Interruption already attempted cleanup and disconnected. Preserve its evidence.
+      state = .closed
+      return receipt(.closed, started: started, before: before, cleanup: lastCleanup)
+    }
+    inFlight = true
+    defer { inFlight = false }
+    let cleanup = await cleanupContacts(uncertain: state == .invalidated, trigger: "close")
+    transport.disconnect()
+    liveProvider?.close()
+    state = .closed
+    return receipt(.closed, started: started, before: before, cleanup: cleanup)
+  }
+
+  private func beginContacts(_ next: Contacts) async throws -> FBSimulatorHIDSessionReceipt {
+    try enter()
+    defer { inFlight = false }
+    guard contacts == nil else { throw FBSimulatorHIDSessionError.retainedContactExists }
+    try validate(next)
+    let started = ProcessInfo.processInfo.systemUptime
+    let before = sentCount
+    state = .executing
+    do {
+      try await checkFreshness(authoritative: true)
+      try await checkFreshness()
+      try await dispatch(Self.event(next, direction: .down))
+      try Task.checkCancellation()
+      token = FBSimulatorHIDContactToken(sessionID: sessionID, contactID: UUID())
+      state = .retainedContacts
+      startRetainedMonitor()
+      return receipt(.retained, started: started, before: before)
+    } catch { throw await interrupt(error) }
+  }
+
+  private func moveContacts(_ candidate: FBSimulatorHIDContactToken, to next: Contacts) async throws -> FBSimulatorHIDSessionReceipt {
+    try enter()
+    defer { inFlight = false }
+    try requireToken(candidate)
+    let started = ProcessInfo.processInfo.systemUptime
+    let before = sentCount
+    state = .executing
+    do {
+      do {
+        try validate(next)
+        switch (contacts, next) {
+        case (.single?, .single), (.pair?, .pair): break
+        default: throw FBSimulatorHIDSessionError.invalidEvent("Cannot change contact count while retained")
+        }
+      } catch {
+        throw FBSimulatorHIDSessionError.interrupted(reason: .invalidRetainedInput(String(describing: error)), cleanup: .notNeeded)
+      }
+      try await checkFreshness()
+      try await dispatch(Self.event(next, direction: .down))
+      try Task.checkCancellation()
+      state = .retainedContacts
+      return receipt(.moved, started: started, before: before)
+    } catch { throw await interrupt(error) }
+  }
+
+  /// Observe only the existing local feed while a retained caller is idle. The task does not
+  /// retain the session across sleeps. Actor admission keeps cleanup separate from caller input.
+  private func startRetainedMonitor() {
+    guard liveProvider != nil, contacts != nil, token != nil, retainedMonitor == nil else { return }
+    let monitorID = UUID()
+    retainedMonitorID = monitorID
+    retainedMonitor = Task { [weak self] in
+      while !Task.isCancelled {
+        do { try await Task.sleep(nanoseconds: 50_000_000) }
+        catch { return }
+        guard !Task.isCancelled,
+              await self?.maintainRetainedInput(monitorID) == true else { return }
+      }
+    }
+  }
+
+  private func stopRetainedMonitor() {
+    retainedMonitorID = nil
+    retainedMonitor?.cancel()
+    retainedMonitor = nil
+  }
+
+  private func maintainRetainedInput(_ monitorID: UUID) async -> Bool {
+    guard retainedMonitorID == monitorID, contacts != nil, token != nil,
+          let liveProvider else { return false }
+    // A caller that owns admission continues to use its normal freshness checks.
+    guard !inFlight else { return true }
+    do {
+      try liveProvider.validateCurrentRevision(expected: observation)
+      return true
+    } catch {
+      inFlight = true
+      idleCleanupInProgress = true
+      _ = await interrupt(error)
+      // Finish bounded cleanup and wake close() before cancelling this monitor's own task.
+      idleCleanupInProgress = false
+      inFlight = false
+      let waiters = idleCleanupWaiters
+      idleCleanupWaiters.removeAll()
+      for waiter in waiters { waiter.resume() }
+      stopRetainedMonitor()
+      return false
+    }
+  }
+
+  private func enter() throws {
+    guard !inFlight else { throw FBSimulatorHIDSessionError.busy }
+    guard state != .closed else { throw FBSimulatorHIDSessionError.closed }
+    guard state != .invalidated else { throw FBSimulatorHIDSessionError.invalidated }
+    inFlight = true
+  }
+
+  private func requireToken(_ candidate: FBSimulatorHIDContactToken) throws {
+    guard token == candidate, candidate.sessionID == sessionID, contacts != nil else {
+      throw FBSimulatorHIDSessionError.invalidToken
+    }
+  }
+
+  private func checkFreshness(authoritative: Bool = false) async throws {
+    try Task.checkCancellation()
+    if !authoritative, let liveProvider {
+      try liveProvider.validateCurrentRevision(expected: observation)
+      return
+    }
+    let current: FBSimulatorHIDSessionObservation
+    do { current = try await freshnessProvider.observation() }
+    catch is CancellationError { throw CancellationError() }
+    catch where Task.isCancelled { throw CancellationError() }
+    catch let error as FBSimulatorHIDSessionError { throw error }
+    catch { throw FBSimulatorHIDSessionError.interrupted(reason: .observationUnavailable(String(describing: error)), cleanup: .notNeeded) }
+    try Task.checkCancellation()
+    guard current == observation else {
+      throw FBSimulatorHIDSessionError.interrupted(reason: .staleContext, cleanup: .notNeeded)
+    }
+  }
+
+  private func completeDrain() async throws {
+    state = .draining
+    // Unstructured task is not cancelled with the caller. Cancellation is checked after keepalive.
+    let transport = self.transport
+    try await Task { try await transport.flush() }.value
+    try Task.checkCancellation()
+  }
+
+  private func waitWithFreshness(_ seconds: TimeInterval) async throws {
+    guard liveProvider != nil else {
+      try await Task.sleep(nanoseconds: UInt64(seconds * 1_000_000_000))
+      return
+    }
+    let deadline = ProcessInfo.processInfo.systemUptime + seconds
+    while true {
+      try await checkFreshness()
+      let remaining = deadline - ProcessInfo.processInfo.systemUptime
+      guard remaining > 0 else { return }
+      // Read the existing local feed. Do not spawn full context reads during a hold.
+      try await Task.sleep(nanoseconds: UInt64(min(remaining, 0.05) * 1_000_000_000))
+    }
+  }
+
+  private func interrupt(_ error: Error) async -> FBSimulatorHIDSessionError {
+    if !idleCleanupInProgress { stopRetainedMonitor() }
+    let reason: FBSimulatorHIDInterruption
+    if error is CancellationError { reason = .cancelled }
+    else if case let FBSimulatorHIDSessionError.interrupted(value, _) = error { reason = value }
+    else { reason = .transportFailure(String(describing: error)) }
+    let changed: Bool
+    switch reason {
+    case .staleContext, .observationUnavailable, .transportFailure: changed = true
+    case .cancelled, .invalidRetainedInput, .inputAdmissionRejected: changed = false
+    }
+    let cleanup = await cleanupContacts(uncertain: changed, trigger: String(describing: reason))
+    // No reuse after interruption: close, then require a fresh observation and connection.
+    transport.disconnect()
+    liveProvider?.close()
+    state = .invalidated
+    return .interrupted(reason: reason, cleanup: cleanup)
+  }
+
+  private func cleanupContacts(uncertain: Bool, trigger: String) async -> FBSimulatorHIDCleanupOutcome {
+    let transport = self.transport
+    var releases: [FBSimulatorHIDEvent] = []
+    if let contacts { releases.append(Self.event(contacts, direction: .up)) }
+    releases += heldKeys.sorted().map { .keyboard(direction: .up, keyCode: $0) }
+    releases += heldButtons.sorted { $0.rawValue < $1.rawValue }.map { .button(direction: .up, button: $0) }
+    let started = ProcessInfo.processInfo.systemUptime
+    var evidence = FBSimulatorHIDCleanupEvidence(boundSimulatorUDID: observation.simulatorUDID,
+      boundBootIdentity: observation.bootIdentity, boundScreenID: observation.screenID,
+      boundScreenUUID: observation.screenUniqueID,
+      boundNativeWidth: observation.displayContext.nativePixelSize.width,
+      boundNativeHeight: observation.displayContext.nativePixelSize.height,
+      boundScale: observation.displayContext.scale,
+      boundRotation: Int(observation.displayContext.rotation.rawValue), boundPoseRevision: observation.poseRevision,
+      startedUptime: started, trigger: trigger,
+      contextValidation: uncertain ? "notRecheckedAfterInterruption" : "pending",
+      releases: [], timedOut: false)
+    guard !releases.isEmpty else {
+      lastCleanup = .notNeeded
+      evidence.contextValidation = "noOwnedInput"
+      evidence.finishedUptime = ProcessInfo.processInfo.systemUptime
+      evidence.outcome = FBSimulatorHIDCleanupOutcome.notNeeded.rawValue
+      lastCleanupEvidence = evidence
+      return .notNeeded
+    }
+    state = .draining
+    let race = FBSimulatorHIDCleanupRace(evidence: evidence)
+    let provider = freshnessProvider
+    let live = liveProvider
+    let expected = observation
+    let identityProvider = provider as? any FBSimulatorHIDCleanupIdentityProvider
+    let cleanupTask = Task {
+      do {
+        var matches = false
+        if let identityProvider {
+          do {
+            let identity = try await Self.readCleanupIdentity(identityProvider)
+            matches = identity.matches(expected)
+            await race.identity(identity, before: true)
+            await race.context(matches ? "releaseIdentityMatchedBefore" : "releaseIdentityMismatchBefore")
+          } catch {
+            await race.identityFailure("before: \(error)")
+            await race.context("releaseIdentityUnavailableBefore")
+          }
+          // A failed or slow identity read cannot suppress release on the original connection.
+        } else if !uncertain {
+          do {
+            if let live { try live.validateCurrentRevision(expected: expected); matches = true }
+            else { matches = try await provider.observation() == expected }
+            await race.context(matches ? "matched" : "different")
+          } catch {
+            matches = false
+            await race.context("unavailable", error: String(describing: error))
+          }
+        }
+        try Task.checkCancellation()
+        for (index, release) in releases.enumerated() {
+          try Task.checkCancellation()
+          await race.startRelease(index: index, primitive: String(describing: release))
+          do {
+            try await Self.send(release, transport: transport)
+            let sendEvidence = await (transport as? any FBSimulatorHIDCleanupTransportDiagnostics)?.lastSendEvidence()
+            await race.finishRelease(index: index, transport: sendEvidence, error: nil)
+          } catch {
+            let sendEvidence = await (transport as? any FBSimulatorHIDCleanupTransportDiagnostics)?.lastSendEvidence()
+            await race.finishRelease(index: index, transport: sendEvidence, error: String(describing: error))
+            throw error
+          }
+        }
+        await race.startDrain()
+        try await transport.flush()
+        await race.finishDrain()
+        if let identityProvider {
+          do {
+            let identity = try await Self.readCleanupIdentity(identityProvider)
+            await race.identity(identity, before: false)
+            matches = matches && identity.matches(expected)
+            await race.context(matches ? "releaseIdentityMatchedBeforeAndAfter" : "releaseIdentityUnconfirmed")
+          } catch {
+            matches = false
+            await race.identityFailure("after: \(error)")
+            await race.context("releaseIdentityUnavailableAfter")
+          }
+        }
+        await race.finish(matches ? .releaseEnqueuedAndDrained : .uncertain)
+      } catch { await race.finish(.uncertain, error: String(describing: error)) }
+    }
+    let timeoutTask = Task {
+      do { try await Task.sleep(nanoseconds: 2_000_000_000) }
+      catch { return }
+      await race.finish(.uncertain, timedOut: true)
+    }
+    let result = await race.wait()
+    timeoutTask.cancel()
+    if result == .uncertain { transport.disconnect(); cleanupTask.cancel() }
+    lastCleanupEvidence = await race.snapshot()
+    contacts = nil
+    token = nil
+    heldKeys.removeAll()
+    heldButtons.removeAll()
+    lastCleanup = result
+    return result
+  }
+
+  /// The 100 ms read budget reserves cleanup time for the owned release. It is not a delay or
+  /// freshness relaxation. Timeout cancels the read and forces uncertain classification.
+  private static func readCleanupIdentity(_ provider: any FBSimulatorHIDCleanupIdentityProvider) async throws -> FBSimulatorHIDCleanupIdentity {
+    let result = FBSimulatorBoundedResult<FBSimulatorHIDCleanupIdentity>()
+    let read = Task {
+      do { result.finish(.success(try await provider.cleanupIdentity())) }
+      catch { result.finish(.failure(error)) }
+    }
+    defer { read.cancel() }
+    return try await result.value(timeout: 0.1, operation: "Cleanup identity read") { _ in }
+  }
+
+  private func dispatch(_ event: FBSimulatorHIDEvent) async throws {
+    // Store possible active state before enqueue so a send error cannot omit cleanup.
+    switch event {
+    case let .touch(.down, x, y): contacts = .single(CGPoint(x: x, y: y))
+    case let .twoFingerTouch(.down, first, second): contacts = .pair(first, second)
+    case let .keyboard(.down, code): heldKeys.insert(code)
+    case let .button(.down, button): heldButtons.insert(button)
+    default: break
+    }
+    try await Self.send(event, transport: transport)
+    sentCount += 1
+    switch event {
+    case .touch(.up, _, _), .twoFingerTouch(.up, _, _): contacts = nil
+    case let .keyboard(.up, code): heldKeys.remove(code)
+    case let .button(.up, button): heldButtons.remove(button)
+    default: break
+    }
+  }
+
+  private static func send(_ event: FBSimulatorHIDEvent, transport: any FBSimulatorHIDTransport) async throws {
+    switch event {
+    case let .touch(direction, x, y): try await transport.sendTouch(direction: direction, x: x, y: y)
+    case let .twoFingerTouch(direction, first, second): try await transport.sendTwoFingerTouch(direction: direction, finger1: first, finger2: second)
+    case let .keyboard(direction, code): try await transport.sendKeyboard(direction: direction, keyCode: code)
+    case let .button(direction, button): try await transport.sendButton(direction: direction, button: button)
+    default: throw FBSimulatorHIDSessionError.invalidEvent("Only prepared input primitives can be sent")
+    }
+  }
+
+  private func validate(_ contacts: Contacts) throws {
+    switch contacts {
+    case let .single(point): try Self.validatePoint(point, context: observation.displayContext)
+    case let .pair(first, second):
+      try Self.validatePoint(first, context: observation.displayContext)
+      try Self.validatePoint(second, context: observation.displayContext)
+    }
+  }
+
+  private static func validatePoint(_ point: CGPoint, context: FBSimulatorHIDDisplayContext) throws {
+    do { _ = try context.normalizedPoint(from: point) }
+    catch { throw FBSimulatorHIDSessionError.invalidEvent(String(describing: error)) }
+  }
+
+  private static func event(_ contacts: Contacts, direction: FBSimulatorHIDDirection) -> FBSimulatorHIDEvent {
+    switch contacts {
+    case let .single(point): return .touch(direction: direction, x: point.x, y: point.y)
+    case let .pair(first, second): return .twoFingerTouch(direction: direction, finger1: first, finger2: second)
+    }
+  }
+
+  private func receipt(_ outcome: FBSimulatorHIDSessionOutcome, started: TimeInterval, before: Int,
+                       cleanup: FBSimulatorHIDCleanupOutcome = .notNeeded) -> FBSimulatorHIDSessionReceipt {
+    FBSimulatorHIDSessionReceipt(outcome: outcome, token: token,
+      enqueuedEventCount: sentCount - before, elapsedSeconds: ProcessInfo.processInfo.systemUptime - started, cleanup: cleanup)
+  }
+
+  private static func prepare(_ event: FBSimulatorHIDEvent, context: FBSimulatorHIDDisplayContext) throws -> [FBSimulatorHIDEvent] {
+    var flattened: [FBSimulatorHIDEvent] = []
+    func flatten(_ item: FBSimulatorHIDEvent) {
+      if case let .composite(items) = item { for child in items { flatten(child) } }
+      else { flattened.append(item) }
+    }
+    flatten(event.event(for: .dtuhid))
+    var contactCount = 0
+    var keys = Set<UInt32>()
+    var buttons = Set<FBSimulatorHIDButton>()
+    for item in flattened {
+      switch item {
+      case let .touch(direction, x, y):
+        try validatePoint(CGPoint(x: x, y: y), context: context)
+        guard contactCount == 0 || contactCount == 1 else { throw FBSimulatorHIDSessionError.invalidEvent("Mixed contact counts") }
+        if direction == .up && contactCount == 0 { throw FBSimulatorHIDSessionError.invalidEvent("Touch release without begin") }
+        contactCount = direction == .down ? 1 : 0
+      case let .twoFingerTouch(direction, first, second):
+        try validatePoint(first, context: context); try validatePoint(second, context: context)
+        guard contactCount == 0 || contactCount == 2 else { throw FBSimulatorHIDSessionError.invalidEvent("Mixed contact counts") }
+        if direction == .up && contactCount == 0 { throw FBSimulatorHIDSessionError.invalidEvent("Touch release without begin") }
+        contactCount = direction == .down ? 2 : 0
+      case let .delay(seconds):
+        guard seconds.isFinite, seconds >= 0, seconds < Double(UInt64.max) / 1_000_000_000 else {
+          throw FBSimulatorHIDSessionError.invalidEvent("Invalid delay")
+        }
+      case let .keyboard(direction, code):
+        if direction == .down { keys.insert(code) }
+        else if keys.remove(code) == nil { throw FBSimulatorHIDSessionError.invalidEvent("Key release without begin") }
+      case let .button(direction, button):
+        guard button != .applePay else { throw FBSimulatorHIDSessionError.invalidEvent("Unadapted Apple Pay event") }
+        if direction == .down { buttons.insert(button) }
+        else if buttons.remove(button) == nil { throw FBSimulatorHIDSessionError.invalidEvent("Button release without begin") }
+      default: throw FBSimulatorHIDSessionError.invalidEvent("Session does not execute pose or system-state events")
+      }
+    }
+    guard contactCount == 0, keys.isEmpty, buttons.isEmpty else {
+      throw FBSimulatorHIDSessionError.invalidEvent("Complete gesture must release all inputs; use retained contact API")
+    }
+    return flattened
+  }
+}
+
+/// One-shot race avoids waiting forever for a failed connection barrier during cleanup.
+/// A timeout closes the original connection and reports uncertain delivery, never release success.
+private actor FBSimulatorHIDCleanupRace {
+  private var result: FBSimulatorHIDCleanupOutcome?
+  private var continuation: CheckedContinuation<FBSimulatorHIDCleanupOutcome, Never>?
+  private var evidence: FBSimulatorHIDCleanupEvidence
+  init(evidence: FBSimulatorHIDCleanupEvidence) { self.evidence = evidence }
+  func context(_ value: String, error: String? = nil) {
+    guard result == nil else { return }
+    evidence.contextValidation = value; evidence.contextValidationError = error
+  }
+  func identity(_ value: FBSimulatorHIDCleanupIdentity, before: Bool) {
+    guard result == nil else { return }
+    if before { evidence.identityBefore = value } else { evidence.identityAfter = value }
+  }
+  func identityFailure(_ message: String) {
+    guard result == nil else { return }
+    evidence.identityReadError = [evidence.identityReadError, message].compactMap { $0 }.joined(separator: "; ")
+  }
+  func startRelease(index: Int, primitive: String) {
+    guard result == nil else { return }
+    evidence.releases.append(FBSimulatorHIDCleanupReleaseEvidence(index: index, primitive: primitive,
+      startedUptime: ProcessInfo.processInfo.systemUptime, returnedSuccessfully: false))
+  }
+  func finishRelease(index: Int, transport: FBSimulatorHIDSendEvidence?, error: String?) {
+    guard result == nil, evidence.releases.indices.contains(index) else { return }
+    evidence.releases[index].finishedUptime = ProcessInfo.processInfo.systemUptime
+    evidence.releases[index].returnedSuccessfully = error == nil
+    evidence.releases[index].errorDescription = error
+    evidence.releases[index].transport = transport
+  }
+  func startDrain() { guard result == nil else { return }; evidence.drainStartedUptime = ProcessInfo.processInfo.systemUptime }
+  func finishDrain() { guard result == nil else { return }; evidence.drainCompletedUptime = ProcessInfo.processInfo.systemUptime }
+  func finish(_ result: FBSimulatorHIDCleanupOutcome, timedOut: Bool = false, error: String? = nil) {
+    guard self.result == nil else { return }
+    self.result = result
+    evidence.timedOut = timedOut; evidence.errorDescription = error
+    evidence.finishedUptime = ProcessInfo.processInfo.systemUptime; evidence.outcome = result.rawValue
+    continuation?.resume(returning: result)
+    continuation = nil
+  }
+  func snapshot() -> FBSimulatorHIDCleanupEvidence { evidence }
+  func wait() async -> FBSimulatorHIDCleanupOutcome {
+    if let result { return result }
+    return await withCheckedContinuation { continuation = $0 }
+  }
+}
