new file mode 100644
index 0000000000000000000000000000000000000000..3ba176adb8a3e56ebf39f19a937ee4437f42c2a3
--- /dev/null
+++ b/FBSimulatorControl/HID/FBSimulatorContextGuestRead.swift
@@ -0,0 +1,103 @@
+@preconcurrency import FBControlCore
+import Foundation
+import Darwin
+
+public enum FBSimulatorContextError: Error, Sendable {
+  case unavailable(String)
+  case changedDuringRead
+  case guestCleanupUnconfirmed(String)
+}
+
+struct FBSimulatorContextGuestResult: Sendable {
+  let data: Data
+  let processIdentifier: Int32
+}
+
+/// Owns the subprocess after caller cancellation, including a late launch completion.
+/// Only normal exit with all IO detached can produce a successful read.
+private final class ContextGuestOwner: @unchecked Sendable {
+  private let lock = NSLock()
+  private var process: FBSubprocess<AnyObject, AnyObject, AnyObject>?
+  private var stopped = false
+  let completed = FBSimulatorBoundedResult<FBSimulatorContextGuestResult>()
+  let terminated = FBSimulatorBoundedResult<Bool>()
+
+  func launched(_ process: FBSubprocess<AnyObject, AnyObject, AnyObject>, stdout: NSMutableData) {
+    lock.lock()
+    self.process = process
+    let shouldStop = stopped
+    lock.unlock()
+    process.statLoc.onQueue(DispatchQueue.global(), notifyOfCompletion: { [self] resolved in
+      guard resolved.error == nil, resolved.result != nil else {
+        completed.finish(.failure(FBSimulatorContextError.guestCleanupUnconfirmed("No guest termination receipt")))
+        return
+      }
+      terminated.finish(.success(true))
+    })
+    process.exitCode.onQueue(DispatchQueue.global(), notifyOfCompletion: { [self] resolved in
+      guard resolved.error == nil, let code = resolved.result as? NSNumber, code.int32Value == 0 else {
+        completed.finish(.failure(FBSimulatorContextError.unavailable("Guest context helper did not exit normally")))
+        return
+      }
+      guard stdout.length <= 65_536 else {
+        completed.finish(.failure(FBSimulatorContextError.unavailable("Guest context output exceeds its limit")))
+        return
+      }
+      completed.finish(.success(FBSimulatorContextGuestResult(data: stdout as Data,
+        processIdentifier: process.processIdentifier)))
+    })
+    if shouldStop { stopProcess(process) }
+  }
+
+  func launchFailed(_ error: Error) {
+    terminated.finish(.success(true))
+    completed.finish(.failure(error))
+  }
+
+  func stop() {
+    lock.lock(); stopped = true; let process = self.process; lock.unlock()
+    if let process { stopProcess(process) }
+  }
+
+  private func stopProcess(_ process: FBSubprocess<AnyObject, AnyObject, AnyObject>) {
+    // This API owns SIGTERM, SIGKILL escalation and the process termination future.
+    _ = process.sendSignal(SIGTERM, backingOffToKillWithTimeout: 0.2, logger: nil)
+  }
+}
+
+enum FBSimulatorContextGuestRead {
+  static func read(simulator: FBSimulator, helperURL: URL, requestID: UUID) async throws -> FBSimulatorContextGuestResult {
+    guard helperURL.isFileURL, FileManager.default.isExecutableFile(atPath: helperURL.path) else {
+      throw FBSimulatorContextError.unavailable("Packaged CAD helper is missing or not executable")
+    }
+    try Task.checkCancellation()
+    let owner = ContextGuestOwner()
+    let stdout = NSMutableData()
+    // Objective-C generic erasure is required by the existing launchProcess boundary.
+    let output = FBProcessOutput<NSMutableData>(to: stdout) as! FBProcessOutput<AnyObject>
+    let io = FBProcessIO<AnyObject, AnyObject, AnyObject>(stdIn: nil, stdOut: output, stdErr: nil)
+    let configuration = FBProcessSpawnConfiguration(launchPath: helperURL.path,
+      arguments: [requestID.uuidString], environment: [:], io: io, mode: .launchd)
+    // This task remains owned by the callback state if spawn completes after the caller deadline.
+    Task {
+      do { owner.launched(try await simulator.launchProcess(configuration), stdout: stdout) }
+      catch { owner.launchFailed(error) }
+    }
+    do {
+      return try await withTaskCancellationHandler(operation: {
+        try await owner.completed.value(timeout: 5, operation: "Guest CAD read") { _ in }
+      }, onCancel: { owner.stop() })
+    } catch {
+      owner.stop()
+      // A detached cleanup wait is not cancelled with its caller.
+      let cleanup = await Task.detached {
+        do { return try await owner.terminated.value(timeout: 2, operation: "Guest CAD cleanup") { _ in } }
+        catch { return false }
+      }.value
+      guard cleanup else {
+        throw FBSimulatorContextError.guestCleanupUnconfirmed("Spawn or termination callback did not arrive; late cleanup remains owned")
+      }
+      throw error
+    }
+  }
+}
