+/// Only the session's owned state can construct these release requests. No DOWN is representable.
+enum FBSimulatorHIDOwnedRelease: Sendable {
+  case touch(CGPoint)
+  case pair(CGPoint, CGPoint)
+  case key(UInt32)
+  case button(FBSimulatorHIDButton)
+}
