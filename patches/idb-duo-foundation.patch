+public enum FBSimulatorAXSnapshotError: Error, Sendable {
+  case staleContext
+  case wrongSimulator
+  case invalidSelection
+  case invalidRemoteOptions
+  case emptyHierarchy
+  case emptySelector
+  case notFound
