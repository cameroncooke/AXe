+/// Explicit DTUHID wire values verified in the installed CoreDeviceUtilities image.
+/// The default remains none. A hint is not a guarantee of a system gesture effect.
+public enum FBSimulatorHIDNativeEdge: UInt64, Codable, Sendable, CaseIterable {
+  case none = 0, top = 1, left = 2, bottom = 3, right = 4
+}
+
+/// Edge of the currently oriented logical display. Convert once for the immutable session.
+public enum FBSimulatorHIDLogicalEdge: String, Codable, Sendable, CaseIterable {
+  case top, left, bottom, right
+
+  /// Matches the existing logical-to-panel-native point transform.
+  /// Native OS interpretation across all rotations still requires live verification.
+  public func nativeEdge(for rotation: FBSimulatorHIDDisplayRotation) -> FBSimulatorHIDNativeEdge {
+    switch (rotation, self) {
+    case (.rot0, .top), (.rot90, .right), (.rot180, .bottom), (.rot270, .left): return .top
+    case (.rot0, .left), (.rot90, .top), (.rot180, .right), (.rot270, .bottom): return .left
+    case (.rot0, .bottom), (.rot90, .left), (.rot180, .top), (.rot270, .right): return .bottom
+    case (.rot0, .right), (.rot90, .bottom), (.rot180, .left), (.rot270, .top): return .right
+    }
+  }
+}
