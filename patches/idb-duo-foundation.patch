@@ -0,0 +1,77 @@
+import Foundation
+import Testing
+@testable import FBSimulatorControl
+
+@Suite("Bounded read-only accessibility readiness")
+struct FBSimulatorAXAcquisitionPolicyTests {
+  @Test func existingDefaultsAndSingleAttemptInputPolicyStayUnchanged() throws {
+    let defaults = try FBSimulatorAXAcquisitionPolicy()
+    #expect(defaults.timeoutSeconds == 8)
+    #expect(defaults.maximumAttempts == 4)
+    #expect(defaults.retryDelaySeconds == 0)
+    let input = try FBSimulatorAXAcquisitionPolicy(timeoutSeconds: 8, maximumAttempts: 1)
+    #expect(input.maximumAttempts == 1)
+    #expect(input.retryDelaySeconds == 0)
+    let description = try FBSimulatorAXAcquisitionPolicy(timeoutSeconds: 8,
+      maximumAttempts: 8, retryDelaySeconds: 0.5)
+    #expect(description.timeoutSeconds == defaults.timeoutSeconds)
+    #expect(description.maximumAttempts == 8)
+    #expect(description.retryDelaySeconds == 0.5)
+  }
+
+  @Test func policyRejectsUnboundedAttemptsAndInvalidDelays() {
+    for count in [0, 9, Int.max] {
+      #expect(throws: FBSimulatorAXSnapshotError.self) {
+        _ = try FBSimulatorAXAcquisitionPolicy(maximumAttempts: count)
+      }
+    }
+    for delay in [-0.01, Double.nan, Double.infinity, 8.01] {
+      #expect(throws: FBSimulatorAXSnapshotError.self) {
+        _ = try FBSimulatorAXAcquisitionPolicy(timeoutSeconds: 8,
+          maximumAttempts: 8, retryDelaySeconds: delay)
+      }
+    }
+  }
+
+  @Test func aReadinessWaitCannotExtendTheOriginalDeadline() async throws {
+    let budget = FBAXAcquisitionBudget(seconds: 0.02)
+    let started = DispatchTime.now().uptimeNanoseconds
+    do {
+      try await budget.waitForReadiness(seconds: 0.5)
+      Issue.record("The readiness wait outlived its deadline without failing.")
+    } catch let stop as FBAXAcquisitionStop {
+      #expect(stop.outcome == .deadlineExceeded)
+    }
+    // This distinguishes the original deadline from sleeping the full retry delay.
+    #expect(DispatchTime.now().uptimeNanoseconds - started < 400_000_000)
+  }
+
+  @Test func cancellationInterruptsAReadinessWait() async throws {
+    let budget = FBAXAcquisitionBudget(seconds: 8)
+    let waiting = Task { try await budget.waitForReadiness(seconds: 0.5) }
+    try await Task.sleep(nanoseconds: 20_000_000)
+    let cancelled = DispatchTime.now().uptimeNanoseconds
+    waiting.cancel()
+    switch await waiting.result {
+    case .success:
+      Issue.record("A cancelled readiness wait reported success.")
+    case .failure(let error):
+      #expect(error is CancellationError)
+    }
+    #expect(DispatchTime.now().uptimeNanoseconds - cancelled < 400_000_000)
+  }
+
+  @Test func terminalContextOrProcessFailuresDoNotStartAnotherWait() async throws {
+    let outcomes: [FBSimulatorAXAcquisitionOutcome] = [.contextChanged, .processChanged, .cancelled]
+    for outcome in outcomes {
+      let budget = FBAXAcquisitionBudget(seconds: 8)
+      budget.stop(outcome)
+      do {
+        try await budget.waitForReadiness(seconds: 0.5)
+        Issue.record("A stopped acquisition entered another readiness wait.")
+      } catch let stop as FBAXAcquisitionStop {
+        #expect(stop.outcome == outcome)
+      }
+    }
+  }
+}
diff --git a/FBSimulatorControl/Commands/FBAXButtonChainPointSelection.swift b/FBSimulatorControl/Commands/FBAXButtonChainPointSelection.swift
new file mode 100644
index 0000000000000000000000000000000000000000..677bdd7d57726fc969f54de7177df14287db79d3
--- /dev/null
+++ b/FBSimulatorControl/Commands/FBAXButtonChainPointSelection.swift
@@ -0,0 +1,67 @@
+import Foundation
+
+/// Values live only inside one owned native Button-chain admission. Opaque IDs
+/// are not persistent selectors, aliases, or proof of display ownership.
+struct FBAXButtonChainPointSelection {
+  struct Identity: Equatable, Sendable {
+    let pid: Int32
+    let objectID: UInt64
+    let rawData: Data?
+  }
+
+  private struct Key: Hashable {
+    let pid: Int32
+    let objectID: UInt64
+    init(_ identity: Identity) { pid = identity.pid; objectID = identity.objectID }
+  }
+
+  private let members: [Identity]
+  private let occurrences: [Key: Int]
+  private let allTraversalIdentitiesAvailable: Bool
+  private var pinned: Identity?
+
+  init(members: [Identity], traversal: [Identity?]) throws {
+    guard members.count > 1, members.count <= 512, traversal.count <= 512,
+          members.count <= traversal.count, let leaf = members.last, leaf.pid > 0,
+          members.allSatisfy({ $0.pid == leaf.pid && $0.objectID > 0 }) else {
+      throw FBSimulatorAXTargetError.targetMismatch
+    }
+    let available = traversal.compactMap { $0 }
+    let counts = Dictionary(available.map { (Key($0), 1) }, uniquingKeysWith: +)
+    guard members.allSatisfy({ counts[Key($0)] != nil }) else {
+      throw FBSimulatorAXTargetError.targetMismatch
+    }
+    self.members = members
+    occurrences = counts
+    allTraversalIdentitiesAvailable = available.count == traversal.count
+  }
+
+  /// Preserve the exact leaf case. Only the new non-leaf case needs a unique
+  /// identity occurrence in both the chain and complete current native traversal.
+  func memberIndex(for point: Identity) throws -> Int {
+    guard let leaf = members.last, point.pid == leaf.pid, point.objectID > 0 else {
+      throw FBSimulatorAXTargetError.targetMismatch
+    }
+    if point == leaf { return members.count - 1 }
+    let matches = members.indices.filter { members[$0] == point }
+    guard allTraversalIdentitiesAvailable, matches.count == 1, let index = matches.first,
+          occurrences[Key(point)] == 1 else {
+      throw FBSimulatorAXTargetError.targetMismatch
+    }
+    return index
+  }
+
+  func requireCurrent(_ identity: Identity, at index: Int) throws {
+    guard members.indices.contains(index), members[index] == identity else {
+      throw FBSimulatorAXTargetError.targetMismatch
+    }
+  }
+
+  /// Call only after the native member's full signature and live state pass.
+  mutating func pinMember(at index: Int) throws {
+    guard members.indices.contains(index) else { throw FBSimulatorAXTargetError.targetMismatch }
+    let identity = members[index]
+    guard pinned == nil || pinned == identity else { throw FBSimulatorAXTargetError.targetMismatch }
+    pinned = identity
+  }
+}
