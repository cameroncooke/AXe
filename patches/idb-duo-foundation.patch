+import CoreGraphics
+import Foundation
+
+/// The core, transport-agnostic HID value types. Every transport (Indigo, DTUHID) and the
+/// `FBSimulatorHIDEvent` dispatch share these; they are intentionally independent of any one
+/// transport's wire format. Each carries a single canonical `name` — the source of truth for the
+/// string forms used in event descriptions and (upper-cased) in CLI arguments.
+
+/// The direction of a HID event.
+public enum FBSimulatorHIDDirection: Int32, Sendable, CaseIterable {
+  case down = 1
+  case up = 2
+
+  /// The canonical lower-snake-case name for this direction.
+  public var name: String {
+    switch self {
+    case .down: return "down"
+    case .up: return "up"
+    }
+  }
+}
+
+/// A hardware button press.
+public enum FBSimulatorHIDButton: Int32, Sendable, CaseIterable {
+  case applePay = 1
+  case homeButton = 2
+  case lock = 3
+  case sideButton = 4
+  case siri = 5
+
+  /// The canonical lower-snake-case name for this button.
+  public var name: String {
+    switch self {
+    case .applePay: return "apple_pay"
+    case .homeButton: return "home"
+    case .lock: return "lock"
+    case .sideButton: return "side_button"
+    case .siri: return "siri"
+    }
+  }
+}
+
+/// Device orientation. Values match UIDeviceOrientation (1-4, excluding faceUp/faceDown).
+public enum FBSimulatorHIDDeviceOrientation: Int32, Sendable, CaseIterable {
+  case portrait = 1
+  case portraitUpsideDown = 2
+  case landscapeRight = 3
+  case landscapeLeft = 4
+
+  /// The canonical lower-snake-case name for this orientation.
+  public var name: String {
+    switch self {
+    case .portrait: return "portrait"
+    case .portraitUpsideDown: return "portrait_upside_down"
+    case .landscapeRight: return "landscape_right"
+    case .landscapeLeft: return "landscape_left"
+    }
+  }
+}
+
+/// Guest CADisplay currentOrientation, independent of requested device orientation.
+public enum FBSimulatorHIDDisplayRotation: Int, Sendable, CaseIterable {
+  case rot0 = 0
+  case rot90 = 90
+  case rot180 = 180
+  case rot270 = 270
+}
+
+/// Invalid measured display geometry or an input outside the selected logical display.
+public enum FBSimulatorHIDDisplayContextError: Error, LocalizedError {
+  case invalidGeometry
+  case pointOutsideDisplay
+
+  public var errorDescription: String? {
+    switch self {
+    case .invalidGeometry:
+      return "Display pixel size and scale must be finite and positive"
+    case .pointOutsideDisplay:
+      return "Touch point must be finite and inside the selected logical display"
+    }
+  }
+}
+
+/// Immutable measured context for one display-targeted HID connection.
+/// The caller must refresh it after display, boot or orientation changes. The HID target is a
+/// modern digitizer target, not an AX display ID or a legacy Indigo target mask.
+public struct FBSimulatorHIDDisplayContext: Equatable, Sendable {
+  public let hidTarget: UInt64
+  public let nativePixelSize: CGSize
+  public let scale: Double
+  public let rotation: FBSimulatorHIDDisplayRotation
+
+  public init(
+    hidTarget: UInt64, nativePixelSize: CGSize, scale: Double,
+    rotation: FBSimulatorHIDDisplayRotation
+  ) throws {
+    guard nativePixelSize.width.isFinite, nativePixelSize.height.isFinite,
+          nativePixelSize.width > 0, nativePixelSize.height > 0,
+          scale.isFinite, scale > 0,
+          (Double(nativePixelSize.width) / scale).isFinite,
+          (Double(nativePixelSize.height) / scale).isFinite,
+          Double(nativePixelSize.width) / scale > 0,
+          Double(nativePixelSize.height) / scale > 0 else {
+      throw FBSimulatorHIDDisplayContextError.invalidGeometry
+    }
+    self.hidTarget = hidTarget
+    self.nativePixelSize = nativePixelSize
+    self.scale = scale
+    self.rotation = rotation
+  }
+
+  /// Current oriented display size in logical points, with a top-left origin.
+  public var logicalSize: CGSize {
+    let native = CGSize(width: nativePixelSize.width / scale, height: nativePixelSize.height / scale)
+    switch rotation {
+    case .rot0, .rot180: return native
+    case .rot90, .rot270: return CGSize(width: native.height, height: native.width)
+    }
+  }
+
+  /// Converts an oriented logical point to the panel-native normalized digitizer coordinates.
+  /// These quarter-turn transforms were checked against guest CADisplay readback in the Duo
+  /// routing audit. Points are rejected rather than clamped or silently sent to another display.
+  public func normalizedPoint(from point: CGPoint) throws -> CGPoint {
+    let size = logicalSize
+    guard point.x.isFinite, point.y.isFinite,
+          point.x >= 0, point.y >= 0, point.x <= size.width, point.y <= size.height else {
+      throw FBSimulatorHIDDisplayContextError.pointOutsideDisplay
+    }
+    let width = nativePixelSize.width / scale
+    let height = nativePixelSize.height / scale
+    switch rotation {
+    case .rot0: return CGPoint(x: point.x / width, y: point.y / height)
+    case .rot90: return CGPoint(x: point.y / width, y: 1 - point.x / height)
+    case .rot180: return CGPoint(x: 1 - point.x / width, y: 1 - point.y / height)
+    case .rot270: return CGPoint(x: 1 - point.y / width, y: point.x / height)
     }
   }
 }
diff --git a/FBSimulatorControl/HID/FBSimulatorHingeDisplayReadiness.swift b/FBSimulatorControl/HID/FBSimulatorHingeDisplayReadiness.swift
new file mode 100644
index 0000000000000000000000000000000000000000..fd7cf8aa0a01cef1b200b630a0ac5366238e5cad
--- /dev/null
+++ b/FBSimulatorControl/HID/FBSimulatorHingeDisplayReadiness.swift
@@ -0,0 +1,107 @@
+import Foundation
+
+protocol FBSimulatorHingeReadinessBackend: Sendable {
+  /// Must recheck expected boot/capability before a read and after success or a retryable failure.
+  func read() async throws -> FBSimulatorHingeDisplayObservation
+}
+
+/// Observes display coherence after a completed hinge operation. Never sends a hinge or HID event.
+public actor FBSimulatorHingeDisplayReadiness {
+  public static let maximumAttempts = 16
+  private let expected: FBSimulatorHingeReadinessRequest
+  private let expectedBoot: String
+  private let backend: any FBSimulatorHingeReadinessBackend
+  private var busy = false
+  private var finished = false
+
+  init(expected: FBSimulatorHingeReadinessRequest, expectedBoot: String,
+       backend: any FBSimulatorHingeReadinessBackend) {
+    self.expected = expected; self.expectedBoot = expectedBoot; self.backend = backend
+  }
+
+  public func observe(after mechanical: FBSimulatorHingeReceipt) async -> FBSimulatorHingeReadinessReceipt {
+    let started = ProcessInfo.processInfo.systemUptime
+    var attempts: [FBSimulatorHingeReadinessAttempt] = []
+    var previous: FBSimulatorHingeDisplayObservation?
+    var last: FBSimulatorHingeDisplayObservation?
+    func result(_ failure: FBSimulatorHingeReadinessError?, pair: [FBSimulatorHingeDisplayObservation] = []) -> FBSimulatorHingeReadinessReceipt {
+      FBSimulatorHingeReadinessReceipt(outcome: failure == nil ? .coherent : .incomplete,
+        expected: expected, expectedBootIdentity: expectedBoot, startedUptime: started,
+        finishedUptime: ProcessInfo.processInfo.systemUptime, attempts: attempts,
+        coherentObservations: pair, lastObservation: last, failure: failure, cleanup: failure?.cleanup ?? .confirmed)
+    }
+    guard !busy else { return result(.init(.busy, "Readiness observation is already running")) }
+    guard !finished else { return result(.init(.closed, "Readiness observation is one-use")) }
+    busy = true
+    defer { busy = false; finished = true }
+    guard mechanical.expectedBootIdentity == expectedBoot else {
+      return result(.init(.bootChanged, "Mechanical receipt boot differs from the prepared observer"))
+    }
+    let deadline = started + expected.timeoutSeconds
+    while attempts.count < Self.maximumAttempts {
+      if Task.isCancelled { return result(.init(.cancelled, "Readiness was cancelled after mechanical completion")) }
+      let now = ProcessInfo.processInfo.systemUptime
+      guard now < deadline else { return result(.init(.deadline, "Display coherence deadline expired")) }
+      let value = await Self.boundedRead(backend, remaining: deadline - now)
+      let ended = ProcessInfo.processInfo.systemUptime
+      let failure: FBSimulatorHingeReadinessError?
+      switch value { case .success: failure = nil; case .failure(let error): failure = error }
+      attempts.append(.init(index: attempts.count + 1, startedUptime: now, finishedUptime: ended, failure: failure))
+      if let failure, failure.cleanup == .unconfirmed { return result(failure) }
+      if let failure, !failure.permitsTransitionRetry { return result(failure) }
+      if Task.isCancelled { return result(.init(.cancelled, "Readiness was cancelled; observer cleanup is confirmed")) }
+      guard ended < deadline else { return result(.init(.deadline, "Display coherence deadline expired; observer cleanup is confirmed")) }
+      switch value {
+      case .failure(let failure):
+        guard failure.permitsTransitionRetry else { return result(failure) }
+        previous = nil
+      case .success(let current):
+        last = current
+        guard abs(current.mechanicalBefore - mechanical.requestedDegrees) <= mechanical.toleranceDegrees,
+              abs(current.mechanicalAfter - mechanical.requestedDegrees) <= mechanical.toleranceDegrees,
+              current.velocityBefore == 0, current.velocityAfter == 0 else {
+          return result(.init(.mechanicalTargetChanged, "Mechanical target or observed velocity changed after completion"))
+        }
+        if let previous, current.coherent(with: previous) {
+          return result(nil, pair: [previous, current])
+        }
+        previous = current
+      }
+    }
+    return result(.init(.attemptLimit, "Display coherence attempt limit reached"))
+  }
+
+  private enum ReadEvent: Sendable {
+    case read(Result<FBSimulatorHingeDisplayObservation, FBSimulatorHingeReadinessError>)
+    case timer
+  }
+
+  /// Cancellation never discards the read's cleanup result. The task group awaits both children.
+  private static func boundedRead(_ backend: any FBSimulatorHingeReadinessBackend, remaining: Double)
+    async -> Result<FBSimulatorHingeDisplayObservation, FBSimulatorHingeReadinessError> {
+    await withTaskGroup(of: ReadEvent.self) { group in
+      group.addTask {
+        do { return .read(.success(try await backend.read())) }
+        catch let error as FBSimulatorHingeReadinessError { return .read(.failure(error)) }
+        catch { return .read(.failure(.init(error is CancellationError ? .cancelled : .unavailable, String(describing: error)))) }
+      }
+      group.addTask {
+        try? await Task.sleep(nanoseconds: UInt64(remaining * 1_000_000_000))
+        return .timer
+      }
+      guard let first = await group.next() else { return .failure(.init(.unavailable, "Readiness task group returned no result")) }
+      group.cancelAll()
+      switch first {
+      case .read(let value): return value
+      case .timer:
+        var readResult: Result<FBSimulatorHingeDisplayObservation, FBSimulatorHingeReadinessError>?
+        for await event in group { if case .read(let value) = event { readResult = value } }
+        if case .failure(let error) = readResult,
+           error.cleanup == .unconfirmed || error.code == .bootChanged || error.code == .unsupported {
+          return .failure(error)
+        }
+        return .failure(.init(Task.isCancelled ? .cancelled : .deadline, "Readiness deadline or cancellation reached; observer cleanup is confirmed"))
+      }
+    }
+  }
+}
diff --git a/FBSimulatorControl/HID/FBSimulatorHingeNative.swift b/FBSimulatorControl/HID/FBSimulatorHingeNative.swift
new file mode 100644
index 0000000000000000000000000000000000000000..762642696bc88b8b43422f5fb28c5edc481b8780
--- /dev/null
+++ b/FBSimulatorControl/HID/FBSimulatorHingeNative.swift
@@ -0,0 +1,290 @@
+@preconcurrency import CoreSimulator
+@preconcurrency import FBControlCore
+import Foundation
+import Darwin
+import IOKit
+@preconcurrency import XPC
+
+public struct FBSimulatorHingeReadback: Codable, Sendable {
+  public let simulatorUDID: String
+  public let bootIdentity: String
+  public let capability: FBSimulatorContextCapability
+  public let sample: FBSimulatorHingeSample
+}
+
+actor NativeHingeBackend: FBSimulatorHingeBackend {
+  private static let service = "com.apple.coredevice.feature.remote.hid.vendordefined"
+  private let simulator: FBSimulator
+  private var connection: xpc_connection_t?
+  private let connectionFailure = HingeConnectionFailure()
+  init(simulator: FBSimulator) { self.simulator = simulator }
+
+  func validate(expectedBoot: String) throws {
+    guard simulator.state == .booted else { throw FBSimulatorHingeFailure(reason: .bootChanged, detail: "Simulator is not booted", delivery: .notDispatched) }
+    let capability = try FBSimulatorNativeContextReader.capability(for: simulator)
+    guard capability.hinge == .supported else {
+      throw FBSimulatorHingeFailure(reason: .unsupported, detail: capability.reason, delivery: .notDispatched)
+    }
+    guard try Self.bootIdentity(simulator.udid) == expectedBoot else {
+      throw FBSimulatorHingeFailure(reason: .bootChanged, detail: "Simulator boot identity changed", delivery: .notDispatched)
+    }
+    if let failure = connectionFailure.read() {
+      throw FBSimulatorHingeFailure(reason: .unavailable, detail: failure, delivery: .notDispatched)
+    }
+  }
+
+  func sample() async throws -> FBSimulatorHingeSample {
+    let value = try await FBSimulatorHingeReader.read(for: simulator)
+    return FBSimulatorHingeSample(mechanicalDegrees: value.mechanicalDegrees, sensedDegrees: value.sensedDegrees,
+      velocityDegreesPerSecond: value.velocityDegreesPerSecond, minimumDegrees: value.minimumDegrees,
+      maximumDegrees: value.maximumDegrees, timestampUptime: value.timestampUptime, receivedUptime: value.receivedUptime)
+  }
+
+  func dispatch(degrees: Double) throws {
+    try Task.checkCancellation()
+    guard connection == nil else { throw FBSimulatorHingeFailure(reason: .busy, detail: "Vendor connection already used", delivery: .notDispatched) }
+    try dispatchMessage(Self.message(degrees))
+  }
+
+  func dispatchOrientation(_ target: String) throws {
+    try Task.checkCancellation()
+    guard connection == nil else { throw unavailable("Vendor connection already used") }
+    try dispatchMessage(Self.vendorMessage(source: "orientation-picker-control", type: "enum", value: target as NSString))
+  }
+
+  private func dispatchMessage(_ message: xpc_object_t) throws {
+    let connection = try connect()
+    self.connection = connection
+    let failure = connectionFailure
+    xpc_connection_set_event_handler(connection) { event in
+      if xpc_get_type(event) == XPC_TYPE_ERROR { failure.record("Vendor XPC connection reported an error") }
+      else { failure.record("Unexpected vendor service event; no reply schema is verified") }
+    }
+    xpc_connection_resume(connection)
+    try Task.checkCancellation()
+    xpc_connection_send_message(connection, message)
+    // No guest barrier is sent. Keep this connection alive while the independent reader runs.
+  }
+
+  func close() {
+    if let connection { xpc_connection_cancel(connection) }
+    connection = nil
+  }
+
+  private func connect() throws -> xpc_connection_t {
+    typealias Endpoint = @convention(c) (mach_port_t, UInt64, UInt64) -> xpc_object_t?
+    typealias Connect = @convention(c) (xpc_object_t) -> xpc_connection_t?
+    typealias Enable = @convention(c) (xpc_connection_t) -> Void
+    guard let handle = dlopen(nil, RTLD_NOW) else { throw unavailable("XPC symbols unavailable") }
+    defer { dlclose(handle) }
+    guard let ep = dlsym(handle, "xpc_endpoint_create_mach_port_4sim"),
+          let make = dlsym(handle, "xpc_connection_create_from_endpoint"),
+          let enable = dlsym(handle, "xpc_connection_enable_sim2host_4sim") else { throw unavailable("Simulator XPC endpoint functions unavailable") }
+    var error: NSError?
+    let port = simulator.device.lookup(Self.service, error: &error)
+    guard port != 0, let endpoint = unsafeBitCast(ep, to: Endpoint.self)(port, 0, 0),
+          let result = unsafeBitCast(make, to: Connect.self)(endpoint) else {
+      throw unavailable(error?.localizedDescription ?? "Hinge vendor service unavailable")
+    }
+    unsafeBitCast(enable, to: Enable.self)(result)
+    return result
+  }
+
+  private static func message(_ degrees: Double) throws -> xpc_object_t {
+    try vendorMessage(source: "hinge-slider-control", type: "range", value: NSNumber(value: degrees))
+  }
+
+  private static func vendorMessage(source: String, type: String, value: NSObject) throws -> xpc_object_t {
+    let payload: [String: NSObject] = ["provider": "com.apple.Virtualization.VirtualMachines" as NSString,
+      "source": source as NSString, "type": type as NSString, "value": value]
+    guard let serialized = IOCFSerialize(payload as CFDictionary, 1) else {
+      throw FBSimulatorHingeFailure(reason: .unavailable, detail: "Cannot serialize vendor event", delivery: .notDispatched)
+    }
+    let data = serialized as Data
+    let event = xpc_dictionary_create(nil, nil, 0)
+    xpc_dictionary_set_uint64(event, "usagePage", 0xFF61)
+    xpc_dictionary_set_uint64(event, "usage", 0x5B)
+    xpc_dictionary_set_uint64(event, "version", 0)
+    data.withUnsafeBytes { xpc_dictionary_set_data(event, "data", $0.baseAddress, $0.count) }
+    let envelope = xpc_dictionary_create(nil, nil, 0)
+    xpc_dictionary_set_string(envelope, "messageType", "IndigoVendorDefinedEvent")
+    xpc_dictionary_set_bool(envelope, "isBarrier", false)
+    xpc_dictionary_set_string(envelope, "featureIdentifier", service)
+    xpc_dictionary_set_value(envelope, "payload", event)
+    return envelope
+  }
+
+  static func bootIdentity(_ udid: String) throws -> String {
+    let processes = FBProcessFetcher().processes(withProcessName: "launchd_sim").filter {
+      $0.arguments.contains { $0.localizedCaseInsensitiveContains(udid) }
+    }
+    guard processes.count == 1, let process = processes.first else {
+      throw FBSimulatorHingeFailure(reason: .bootChanged, detail: "Expected one launchd_sim for the device", delivery: .notDispatched)
+    }
+    var info = proc_bsdinfo()
+    let size = Int32(MemoryLayout<proc_bsdinfo>.size)
+    guard proc_pidinfo(process.processIdentifier, PROC_PIDTBSDINFO, 0, &info, size) == size else {
+      throw FBSimulatorHingeFailure(reason: .bootChanged, detail: "Boot process identity unavailable", delivery: .notDispatched)
+    }
+    return "\(process.processIdentifier):\(info.pbi_start_tvsec):\(info.pbi_start_tvusec)"
+  }
+  private func unavailable(_ detail: String) -> FBSimulatorHingeFailure {
+    FBSimulatorHingeFailure(reason: .unavailable, detail: detail, delivery: .notDispatched)
+  }
+}
+
+private final class HingeConnectionFailure: @unchecked Sendable {
+  private let lock = NSLock()
+  private var failure: String?
+  func record(_ value: String) { lock.lock(); defer { lock.unlock() }; if failure == nil { failure = value } }
+  func read() -> String? { lock.lock(); defer { lock.unlock() }; return failure }
+}
+
+public enum FBSimulatorHingeNative {
+  public static func operation(for simulator: FBSimulator) -> FBSimulatorHingeOperation {
+    FBSimulatorHingeOperation(backend: NativeHingeBackend(simulator: simulator))
+  }
+  public static func read(for simulator: FBSimulator, expectedBootIdentity: String? = nil) async throws -> FBSimulatorHingeReadback {
+    try Task.checkCancellation()
+    let backend = NativeHingeBackend(simulator: simulator)
+    let boot = try NativeHingeBackend.bootIdentity(simulator.udid)
+    if let expectedBootIdentity, expectedBootIdentity != boot {
+      throw FBSimulatorHingeFailure(reason: .bootChanged, detail: "Simulator boot identity differs from the request", delivery: .notDispatched)
+    }
+    try await backend.validate(expectedBoot: boot)
+    let sample = try await backend.sample()
+    try await backend.validate(expectedBoot: boot)
+    try FBSimulatorHingeOperation.validateSample(sample)
+    try Task.checkCancellation()
+    return FBSimulatorHingeReadback(simulatorUDID: simulator.udid, bootIdentity: boot,
+      capability: try FBSimulatorNativeContextReader.capability(for: simulator), sample: sample)
+  }
+}
+
+public enum FBSimulatorRotationDirection: String, Codable, Sendable {
+  case left, right
+}
+
+public struct FBSimulatorRotationReceipt: Codable, Sendable {
+  public let direction: FBSimulatorRotationDirection
+  public let vendorTarget: String
+  public let before: FBSimulatorContextObservation
+  public let after: FBSimulatorContextObservation
+  public let matchingObservationCount: Int
+  public let vendorEventCount: Int
+}
+
+public struct FBSimulatorRotationFailure: Error, Codable, Sendable {
+  public let detail: String
+  public let delivery: FBSimulatorHingeDelivery
+  public let before: FBSimulatorContextObservation?
+  public init(detail: String, delivery: FBSimulatorHingeDelivery, before: FBSimulatorContextObservation?) {
+    self.detail = String(detail.prefix(1024)); self.delivery = delivery; self.before = before
+  }
+}
+
+/// Device-wide rotation. The caller must hold the same device input lease used for touches.
+/// The selected panel is an admission/readback target, not an independently rotated display.
+public enum FBSimulatorRotationNative {
+  @MainActor
+  public static func rotate(for simulator: FBSimulator, helperURL: URL, screenID: UInt32, screenUUID: UUID,
+                            expectedBootIdentity: String, direction: FBSimulatorRotationDirection,
+                            timeoutSeconds: Double = 8) async throws -> FBSimulatorRotationReceipt {
+    let backend = NativeHingeBackend(simulator: simulator)
+    var before: FBSimulatorContextObservation?
+    var dispatched = false
+    do {
+      guard timeoutSeconds.isFinite, (0.5...15).contains(timeoutSeconds) else {
+        throw FBSimulatorContextError.unavailable("Rotation timeout must be in 0.5...15 seconds")
+      }
+      try Task.checkCancellation()
+      try await backend.validate(expectedBoot: expectedBootIdentity)
+      let reader = FBSimulatorNativeContextReader(simulator: simulator, helperURL: helperURL,
+        screenID: screenID, screenUniqueID: screenUUID)
+      let initial = try await reader.read()
+      before = initial.observation
+      guard initial.observation.bootIdentity == expectedBootIdentity else {
+        throw FBSimulatorContextError.unavailable("Rotation boot identity changed before dispatch")
+      }
+      let plan = try target(direction: direction, readback: initial)
+      // Compact replies have a fixed count of observations. Reserve capacity before the write.
+      guard try JSONEncoder().encode(initial.observation).count <= 4096 else {
+        throw FBSimulatorContextError.unavailable("Rotation observation exceeds reply capacity")
+      }
+      try await backend.validate(expectedBoot: expectedBootIdentity)
+      try await backend.dispatchOrientation(plan.vendor)
+      dispatched = true
+      let deadline = ProcessInfo.processInfo.systemUptime + timeoutSeconds
+      var previous: FBSimulatorHIDSessionObservation?
+      var matches = 0
+      while ProcessInfo.processInfo.systemUptime < deadline {
+        try Task.checkCancellation()
+        try await backend.validate(expectedBoot: expectedBootIdentity)
+        do {
+          let current = try await reader.read().observation
+          guard current.bootIdentity == expectedBootIdentity,
+                current.screenID == initial.observation.screenID,
+                current.screenUniqueID == initial.observation.screenUniqueID,
+                current.poseRevision == initial.observation.poseRevision else {
+            throw FBSimulatorContextError.unavailable("Boot, selected screen or hinge changed during rotation")
+          }
+          let observed = try current.sessionObservation()
+          if current.rotation == plan.rotation {
+            matches = previous == observed ? matches + 1 : 1
+            previous = observed
+          } else { matches = 0; previous = nil }
+          if matches == 2 { break }
+        } catch FBSimulatorContextError.changedDuringRead {
+          matches = 0; previous = nil
+        } catch let error as ActivePanelReadError where error.childFailure == nil &&
+            error.validationFailure == .selectedRotationMismatch && error.receipt?.exitConfirmed == true {
+          // The two readers can straddle the orientation change. Observe again; never resend.
+          matches = 0; previous = nil
+        }
+        try await Task.sleep(nanoseconds: 100_000_000)
+      }
+      guard matches == 2 else {
+        throw FBSimulatorContextError.unavailable("Requested selected rotation was not observed twice")
+      }
+      await backend.close()
+      try await Task.sleep(nanoseconds: 250_000_000)
+      let after = try await reader.read().observation
+      guard try after.sessionObservation() == previous else {
+        throw FBSimulatorContextError.unavailable("Rotation did not persist after vendor connection close")
+      }
+      return FBSimulatorRotationReceipt(direction: direction, vendorTarget: plan.vendor,
+        before: initial.observation, after: after, matchingObservationCount: matches, vendorEventCount: 1)
+    } catch {
+      await backend.close()
+      throw FBSimulatorRotationFailure(detail: String(describing: error),
+        delivery: dispatched ? .uncertain : .notDispatched, before: before)
+    }
+  }
+
+  private static func target(direction: FBSimulatorRotationDirection,
+                             readback: FBSimulatorContextReadback) throws -> (rotation: Int, vendor: String) {
+    let capability = readback.capability
+    guard capability.deviceTypeIdentifier == "com.apple.CoreSimulator.SimDeviceType.iPhone-Duo",
+          capability.modelIdentifier == "iPhone19,4", capability.profileVersion == "405",
+          capability.integratedDigitizerIDs == [1, 3] else {
+      throw FBSimulatorContextError.unavailable("Rotation mapping is not verified for this device profile")
+    }
+    let outer = readback.observation.screenID == 1
+    let positions = outer ? [0, 90, 270] : [0, 90, 180, 270]
+    guard let index = positions.firstIndex(of: readback.observation.rotation) else {
+      throw FBSimulatorContextError.unavailable("Current panel rotation is not supported")
+    }
+    let step = direction == .right ? 1 : positions.count - 1
+    let rotation = positions[(index + step) % positions.count]
+    // Vendor values describe physical device orientation. Inner UI has a 90-degree offset.
+    let physical = (rotation + (outer ? 0 : 270)) % 360
+    let vendor: String
+    switch physical {
+    case 0: vendor = "portrait"
+    case 90: vendor = "landscape-right"
+    case 180: vendor = "pud"
+    default: vendor = "landscape-left"
+    }
+    return (rotation, vendor)
+  }
+}
diff --git a/FBSimulatorControl/HID/FBSimulatorHingeOperation.swift b/FBSimulatorControl/HID/FBSimulatorHingeOperation.swift
new file mode 100644
index 0000000000000000000000000000000000000000..8f9ed662b5f5e37ca314e2aacb4d358bc1b320b2
--- /dev/null
+++ b/FBSimulatorControl/HID/FBSimulatorHingeOperation.swift
@@ -0,0 +1,164 @@
+import Foundation
+
+public struct FBSimulatorHingeRequest: Encodable, Sendable {
+  public let degrees: Double
+  public let expectedBootIdentity: String
+  public let toleranceDegrees: Double
+  public let timeoutSeconds: Double
+  public init(degrees: Double, expectedBootIdentity: String, toleranceDegrees: Double = 0.5,
+              timeoutSeconds: Double = 8) throws {
+    guard degrees.isFinite, (0...180).contains(degrees), !expectedBootIdentity.isEmpty,
+          toleranceDegrees.isFinite, (0...1).contains(toleranceDegrees),
+          timeoutSeconds.isFinite, (0.5...15).contains(timeoutSeconds) else {
+      throw FBSimulatorHingeFailure(reason: .invalidRequest, detail: "Angle 0...180, tolerance 0...1, timeout 0.5...15 and boot identity are required", delivery: .notDispatched)
+    }
+    self.degrees = degrees; self.expectedBootIdentity = expectedBootIdentity
+    self.toleranceDegrees = toleranceDegrees; self.timeoutSeconds = timeoutSeconds
+  }
+}
+public struct FBSimulatorHingeSample: Codable, Sendable {
+  public let mechanicalDegrees: Double
+  public let sensedDegrees: Double
+  public let velocityDegreesPerSecond: Double
+  public let minimumDegrees: Double
+  public let maximumDegrees: Double
+  public let timestampUptime: Double
+  public let receivedUptime: Double
+}
+public enum FBSimulatorHingeDelivery: String, Codable, Sendable { case notDispatched, uncertain }
+public enum FBSimulatorHingeFailureReason: String, Codable, Sendable {
+  case invalidRequest, busy, closed, unsupported, bootChanged, unavailable, timeout, cancelled
+}
+public struct FBSimulatorHingeFailure: Error, Codable, Sendable {
+  public let reason: FBSimulatorHingeFailureReason
+  public let detail: String
+  public var delivery: FBSimulatorHingeDelivery
+  public var requestedDegrees: Double? = nil
+  public var latestSample: FBSimulatorHingeSample? = nil
+}
+public struct FBSimulatorHingeReceipt: Codable, Sendable {
+  public let requestedDegrees: Double
+  public let expectedBootIdentity: String
+  public let toleranceDegrees: Double
+  public let before: FBSimulatorHingeSample
+  public let matchingSamples: [FBSimulatorHingeSample]
+  public let wasAlreadyWithinTolerance: Bool
+  public let startedUptime: Double
+  public let finishedUptime: Double
+  public let guestWriteAcknowledged: Bool = false
+  public let outcome = "observedMechanicalTarget"
+}
+
+/// One backend owns one vendor connection. Native reads must honor cancellation.
+protocol FBSimulatorHingeBackend: Sendable {
+  func validate(expectedBoot: String) async throws
+  func sample() async throws -> FBSimulatorHingeSample
+  func dispatch(degrees: Double) async throws
+  func close() async
+}
+
+/// A measured target is not a write acknowledgment or proof of future stability.
+/// No automatic retry of a write, restore, panel selection or power operation.
+public actor FBSimulatorHingeOperation {
+  private let backend: any FBSimulatorHingeBackend
+  private var busy = false
+  private var finished = false
+  init(backend: any FBSimulatorHingeBackend) { self.backend = backend }
+
+  public func set(_ request: FBSimulatorHingeRequest) async throws -> FBSimulatorHingeReceipt {
+    guard !busy else { throw FBSimulatorHingeFailure(reason: .busy, detail: "Another hinge operation is active", delivery: .notDispatched) }
+    guard !finished else { throw FBSimulatorHingeFailure(reason: .closed, detail: "Create a new operation after each result", delivery: .notDispatched) }
+    busy = true
+    defer { busy = false; finished = true }
+    let state = FBSimulatorHingeProgress()
+    let started = ProcessInfo.processInfo.systemUptime
+    do {
+      let receipt = try await withThrowingTaskGroup(of: FBSimulatorHingeReceipt.self) { group in
+        group.addTask { try await Self.run(request, backend: self.backend, state: state, started: started) }
+        group.addTask {
+          try await Task.sleep(nanoseconds: UInt64(request.timeoutSeconds * 1_000_000_000))
+          throw FBSimulatorHingeFailure(reason: .timeout, detail: "Hinge readback deadline expired", delivery: .notDispatched)
+        }
+        defer { group.cancelAll() }
+        guard let first = try await group.next() else { throw CancellationError() }
+        return first
+      }
+      await backend.close()
+      return receipt
+    } catch {
+      await backend.close()
+      let progress = await state.snapshot()
+      var failure = error as? FBSimulatorHingeFailure ?? FBSimulatorHingeFailure(
+        reason: error is CancellationError ? .cancelled : .unavailable,
+        detail: String(describing: error), delivery: .notDispatched)
+      failure.delivery = progress.attempted ? .uncertain : .notDispatched
+      failure.requestedDegrees = request.degrees
+      failure.latestSample = progress.latest
+      throw failure
+    }
+  }
+
+  private static func run(_ request: FBSimulatorHingeRequest, backend: any FBSimulatorHingeBackend,
+                          state: FBSimulatorHingeProgress, started: Double) async throws -> FBSimulatorHingeReceipt {
+    try Task.checkCancellation()
+    try await backend.validate(expectedBoot: request.expectedBootIdentity)
+    let before = try await backend.sample()
+    await state.record(before)
+    try validateSample(before)
+    guard (before.minimumDegrees...before.maximumDegrees).contains(request.degrees) else {
+      throw FBSimulatorHingeFailure(reason: .invalidRequest, detail: "Requested angle is outside the measured range", delivery: .notDispatched)
+    }
+    try await backend.validate(expectedBoot: request.expectedBootIdentity)
+    try Task.checkCancellation()
+    // Mark before entering dispatch: cancellation at this boundary cannot prove no delivery.
+    await state.markAttempted()
+    try await backend.dispatch(degrees: request.degrees)
+    let dispatched = ProcessInfo.processInfo.systemUptime
+    var matches: [FBSimulatorHingeSample] = []
+    var latestTimestamp = before.timestampUptime
+    while true {
+      try Task.checkCancellation()
+      try await backend.validate(expectedBoot: request.expectedBootIdentity)
+      let sample = try await backend.sample()
+      await state.record(sample)
+      try validateSample(sample)
+      try await backend.validate(expectedBoot: request.expectedBootIdentity)
+      guard sample.timestampUptime >= dispatched, sample.timestampUptime > latestTimestamp else {
+        throw FBSimulatorHingeFailure(reason: .unavailable, detail: "Hinge sample is not fresh after dispatch", delivery: .uncertain)
+      }
+      latestTimestamp = sample.timestampUptime
+      guard sample.minimumDegrees == before.minimumDegrees, sample.maximumDegrees == before.maximumDegrees else {
+        throw FBSimulatorHingeFailure(reason: .unavailable, detail: "Hinge range changed", delivery: .uncertain)
+      }
+      if abs(sample.mechanicalDegrees - request.degrees) <= request.toleranceDegrees {
+        matches.append(sample)
+      } else { matches.removeAll() }
+      if matches.count == 2 {
+        try Task.checkCancellation()
+        return FBSimulatorHingeReceipt(requestedDegrees: request.degrees, expectedBootIdentity: request.expectedBootIdentity,
+          toleranceDegrees: request.toleranceDegrees, before: before, matchingSamples: matches,
+          wasAlreadyWithinTolerance: abs(before.mechanicalDegrees - request.degrees) <= request.toleranceDegrees,
+          startedUptime: started, finishedUptime: ProcessInfo.processInfo.systemUptime)
+      }
+      try await Task.sleep(nanoseconds: 100_000_000)
+    }
+  }
+
+  static func validateSample(_ sample: FBSimulatorHingeSample) throws {
+    let values = [sample.mechanicalDegrees, sample.sensedDegrees, sample.velocityDegreesPerSecond,
+      sample.minimumDegrees, sample.maximumDegrees, sample.timestampUptime, sample.receivedUptime]
+    guard values.allSatisfy({ $0.isFinite }), sample.minimumDegrees <= sample.maximumDegrees,
+          (sample.minimumDegrees...sample.maximumDegrees).contains(sample.mechanicalDegrees),
+          (sample.minimumDegrees...sample.maximumDegrees).contains(sample.sensedDegrees),
+          sample.timestampUptime <= sample.receivedUptime else {
+      throw FBSimulatorHingeFailure(reason: .unavailable, detail: "Invalid hinge sample", delivery: .notDispatched)
+    }
+  }
+}
+private actor FBSimulatorHingeProgress {
+  var attempted = false
+  var latest: FBSimulatorHingeSample?
+  func markAttempted() { attempted = true }
+  func record(_ sample: FBSimulatorHingeSample) { latest = sample }
+  func snapshot() -> (attempted: Bool, latest: FBSimulatorHingeSample?) { (attempted, latest) }
+}
diff --git a/FBSimulatorControl/HID/FBSimulatorHingeReader.swift b/FBSimulatorControl/HID/FBSimulatorHingeReader.swift
new file mode 100644
index 0000000000000000000000000000000000000000..5bf1cdaf62e540f003a1fe71b966d0be0c1ec0db
--- /dev/null
+++ b/FBSimulatorControl/HID/FBSimulatorHingeReader.swift
@@ -0,0 +1,111 @@
+@preconcurrency import XPC
+import Foundation
+
+/// A fresh sample, its cancellation reply and the original request reply complete one read.
+public enum FBSimulatorHingeReader {
+  public static func read(for simulator: FBSimulator) async throws -> FBSimulatorHingeObservation {
+    let channel = UUID()
+    let request = try FBSimulatorHIDHingeWire.request(deviceID: simulator.udid, channel: channel, changeThreshold: 0)
+    let connection = try FBSimulatorHIDHingeWire.connect(simulator)
+    defer { xpc_connection_cancel(connection) }
+    let queue = DispatchQueue(label: "com.facebook.FBSimulatorControl.context-hinge")
+    xpc_connection_set_target_queue(connection, queue)
+    let result = FBSimulatorBoundedResult<FBSimulatorHingeObservation>()
+    return try await result.value(timeout: 3, operation: "Context hinge sample") { finish in
+      let started = ProcessInfo.processInfo.systemUptime
+      let completion = FBSimulatorHingeReadCompletion(deadline: started + 3, finish: finish)
+      xpc_connection_set_event_handler(connection) { event in
+        guard !completion.finished else { return }
+        do {
+          let samples = try FBSimulatorHIDHingeWire.samples(event, channel: channel, notBefore: started)
+          let hasSample = completion.remember(samples.max { $0.timestampUptime < $1.timestampUptime })
+          guard let reply = xpc_dictionary_create_reply(event) else {
+            throw FBSimulatorHIDHingeWire.failure("Context motion sample has no reply channel")
+          }
+          xpc_dictionary_set_bool(reply, "CoreDevice.XPCMessageKey.cancellationRequested", hasSample)
+          xpc_connection_send_message(connection, reply)
+          if hasSample {
+            let sequence = completion.cancellationReplyEnqueued()
+            xpc_connection_send_barrier(connection) {
+              queue.async { completion.cancellationReplyDrained(sequence) }
+            }
+          }
+        } catch { completion.fail(error) }
+      }
+      xpc_connection_resume(connection)
+      xpc_connection_send_message_with_reply(connection, request, queue) { reply in
+        guard !completion.finished else { return }
+        guard xpc_get_type(reply) == XPC_TYPE_DICTIONARY,
+              xpc_dictionary_get_value(reply, "CoreDevice.error") == nil,
+              let output = xpc_dictionary_get_value(reply, "CoreDevice.output"),
+              xpc_get_type(output) == XPC_TYPE_DICTIONARY,
+              xpc_dictionary_get_count(output) == 0 else {
+          completion.fail(FBSimulatorHIDHingeWire.failure("Context motion service rejected the request"))
+          return
+        }
+        completion.originalReplyReceived()
+      }
+    }
+  }
+}
+
+/// All mutable state and the finish callback belong to the read's existing serial XPC queue.
+/// The send barrier returns to that queue before it changes completion state.
+private final class FBSimulatorHingeReadCompletion: @unchecked Sendable {
+  private let deadline: TimeInterval
+  private let finish: @Sendable (Result<FBSimulatorHingeObservation, Error>) -> Void
+  private var sample: FBSimulatorHingeObservation?
+  private var enqueuedReplies = 0
+  private var drainedReplies = 0
+  private var receivedOriginalReply = false
+  private(set) var finished = false
+
+  init(deadline: TimeInterval,
+       finish: @escaping @Sendable (Result<FBSimulatorHingeObservation, Error>) -> Void) {
+    self.deadline = deadline
+    self.finish = finish
+  }
+
+  func remember(_ candidate: FBSimulatorHingeObservation?) -> Bool {
+    if sample == nil { sample = candidate }
+    return sample != nil
+  }
+
+  func cancellationReplyEnqueued() -> Int {
+    enqueuedReplies += 1
+    return enqueuedReplies
+  }
+
+  func cancellationReplyDrained(_ sequence: Int) {
+    guard !finished else { return }
+    drainedReplies = max(drainedReplies, sequence)
+    completeIfReady()
+  }
+
+  func originalReplyReceived() {
+    guard !finished else { return }
+    guard enqueuedReplies > 0 else {
+      fail(FBSimulatorHIDHingeWire.failure("Context motion service replied before the sample cancellation reply"))
+      return
+    }
+    receivedOriginalReply = true
+    completeIfReady()
+  }
+
+  func fail(_ error: Error) {
+    guard !finished else { return }
+    finished = true
+    finish(.failure(error))
+  }
+
+  private func completeIfReady() {
+    guard !finished, receivedOriginalReply, enqueuedReplies > 0,
+          drainedReplies == enqueuedReplies, let sample else { return }
+    guard ProcessInfo.processInfo.systemUptime <= deadline else {
+      fail(FBSimulatorHIDHingeWire.failure("Context hinge sample timed out"))
+      return
+    }
+    finished = true
+    finish(.success(sample))
+  }
+}
diff --git a/FBSimulatorControl/HID/FBSimulatorHingeReadinessModels.swift b/FBSimulatorControl/HID/FBSimulatorHingeReadinessModels.swift
new file mode 100644
index 0000000000000000000000000000000000000000..fb9534d634601adc8a142f2afde64e923e9ff76e
