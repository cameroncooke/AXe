index 0000000..6196242
--- /dev/null
+++ b/FBSimulatorControl/HID/FBSimulatorNativeContextReader.swift
@@ -0,0 +1,338 @@
+@preconcurrency import CoreSimulator
+@preconcurrency import FBControlCore
+import Foundation
+import Darwin
+
+public enum FBSimulatorHingeCapability: String, Codable, Sendable {
+  case supported, unsupported, unverified
+}
+
+public struct FBSimulatorContextCapability: Codable, Sendable {
+  public let hinge: FBSimulatorHingeCapability
+  public let activePanelSchemaPolicy: ActivePanelSchemaPolicy
+  public let deviceTypeIdentifier: String
+  public let modelIdentifier: String
+  public let profileVersion: String
+  public let integratedDigitizerIDs: [UInt32]
+  public let reason: String
+}
+
+public struct FBSimulatorContextObservation: Codable, Sendable {
+  public let simulatorUDID: String
+  public let bootIdentity: String
+  public let screenID: UInt32
+  public let screenUniqueID: String
+  public let axDisplayID: UInt32
+  public let nativePixelWidth: Double
+  public let nativePixelHeight: Double
+  public let scale: Double
+  public let rotation: Int
+  public let poseRevision: String
+
+  public func sessionObservation() throws -> FBSimulatorHIDSessionObservation {
+    guard let rotation = FBSimulatorHIDDisplayRotation(rawValue: rotation) else {
+      throw FBSimulatorContextError.unavailable("Unsupported guest rotation")
+    }
+    let context = try FBSimulatorHIDDisplayContext(hidTarget: UInt64(screenID),
+      nativePixelSize: CGSize(width: nativePixelWidth, height: nativePixelHeight), scale: scale, rotation: rotation)
+    return try FBSimulatorHIDSessionObservation(simulatorUDID: simulatorUDID,
+      bootIdentity: bootIdentity, screenID: screenID, screenUniqueID: screenUniqueID,
+      axDisplayID: axDisplayID, displayContext: context, poseRevision: poseRevision)
+  }
+}
+
+public struct FBSimulatorContextReadback: Codable, Sendable {
+  public let observation: FBSimulatorContextObservation
+  public let capability: FBSimulatorContextCapability
+  public let hingeBefore: FBSimulatorHingeObservation?
+  public let hingeAfter: FBSimulatorHingeObservation?
+  public let hostRawUIOrientation: UInt32
+  public let hostRawPowerState: Int32
+  public let hostRawBacklightState: Int32?
+  public let joinedPanels: [ActivePanelIdentity]
+  public let activeSnapshot: ActivePanelSnapshot
+  public let activeChildReceipt: ActivePanelChildReceipt
+  public let guestProcessIdentifier: Int32
+  public let guestExitConfirmed: Bool
+  public let startedUptime: Double
+  public let finishedUptime: Double
+}
+
+/// Full bounded read with selected active-panel admission. It is not an atomic input
+/// transaction or a transition generation. Use the live feed between full observations.
+public actor FBSimulatorNativeContextReader: FBSimulatorHIDFreshnessProvider, FBSimulatorHIDCleanupIdentityProvider {
+  private let simulator: FBSimulator
+  private let helperURL: URL
+  private let screenID: UInt32
+  private let screenUniqueID: UUID
+
+  public init(simulator: FBSimulator, helperURL: URL, screenID: UInt32, screenUniqueID: UUID) {
+    self.simulator = simulator
+    self.helperURL = helperURL
+    self.screenID = screenID
+    self.screenUniqueID = screenUniqueID
+  }
+
+  public func observation() async throws -> FBSimulatorHIDSessionObservation {
+    try await read().observation.sessionObservation()
+  }
+
+  /// A bounded host identity read for release on the existing connection. It does not establish
+  /// active status, pose, guest rotation, or permission to dispatch any new input.
+  public func cleanupIdentity() async throws -> FBSimulatorHIDCleanupIdentity {
+    try Task.checkCancellation()
+    let started = ProcessInfo.processInfo.systemUptime
+    guard simulator.state == .booted else { throw FBSimulatorContextError.unavailable("Simulator is not booted during cleanup") }
+    let capability = try Self.capability(for: simulator)
+    guard capability.hinge != .unverified, capability.integratedDigitizerIDs.contains(screenID) else {
+      throw FBSimulatorContextError.unavailable("Cleanup target is not in the verified device profile")
+    }
+    let bootBefore = try Self.bootIdentity(simulator.udid)
+    let catalog = try Self.hostCatalog(await FBSimulatorDisplayDiscovery.displays(for: simulator),
+      profileIDs: capability.integratedDigitizerIDs)
+    guard let selected = catalog.first(where: { $0.screenID == screenID }),
+          selected.uniqueID.flatMap(UUID.init(uuidString:)) == screenUniqueID else {
+      throw FBSimulatorContextError.unavailable("Original cleanup target ID/UUID is absent")
+    }
+    let bootAfter = try Self.bootIdentity(simulator.udid)
+    guard bootBefore == bootAfter else { throw FBSimulatorContextError.changedDuringRead }
+    try Task.checkCancellation()
+    return FBSimulatorHIDCleanupIdentity(simulatorUDID: simulator.udid, bootIdentity: bootBefore,
+      screenID: screenID, screenUUID: screenUniqueID.uuidString,
+      nativePixelWidth: selected.nativePixelSize.width, nativePixelHeight: selected.nativePixelSize.height,
+      scale: selected.scale, startedUptime: started, finishedUptime: ProcessInfo.processInfo.systemUptime)
+  }
+
+  public func read() async throws -> FBSimulatorContextReadback {
+    try Task.checkCancellation()
+    let started = ProcessInfo.processInfo.systemUptime
+    guard simulator.state == .booted else { throw FBSimulatorContextError.unavailable("Simulator is not booted") }
+    let capability = try Self.capability(for: simulator)
+    guard capability.hinge != .unverified else {
+      throw FBSimulatorContextError.unavailable(capability.reason)
+    }
+    guard capability.integratedDigitizerIDs.contains(screenID) else {
+      throw FBSimulatorContextError.unavailable("Selected screen is not an integrated digitizer in this device profile")
+    }
+    let bootBefore = try Self.bootIdentity(simulator.udid)
+    let beforeCatalog = try Self.hostCatalog(
+      await FBSimulatorDisplayDiscovery.displays(for: simulator), profileIDs: capability.integratedDigitizerIDs)
+    guard let before = beforeCatalog.first(where: { $0.screenID == screenID }),
+          before.uniqueID.flatMap(UUID.init(uuidString:)) == screenUniqueID else {
+      throw FBSimulatorContextError.unavailable("Requested selected pair is absent from the host catalog")
+    }
+    let hingeBefore = capability.hinge == .supported ? try await FBSimulatorHingeReader.read(for: simulator) : nil
+    guard let simulatorID = UUID(uuidString: simulator.udid), !FBXcodeConfiguration.developerDirectory.isEmpty else {
+      throw FBSimulatorContextError.unavailable("Active-panel simulator identity or developer directory is unavailable")
+    }
+    let developerDirectory = URL(fileURLWithPath: FBXcodeConfiguration.developerDirectory, isDirectory: true)
+    // Both probes stay within the same before/after context bounds. Only transport overlaps;
+    // the active snapshot is validated after the independent host/guest join and rotation.
+    async let activeReceipt = ActivePanelReader.captureSnapshot(simulatorUDID: simulatorID,
+      developerDirectory: developerDirectory)
+    let requestID = UUID()
+    let guestResult = try await FBSimulatorContextGuestRead.read(simulator: simulator, helperURL: helperURL, requestID: requestID)
+    let guest = try JSONDecoder().decode(GuestEnvelope.self, from: guestResult.data)
+    guard guest.schemaVersion == 1, guest.requestID == requestID,
+          guest.processIdentifier == guestResult.processIdentifier else {
+      throw FBSimulatorContextError.unavailable("Guest identity does not match this read")
+    }
+    let joinedPanels = try Self.joinedCatalog(host: beforeCatalog, guest: guest.displays)
+    let matches = guest.displays.filter { $0.displayId == screenID && UUID(uuidString: $0.uniqueId) == screenUniqueID }
+    guard matches.count == 1,
+          guest.displays.filter({ $0.displayId == screenID }).count == 1,
+          let selected = matches.first,
+          selected.bounds.x == 0, selected.bounds.y == 0,
+          selected.bounds.width == before.nativePixelSize.width,
+          selected.bounds.height == before.nativePixelSize.height,
+          let rotation = Self.rotation(selected.currentOrientation) else {
+      throw FBSimulatorContextError.unavailable("Host and guest screen identity, geometry or rotation do not match")
+    }
+    guard let activeRotation = ActivePanelRotation(rawValue: selected.currentOrientation) else {
+      throw FBSimulatorContextError.unavailable("Active-panel guest rotation is unavailable")
+    }
+    let receipt = try await activeReceipt
+    let active = try ActivePanelReader.decodeCapturedSnapshot(receipt, simulatorUDID: simulatorID,
+      expectedPanels: joinedPanels,
+      selected: ActivePanelExpectation(identity: ActivePanelIdentity(displayID: screenID, uniqueID: screenUniqueID),
+        nativePixelWidth: before.nativePixelSize.width, nativePixelHeight: before.nativePixelSize.height,
+        scale: before.scale, rotation: activeRotation),
+      schemaPolicy: capability.activePanelSchemaPolicy)
+    let hingeAfter = capability.hinge == .supported ? try await FBSimulatorHingeReader.read(for: simulator) : nil
+    let afterCatalog = try Self.hostCatalog(
+      await FBSimulatorDisplayDiscovery.displays(for: simulator), profileIDs: capability.integratedDigitizerIDs)
+    guard let after = afterCatalog.first(where: { $0.screenID == screenID }) else {
+      throw FBSimulatorContextError.unavailable("Selected panel disappeared during read")
+    }
+    guard try Self.bootIdentity(simulator.udid) == bootBefore,
+          Self.sameCatalog(beforeCatalog, afterCatalog), Self.sameHinge(hingeBefore, hingeAfter) else {
+      throw FBSimulatorContextError.changedDuringRead
+    }
+    try Task.checkCancellation()
+    let pose: String
+    if let hingeAfter {
+      // Mechanical angle is measured. It is not a posture enum or active-panel threshold.
+      pose = "mechanicalDegrees=\(hingeAfter.mechanicalDegrees);range=\(hingeAfter.minimumDegrees)...\(hingeAfter.maximumDegrees)"
+    } else {
+      pose = "rigid-device-type:\(capability.deviceTypeIdentifier)"
+    }
+    return FBSimulatorContextReadback(observation: FBSimulatorContextObservation(
+      simulatorUDID: simulator.udid, bootIdentity: bootBefore, screenID: screenID,
+      screenUniqueID: screenUniqueID.uuidString, axDisplayID: screenID,
+      nativePixelWidth: before.nativePixelSize.width, nativePixelHeight: before.nativePixelSize.height,
+      scale: before.scale, rotation: rotation, poseRevision: pose), capability: capability,
+      hingeBefore: hingeBefore, hingeAfter: hingeAfter, hostRawUIOrientation: after.rawUIOrientation,
+      hostRawPowerState: after.rawPowerState, hostRawBacklightState: after.rawBacklightState,
+      joinedPanels: joinedPanels, activeSnapshot: active.snapshot, activeChildReceipt: active.receipt,
+      guestProcessIdentifier: guestResult.processIdentifier, guestExitConfirmed: true,
+      startedUptime: started, finishedUptime: ProcessInfo.processInfo.systemUptime)
+  }
+
+  /// Narrow, explicit device catalog. Unknown device profiles remain unverified.
+  /// A screen count alone never identifies a hinged device.
+  public static func capability(for simulator: FBSimulator) throws -> FBSimulatorContextCapability {
+    guard let type = simulator.device.deviceType, let bundle = type.bundle,
+          let identifier = type.identifier, let model = type.modelIdentifier,
+          let version = bundle.object(forInfoDictionaryKey: "CFBundleVersion") as? String,
+          let url = bundle.url(forResource: "capabilities", withExtension: "plist") else {
+      throw FBSimulatorContextError.unavailable("Device type metadata is unavailable")
+    }
+    let profile = try PropertyListDecoder().decode(CapabilityFile.self, from: Data(contentsOf: url))
+    let ids = profile.capabilities.displays.filter { $0.displayType == "integrated" && $0.hasDigitizer }.map(\.screenID).sorted()
+    return classifyCapability(identifier: identifier, model: model, version: version, integratedDigitizerIDs: ids)
+  }
+
+  static func classifyCapability(identifier: String, model: String, version: String,
+                                 integratedDigitizerIDs: [UInt32]) -> FBSimulatorContextCapability {
+    let ids = integratedDigitizerIDs.sorted()
+    let uniqueIDs = Set(ids).count == ids.count
+    let hinge: FBSimulatorHingeCapability
+    let activePanelSchemaPolicy: ActivePanelSchemaPolicy
+    let reason: String
+    if version == "405", identifier == "com.apple.CoreSimulator.SimDeviceType.iPhone-Duo",
+       model == "iPhone19,4", uniqueIDs, ids.count == 2 {
+      hinge = .supported
+      activePanelSchemaPolicy = .explicitActiveFlag
+      reason = "Verified Duo profile 405; native hinge samples are required on every full read"
+    } else if version == "405", identifier == "com.apple.CoreSimulator.SimDeviceType.iPhone-18-Pro",
+              model == "iPhone19,2", uniqueIDs, ids.count == 1 {
+      hinge = .unsupported
+      activePanelSchemaPolicy = .verifiedIPhone18ProProfile405
+      reason = "Verified rigid iPhone 18 Pro profile 405; no hinge request is made"
+    } else if version == "407", identifier == "com.apple.CoreSimulator.SimDeviceType.iPhone-18-Pro",
+              model == "iPhone19,2", ids == [1] {
+      hinge = .unsupported
+      activePanelSchemaPolicy = .explicitActiveFlag
+      reason = "Verified rigid iPhone 18 Pro profile 407 with integrated digitizer 1; no hinge request is made"
+    } else if version == "405", identifier == "com.apple.CoreSimulator.SimDeviceType.iPad-mini-A17-Pro",
+              model == "iPad16,2", ids == [1] {
+      hinge = .unsupported
+      activePanelSchemaPolicy = .verifiedIPadMiniA17ProProfile405
+      reason = "Verified rigid iPad mini A17 Pro profile 405 with integrated digitizer 1; no hinge request is made"
+    } else {
+      hinge = .unverified
+      activePanelSchemaPolicy = .explicitActiveFlag
+      reason = "Device type, model or profile version has no verified hinge contract"
+    }
+    return FBSimulatorContextCapability(hinge: hinge, activePanelSchemaPolicy: activePanelSchemaPolicy, deviceTypeIdentifier: identifier,
+      modelIdentifier: model, profileVersion: version, integratedDigitizerIDs: ids, reason: reason)
+  }
+
+  // The verified device profile defines the integrated set. Virtual CAD displays are not
+  // classified by names or guessed raw enums. Devicectl independently validates its full set.
+  static func hostCatalog(_ values: [FBSimulatorDisplayInfo], profileIDs: [UInt32]) throws -> [FBSimulatorDisplayInfo] {
+    guard !profileIDs.isEmpty, Set(profileIDs).count == profileIDs.count,
+          Set(values.map(\.screenID)).count == values.count else {
+      throw FBSimulatorContextError.unavailable("Invalid profile IDs or duplicate host screen IDs")
+    }
+    let catalog = values.filter { profileIDs.contains($0.screenID) }.sorted { $0.screenID < $1.screenID }
+    let pairs = catalog.compactMap { value -> ActivePanelIdentity? in
+      guard let uuid = value.uniqueID.flatMap(UUID.init(uuidString:)) else { return nil }
+      return ActivePanelIdentity(displayID: value.screenID, uniqueID: uuid)
+    }
+    guard catalog.count == profileIDs.count, pairs.count == catalog.count,
+          Set(pairs.map(\.uniqueID)).count == pairs.count,
+          catalog.allSatisfy({ value in
+            [value.nativePixelSize.width, value.nativePixelSize.height].allSatisfy { $0.isFinite && $0 > 0 && $0 <= 65536 }
+              && value.scale.isFinite && value.scale > 0 && value.scale <= 16
+          }) else {
+      throw FBSimulatorContextError.unavailable("Host integrated catalog is incomplete, duplicated or invalid")
+    }
+    return catalog
+  }
+
+  static func joinedCatalog(host: [FBSimulatorDisplayInfo], guest: [GuestEnvelope.Display]) throws -> [ActivePanelIdentity] {
+    guard guest.count <= 32, Set(guest.map(\.displayId)).count == guest.count else {
+      throw FBSimulatorContextError.unavailable("Guest catalog is oversized or has duplicate screen IDs")
+    }
+    var pairs: [ActivePanelIdentity] = []
+    for panel in host {
+      guard let uuid = panel.uniqueID.flatMap(UUID.init(uuidString:)),
+            let row = guest.first(where: { $0.displayId == panel.screenID }),
+            UUID(uuidString: row.uniqueId) == uuid,
+            row.bounds.x == 0, row.bounds.y == 0,
+            row.bounds.width == panel.nativePixelSize.width,
+            row.bounds.height == panel.nativePixelSize.height,
+            Self.rotation(row.currentOrientation) != nil else {
+        throw FBSimulatorContextError.unavailable("Complete host/guest integrated catalog does not match")
+      }
+      pairs.append(ActivePanelIdentity(displayID: panel.screenID, uniqueID: uuid))
+    }
+    guard !pairs.isEmpty, Set(pairs).count == pairs.count,
+          Set(pairs.map(\.uniqueID)).count == pairs.count else {
+      throw FBSimulatorContextError.unavailable("Joined panel identity is empty or duplicated")
+    }
+    return pairs
+  }
+
+  static func sameCatalog(_ before: [FBSimulatorDisplayInfo], _ after: [FBSimulatorDisplayInfo]) -> Bool {
+    before.count == after.count && zip(before, after).allSatisfy { sameDisplay($0, $1) }
+  }
+
+  static func bootIdentity(_ udid: String) throws -> String {
+    let processes = FBProcessFetcher().processes(withProcessName: "launchd_sim").filter {
+      $0.arguments.contains { $0.localizedCaseInsensitiveContains(udid) }
+    }
+    guard processes.count == 1, let process = processes.first else {
+      throw FBSimulatorContextError.unavailable("Expected exactly one launchd_sim for this device")
+    }
+    var info = proc_bsdinfo()
+    let size = Int32(MemoryLayout<proc_bsdinfo>.size)
+    guard proc_pidinfo(process.processIdentifier, PROC_PIDTBSDINFO, 0, &info, size) == size else {
+      throw FBSimulatorContextError.unavailable("Simulator boot process identity is unavailable")
+    }
+    return "\(process.processIdentifier):\(info.pbi_start_tvsec):\(info.pbi_start_tvusec)"
+  }
+
+  private static func rotation(_ text: String) -> Int? {
+    switch text { case "rot0": return 0; case "rot90": return 90; case "rot180": return 180; case "rot270": return 270; default: return nil }
+  }
+
+  private static func sameDisplay(_ a: FBSimulatorDisplayInfo, _ b: FBSimulatorDisplayInfo) -> Bool {
+    a.screenID == b.screenID && a.uniqueID.flatMap(UUID.init(uuidString:)) == b.uniqueID.flatMap(UUID.init(uuidString:)) && a.nativePixelSize == b.nativePixelSize &&
+      a.scale == b.scale && a.rawUIOrientation == b.rawUIOrientation && a.rawPowerState == b.rawPowerState &&
+      a.rawBacklightState == b.rawBacklightState && a.rawScreenType == b.rawScreenType
+  }
+
+  private static func sameHinge(_ a: FBSimulatorHingeObservation?, _ b: FBSimulatorHingeObservation?) -> Bool {
+    switch (a, b) {
+    case (nil, nil): return true
+    case let (a?, b?): return a.mechanicalDegrees == b.mechanicalDegrees && a.minimumDegrees == b.minimumDegrees && a.maximumDegrees == b.maximumDegrees
+    default: return false
+    }
+  }
+
+  private struct CapabilityFile: Decodable {
+    let capabilities: Capabilities
+    struct Capabilities: Decodable { let displays: [Display] }
+    struct Display: Decodable { let displayType: String; let hasDigitizer: Bool; let screenID: UInt32 }
+  }
+  struct GuestEnvelope: Decodable {
+    let schemaVersion: Int
+    let requestID: UUID
+    let processIdentifier: Int32
+    let displays: [Display]
+    struct Display: Decodable { let displayId: UInt32; let uniqueId: String; let currentOrientation: String; let bounds: Bounds }
+    struct Bounds: Decodable { let x: Double; let y: Double; let width: Double; let height: Double }
+  }
+}
diff --git a/FBSimulatorControl/HID/OwnedActivePanelChild.swift b/FBSimulatorControl/HID/OwnedActivePanelChild.swift
new file mode 100644
index 0000000000000000000000000000000000000000..10917b03c1b6e764be74280235b381b481bc75e2
--- /dev/null
+++ b/FBSimulatorControl/HID/OwnedActivePanelChild.swift
@@ -0,0 +1,331 @@
+import Foundation
+import Darwin
+
+/// Internal process boundary also used by local child-lifecycle checks.
+/// The public reader always supplies the exact devicectl command.
+struct ActivePanelChildCommand: Sendable {
+    let executable: URL
+    let arguments: [String]
+    let environment: [String: String]
+    let directory: URL
+    let responseURL: URL
+    let timeout: TimeInterval
+    let maximumBytes: Int
+}
+
+/// Mutable lifecycle state is confined to queue. posix_spawn is on a separate worker so
+/// a stalled launch cannot prevent the owner from reporting unconfirmed cleanup.
+/// A late launch retains this owner and is stopped; it is never reported as not launched.
+final class OwnedActivePanelChild: @unchecked Sendable {
+    private let queue = DispatchQueue(label: "com.camsoft.axe.active-panel-child", qos: .userInitiated)
+    private let command: ActivePanelChildCommand
+    private let errorPipe = Pipe()
+    private var continuation: CheckedContinuation<ActivePanelChildReceipt, Error>?
+    private var timer: DispatchSourceTimer?
+    private var errorSource: DispatchSourceRead?
+    private var started = 0.0
+    private var launchReturned = false
+    private var launchAttempted = false
+    private var processIdentifier: pid_t?
+    private var launched = false
+    private var exited = false
+    private var exitStatus: Int32?
+    private var exitReason: String?
+    private var stopReason: ActivePanelChildFailure?
+    private var detail: String?
+    private var stopAt: Double?
+    private var sentTerminate = false
+    private var sentKill = false
+    private var returned = false
+    private var disposed = false
+    private var directoryCreated = false
+    private var stderr = Data()
+
+    init(command: ActivePanelChildCommand) { self.command = command }
+
+    func run() async throws -> ActivePanelChildReceipt {
+        try await withTaskCancellationHandler {
+            try await withCheckedThrowingContinuation { continuation in
+                queue.async {
+                    self.continuation = continuation
+                    self.start()
+                }
+            }
+        } onCancel: {
+            self.queue.async { self.stop(.cancelled) }
+        }
+    }
+
+    private func start() {
+        started = ProcessInfo.processInfo.systemUptime
+        guard stopReason == nil else { finishBeforeLaunch(); return }
+        do {
+            guard mkdir(command.directory.path, 0o700) == 0 else {
+                throw POSIXError(POSIXErrorCode(rawValue: errno) ?? .EIO)
+            }
+            directoryCreated = true
+            let descriptor = errorPipe.fileHandleForReading.fileDescriptor
+            guard fcntl(descriptor, F_SETFL, fcntl(descriptor, F_GETFL) | O_NONBLOCK) != -1 else {
+                throw POSIXError(POSIXErrorCode(rawValue: errno) ?? .EIO)
+            }
+            let source = DispatchSource.makeReadSource(fileDescriptor: descriptor, queue: queue)
+            source.setEventHandler { [self] in readStderr() }
+            source.setCancelHandler { [errorPipe] in try? errorPipe.fileHandleForReading.close() }
+            errorSource = source
+            source.resume()
+            let timer = DispatchSource.makeTimerSource(queue: queue)
+            timer.schedule(deadline: .now(), repeating: .milliseconds(10))
+            timer.setEventHandler { [self] in tick() }
+            self.timer = timer
+            timer.resume()
+            launchAttempted = true
+            let readFD = errorPipe.fileHandleForReading.fileDescriptor
+            let writeFD = errorPipe.fileHandleForWriting.fileDescriptor
+            DispatchQueue.global(qos: .userInitiated).async { [self] in
+                let result = Self.spawn(command: command, readFD: readFD, writeFD: writeFD)
+                queue.async { self.didLaunch(result) }
+            }
+        } catch {
+            stopReason = .ioFailure
+            detail = String(describing: error)
+            finishBeforeLaunch()
+        }
+    }
+
+    private func didLaunch(_ result: SpawnResult) {
+        launchReturned = true
+        try? errorPipe.fileHandleForWriting.close()
+        if result.code != 0 {
+            if stopReason == nil { stopReason = .launchFailed }
+            detail = "posix_spawn error \(result.code)"
+            finishBeforeLaunch()
+            return
+        }
+        launched = true
+        processIdentifier = result.pid
+        tick()
+    }
+
+    private func readStderr() {
+        guard errorSource != nil else { return }
+        var bytes = [UInt8](repeating: 0, count: 8192)
+        // Bound work per callback; the source remains readable if more data is pending.
+        for _ in 0..<32 {
+            let count = Darwin.read(errorPipe.fileHandleForReading.fileDescriptor, &bytes, bytes.count)
+            if count > 0 {
+                let room = max(0, command.maximumBytes - stderr.count)
+                stderr.append(contentsOf: bytes.prefix(min(count, room)))
+                if count > room { stop(.outputLimit); return }
+            } else if count == 0 {
+                errorSource?.cancel()
+                errorSource = nil
+                return
+            } else if errno == EINTR {
+                continue
+            } else if errno == EAGAIN || errno == EWOULDBLOCK {
+                return
+            } else {
+                detail = "stderr read errno \(errno)"
+                stop(.ioFailure)
+                return
+            }
+        }
+    }
+
+    private func stop(_ reason: ActivePanelChildFailure) {
+        if stopReason == nil {
+            stopReason = reason
+            stopAt = ProcessInfo.processInfo.systemUptime
+        }
+        // Cancellation can arrive before the continuation/start block.
+        if continuation != nil { queue.async { self.tick() } }
+    }
+
+    private func tick() {
+        guard !disposed, continuation != nil || returned else { return }
+        let now = ProcessInfo.processInfo.systemUptime
+        if let pid = processIdentifier, !exited {
+            var status: Int32 = 0
+            let result = waitpid(pid, &status, WNOHANG)
+            if result == pid {
+                // Darwin sys/wait.h: WIFEXITED = (status & 127) == 0;
+                // WEXITSTATUS = (status >> 8) & 255; WTERMSIG = status & 127.
+                exited = true
+                exitReason = (status & 127) == 0 ? "exit" : "signal"
+                exitStatus = (status & 127) == 0 ? ((status >> 8) & 255) : (status & 127)
+            } else if result == -1, errno != EINTR {
+                detail = "waitpid error \(errno); direct child exit not confirmed"
+                stopReason = stopReason ?? .cleanupUnconfirmed
+                let result = receipt(json: Data())
+                // Ownership is no longer proved. Never signal a PID that may have been reaped elsewhere.
+                dispose(removeFiles: false)
+                finish(.failure(ActivePanelReadError(childFailure: .cleanupUnconfirmed, receipt: result)))
+                return
+            }
+        }
+        if !exited, stopReason == nil, now - started >= command.timeout {
+            stopReason = .deadline
+            stopAt = now
+        }
+        if stopReason == nil {
+            var info = stat()
+            if lstat(command.responseURL.path, &info) == 0 {
+                if (info.st_mode & S_IFMT) != S_IFREG {
+                    stopReason = .ioFailure
+                    detail = "JSON output is not a regular file"
+                    stopAt = now
+                } else if info.st_size > command.maximumBytes {
+                    stopReason = .outputLimit
+                    stopAt = now
+                }
+            } else if errno != ENOENT {
+                stopReason = .ioFailure
+                detail = "JSON output lstat error \(errno)"
+                stopAt = now
+            }
+        }
+        if launched, exited {
+            readStderr()
+            finishExited()
+            return
+        }
+        if let stopAt {
+            if let pid = processIdentifier, !sentTerminate {
+                _ = Darwin.kill(pid, SIGTERM)
+                sentTerminate = true
+            }
+            if let pid = processIdentifier, !sentKill, now - stopAt >= 0.2 {
+                // waitpid is owned by this queue. An unreaped child PID cannot be reused.
+                _ = Darwin.kill(pid, SIGKILL)
+                sentKill = true
+            }
+            if !returned, now - stopAt >= 1.2 {
+                finish(.failure(ActivePanelReadError(childFailure: .cleanupUnconfirmed, receipt: receipt(json: Data()))))
+                // Keep the launch and exit owner alive for a late result. No success is claimed.
+            }
+        }
+    }
+
+    private func finishBeforeLaunch() {
+        try? errorPipe.fileHandleForWriting.close()
+        let result = receipt(json: Data())
+        dispose()
+        finish(.failure(ActivePanelReadError(childFailure: stopReason ?? .launchFailed, receipt: result)))
+    }
+
+    private func finishExited() {
+        var json = Data()
+        do {
+            let descriptor = Darwin.open(command.responseURL.path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC)
+            guard descriptor >= 0 else { throw POSIXError(POSIXErrorCode(rawValue: errno) ?? .EIO) }
+            let file = FileHandle(fileDescriptor: descriptor, closeOnDealloc: true)
+            defer { try? file.close() }
+            var info = stat()
+            guard fstat(descriptor, &info) == 0, (info.st_mode & S_IFMT) == S_IFREG else {
+                throw POSIXError(.EINVAL)
+            }
+            json = try file.read(upToCount: command.maximumBytes + 1) ?? Data()
+            if json.count > command.maximumBytes {
+                json = Data(json.prefix(command.maximumBytes))
+                if stopReason == nil { stopReason = .outputLimit }
+            }
+        } catch {
+            if stopReason == nil, exitStatus == 0 {
+                stopReason = .missingJSON
+                detail = String(describing: error)
+            }
+        }
+        if stopReason == nil, exitStatus != 0 || exitReason != "exit" { stopReason = .nonzeroExit }
+        let result = receipt(json: json)
+        dispose()
+        if let stopReason {
+            finish(.failure(ActivePanelReadError(childFailure: stopReason, receipt: result)))
+        } else {
+            finish(.success(result))
+        }
+    }
+
+    private func receipt(json: Data) -> ActivePanelChildReceipt {
+        ActivePanelChildReceipt(executable: command.executable.path, arguments: command.arguments,
+            startedUptime: started, finishedUptime: ProcessInfo.processInfo.systemUptime,
+            processIdentifier: processIdentifier, launchAttempted: launchAttempted,
+            launchReturned: launchReturned, exitConfirmed: launched && exited,
+            terminationStatus: exitStatus, terminationReason: exitReason,
+            stopReason: stopReason, detail: detail, sentTerminate: sentTerminate, sentKill: sentKill,
+            json: json, stderr: stderr)
+    }
+
+    private func finish(_ result: Result<ActivePanelChildReceipt, Error>) {
+        guard !returned else { return }
+        returned = true
+        let saved = continuation
+        continuation = nil
+        saved?.resume(with: result)
+    }
+
+    private func dispose(removeFiles: Bool = true) {
+        guard !disposed else { return }
+        disposed = true
+        timer?.cancel()
+        timer = nil
+        errorSource?.cancel()
+        errorSource = nil
+        if errorSource == nil { try? errorPipe.fileHandleForReading.close() }
+        try? errorPipe.fileHandleForWriting.close()
+        // Only this invocation's private directory, after confirmed exit or failed launch.
+        if removeFiles, directoryCreated { try? FileManager.default.removeItem(at: command.directory) }
+    }
+
+    private struct SpawnResult: Sendable { let pid: pid_t; let code: Int32 }
+
+    static func configureSignalDefaults(_ attributes: inout posix_spawnattr_t?) -> Int32 {
+        var defaults = sigset_t()
+        guard sigemptyset(&defaults) == 0,
+              sigaddset(&defaults, SIGINT) == 0,
+              sigaddset(&defaults, SIGTERM) == 0 else { return errno }
+        let result = posix_spawnattr_setsigdefault(&attributes, &defaults)
+        guard result == 0 else { return result }
+        return posix_spawnattr_setflags(&attributes, Int16(POSIX_SPAWN_CLOEXEC_DEFAULT | POSIX_SPAWN_SETSIGDEF))
+    }
+
+    private static func spawn(command: ActivePanelChildCommand, readFD: Int32, writeFD: Int32) -> SpawnResult {
+        var actions: posix_spawn_file_actions_t?
+        var attributes: posix_spawnattr_t?
+        let actionResult = posix_spawn_file_actions_init(&actions)
+        guard actionResult == 0 else { return SpawnResult(pid: 0, code: actionResult) }
+        defer { posix_spawn_file_actions_destroy(&actions) }
+        let attributeResult = posix_spawnattr_init(&attributes)
+        guard attributeResult == 0 else { return SpawnResult(pid: 0, code: attributeResult) }
+        defer { posix_spawnattr_destroy(&attributes) }
+        // SignalObserver ignores these signals in the parent. Do not pass that ignored
+        // disposition into an exec child that this owner stops with SIGTERM.
+        let signalResult = configureSignalDefaults(&attributes)
+        guard signalResult == 0 else { return SpawnResult(pid: 0, code: signalResult) }
+        // Close unrelated inherited descriptors; retain only explicit child file actions.
+        let operations = [
+            posix_spawn_file_actions_addopen(&actions, STDIN_FILENO, "/dev/null", O_RDONLY, 0),
+            posix_spawn_file_actions_addopen(&actions, STDOUT_FILENO, "/dev/null", O_WRONLY, 0),
+            posix_spawn_file_actions_adddup2(&actions, writeFD, STDERR_FILENO),
+            posix_spawn_file_actions_addclose(&actions, readFD),
+            posix_spawn_file_actions_addclose(&actions, writeFD)
+        ]
+        if let error = operations.first(where: { $0 != 0 }) { return SpawnResult(pid: 0, code: error) }
+        let argumentStrings = [command.executable.path] + command.arguments
+        let environmentStrings = command.environment.sorted(by: { $0.key < $1.key }).map { $0.key + "=" + $0.value }
+        var argv = argumentStrings.map { strdup($0) }
+        var envp = environmentStrings.map { strdup($0) }
+        defer { argv.forEach { free($0) }; envp.forEach { free($0) } }
+        guard argv.allSatisfy({ $0 != nil }), envp.allSatisfy({ $0 != nil }) else {
+            return SpawnResult(pid: 0, code: ENOMEM)
+        }
+        argv.append(nil)
+        envp.append(nil)
+        var pid: pid_t = 0
+        let result = argv.withUnsafeMutableBufferPointer { args in
+            envp.withUnsafeMutableBufferPointer { environment in
+                posix_spawn(&pid, command.executable.path, &actions, &attributes, args.baseAddress!, environment.baseAddress!)
+            }
+        }
+        return SpawnResult(pid: pid, code: result)
+    }
+}
